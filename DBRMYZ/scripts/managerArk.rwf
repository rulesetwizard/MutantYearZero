<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>managerArk</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Ark projects: started from the Projects tab of the Ark if its DEV levels are high enough, worked on with a
-- skill roll of a character (each success is a work point), and adding their DEV bonus to the Ark when completed.
-- Also the values derived from the DEV levels, the body count of the session and the Dawn Vault.
-- In Elysium the Ark is the enclave: its levels (Production, Culture, Science, Security) start at 80 and go down

-- The keys find a level in texts like "Culture 5" (also with the names of Elysium)
local aDevLevels = {
	{ field = "foodsupply", keys = { "food", "abastecimiento", "comida", "product", "producci" } },
	{ field = "culture", keys = { "cultur" } },
	{ field = "technology", keys = { "technolog", "tecnolog", "scien", "cienc" } },
	{ field = "warfare", keys = { "warfare", "guerra", "secur", "seguridad" } },
};

-- Short text and tooltip of each step of the DEV levels (0-9, 10-19, 20-29, 30+)
local tDerived = {
	foodsupply = {
		{ "1 grub per bullet", "A desperate struggle for food. A bullet buys 1 grub." },
		{ "2 grub per bullet", "Enough grub for daily needs while harvests and hunts go well. A bullet buys 2 grub. Body count -1." },
		{ "3 grub per bullet", "Almost everyone eats every day, with some reserves. A bullet buys 3 grub. Body count -2." },
		{ "4 grub per bullet", "Nobody goes hungry; cooking and brewing are refined. A bullet buys 4 grub. Body count -3." },
	},
	culture = {
		{ "Campfire tales", "Apart from the Chroniclers, only tales around the barrel fires." },
		{ "Basic literacy", "Most can read and write a little; maybe a place of worship, plays or exhibitions." },
		{ "Schools", "Writing is advanced and widespread; maybe an organized school." },
		{ "Self-government", "The ideals of the Ancients are known; maybe some form of voting or participatory rule." },
	},
	technology = {
		{ "Gearheads only", "Only the Gearheads understand technology; most artifacts are puzzles." },
		{ "Mills and stills", "Basic technical knowledge: simple constructions like a mill or a still." },
		{ "Workshops", "Mechanical construction: workshops, new roads, machines like a printing press." },
		{ "Steam engines", "On the edge of a revolution: steam engines, heliographs, electric lights, breech-loading guns." },
	},
	warfare = {
		{ "", "Only simple barricades: the Ark is defenseless against outside enemies." },
		{ "", "Scrap palisades and watchtowers, maybe some patrols." },
		{ "", "Probably an organized militia, maybe an armory." },
		{ "", "A standing army; the Ark is defended by home-made cannons and flamethrowers." },
	},
};

-- The same for the enclave of Elysium, from the best step to the worst (60+, 40-59, 20-39, 0-19)
local tDerivedEnclave = {
	foodsupply = {
		{ "Normal prices", "Production covers what most residents need. Prices are not changed." },
		{ "Prices x2", "Some goods are hard to find, power cuts are more frequent and the black market grows. Prices are doubled." },
		{ "Prices x3", "Empty shelves, hoarding and looting in the Deep, longer blackouts. Prices are tripled." },
		{ "Prices x4", "Desperate shortages, looting even in the Core, no power in parts of the Deep. Prices are four times higher, when there is anything to buy." },
	},
	culture = {
		{ "Theaters open", "Books are scarce, but the enclave keeps a busy cultural life of plays, films and books." },
		{ "Theaters closing", "Censorship, threats and lack of resources close theaters; some cinemas show forbidden films in protest." },
		{ "Propaganda", "Conformity grows: what remains shows propaganda of the Houses, and illegal radio stations broadcast protests." },
		{ "Cultural life stopped", "Almost nothing is left but the Voice of Dawn and its endless propaganda." },
	},
	technology = {
		{ "Research goes on", "The scholars of the Academy keep working to bring humanity back to the surface. Artifacts that need more Science than the enclave has can no longer be made." },
		{ "Programs closing", "Some research programs close for lack of resources and rivalries; parts of the Academy are empty. Artifacts that need more Science than the enclave has can no longer be made." },
		{ "Only vital research", "Only the most vital projects go on, with fewer people and resources. Artifacts that need more Science than the enclave has can no longer be made." },
		{ "Academy empty", "The Academy is almost empty; the last scientists try to save what knowledge they can. Artifacts that need more Science than the enclave has can no longer be made." },
	},
	warfare = {
		{ "Incidents: 3 dice", "Crime is common, but guards and Judicators keep law and order. A House rolls 3 dice for an incident handled by other Judicators." },
		{ "Incidents: 4 dice", "More robberies and protests; gangs of the Deep hold whole blocks and workers form vigilante groups. A House rolls 4 dice for an incident handled by other Judicators." },
		{ "Incidents: 5 dice", "Unrest reaches the Core, where gangs grow stronger; shops post guards at the door. A House rolls 5 dice for an incident handled by other Judicators." },
		{ "Incidents: 6 dice", "Riots and looting in the Core, guards and Judicators attacked in the streets, gangs rule the Deep. A House rolls 6 dice for an incident handled by other Judicators." },
	},
};

function onInit()
	GameManager.addAction("myz_devbonus", { });
	ActionsManager.registerResultHandler("myz_devbonus", onDevBonusResult);
	GameManager.addAction("myz_bodycount", { });
	ActionsManager.registerResultHandler("myz_bodycount", onBodyCountResult);
	ItemManager.setCustomCharAdd(onCharItemAdd);
end

function isEnclave()
	return managerGame.getGame() == "elysium";
end

-- Name of a DEV level in the game of the campaign
function getDevName(rDev)
	return managerGame.getDevLabel(rDev.field);
end

-- A new Ark (all its levels at 0) starts its DEV levels at the value of the game (80 for the enclave of
-- Elysium); the fields of the window already exist when it opens, so "devstart" marks the Arks already checked
function initDevLevels(nodeArk)
	local nStart = managerGame.getDevStart();
	if nStart &lt;= 0 or DB.getValue(nodeArk, "devstart", 0) == 1 then
		return;
	end
	local bNew = true;
	for _,rDev in ipairs(aDevLevels) do
		if DB.getValue(nodeArk, rDev.field, 0) ~= 0 then
			bNew = false;
		end
	end
	if bNew then
		for _,rDev in ipairs(aDevLevels) do
			DB.setValue(nodeArk, rDev.field, "number", nStart);
		end
	end
	DB.setValue(nodeArk, "devstart", "number", 1);
end

function getDevLevel(sText)
	local sLower = sText:lower();
	for _,rDev in ipairs(aDevLevels) do
		for _,sKey in ipairs(rDev.keys) do
			if sLower:find(sKey, 1, true) then
				return rDev;
			end
		end
	end
	return nil;
end

-- "Culture 5, Technology 10" or "Warfare +2D6, Culture -1D6": a list of { rDev, nDice, nValue, nSign }
function parseDevList(sText)
	local aList = {};
	for sPart in sText:gmatch("[^,;]+") do
		local rDev = getDevLevel(sPart);
		if rDev then
			local nDice = tonumber(sPart:lower():match("(%d+)%s*d6"));
			local nSign = sPart:match("%-%s*%d") and -1 or 1;
			table.insert(aList, { rDev = rDev, nDice = nDice or 0, nValue = nDice and 0 or (tonumber(sPart:match("(%d+)")) or 0), nSign = nSign });
		end
	end
	return aList;
end

-- The Ark of a project or of an artifact in the Dawn Vault
function getArkNode(nodeEntry)
	return DB.getChild(nodeEntry, "...");
end

-- Work points are given per player character
function getPCCount()
	local nPCs = DB.getChildCount("partysheet.partyinformation");
	if nPCs == 0 then
		nPCs = DB.getChildCount("charsheet");
	end
	return math.max(1, nPCs);
end

function announce(sText)
	Comm.deliverChatMessage({ font = "msgfont", text = sText });
end

--
-- Values derived from the DEV levels
--

function getDevStep(nLevel)
	return math.min(3, math.floor(math.max(0, nLevel) / 10));
end

-- Step of a level of the enclave, from 1 (60+) to 4 (0-19)
function getEnclaveStep(nLevel)
	if nLevel &gt;= 60 then
		return 1;
	elseif nLevel &gt;= 40 then
		return 2;
	elseif nLevel &gt;= 20 then
		return 3;
	end
	return 4;
end

-- 0-9 is Battle Level 1, 10-19 is 2...
function getBattleLevel(nWarfare)
	return math.floor(math.max(0, nWarfare) / 10) + 1;
end

function getDerivedText(sField, nLevel)
	if isEnclave() then
		local aStep = tDerivedEnclave[sField][getEnclaveStep(nLevel)];
		return aStep[1], aStep[2];
	end
	local aStep = tDerived[sField][getDevStep(nLevel) + 1];
	if sField == "warfare" then
		return "Battle Level " .. getBattleLevel(nLevel), aStep[2] .. " Battle Level +1 when the Ark is on alert.";
	end
	return aStep[1], aStep[2];
end

--
-- Body count of the session: 1D6 at the end of each session, lowered by the food supply and changed by
-- completed projects (their body count field, e.g. -1 or +1D6); the result is taken from the population
--

function getBodyCount(nodeArk)
	local nDice, nMod = 1, 0;
	local aSources = {};
	local nFood = getDevStep(DB.getValue(nodeArk, "foodsupply", 0));
	if nFood &gt; 0 then
		nMod = nMod - nFood;
		table.insert(aSources, "Food Supply -" .. nFood);
	end
	for _,nodeProject in ipairs(DB.getChildList(nodeArk, "projectlist")) do
		local sChange = DB.getValue(nodeProject, "bodycount", ""):gsub("%s+", ""):lower();
		if DB.getValue(nodeProject, "complete", 0) == 1 and sChange ~= "" then
			for sSign, sTerm in sChange:gmatch("([%+%-]?)([^%+%-]+)") do
				local nSign = (sSign == "-") and -1 or 1;
				local sDice = sTerm:match("^(%d*)d6$");
				if sDice then
					if nSign &gt; 0 then
						nDice = nDice + (tonumber(sDice) or 1);
					end
				elseif tonumber(sTerm) then
					nMod = nMod + nSign * tonumber(sTerm);
				end
			end
			table.insert(aSources, DB.getValue(nodeProject, "name", "") .. " " .. DB.getValue(nodeProject, "bodycount", ""));
		end
	end
	return nDice, nMod, aSources;
end

function getBodyCountText(nodeArk)
	local nDice, nMod, aSources = getBodyCount(nodeArk);
	local sDice = nDice .. "D6";
	if nMod ~= 0 then
		sDice = sDice .. string.format("%+d", nMod);
	end
	return sDice, aSources;
end

function rollBodyCount(nodeArk)
	local nDice, nMod, aSources = getBodyCount(nodeArk);
	local sDesc = "Body count of the session";
	if #aSources &gt; 0 then
		sDesc = sDesc .. " [" .. table.concat(aSources, ", ") .. "]";
	end
	local sDice = nDice .. "d6";
	if nMod ~= 0 then
		sDice = sDice .. string.format("%+d", nMod);
	end
	RulesetWizardDiceRoller.Roll(nil, nil, "myz_bodycount", sDesc, sDice, 0, { sArk = DB.getPath(nodeArk) });
end

function onBodyCountResult(rSource, rTarget, rRoll)
	local nDead = math.max(0, ActionsManager.total(rRoll));
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	local nodeArk = DB.findNode(rRoll.sArk or "");
	if nodeArk then
		local nPopulation = DB.getValue(nodeArk, "population", 0);
		local nNewPopulation = math.max(0, nPopulation - nDead);
		DB.setValue(nodeArk, "population", "number", nNewPopulation);
		rMessage.text = rMessage.text .. " [" .. nDead .. " dead] [Population " .. nPopulation .. " -&gt; " .. nNewPopulation .. "]";
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

--
-- Dawn Vault: artifacts handed over to it add their DEV bonus to the Ark (rolled), and lose it when taken out
--

function storeArtifact(nodeArk, sRecord)
	local nodeSource = managerChar.resolveRefNode(sRecord);
	if not nodeSource then
		return;
	end
	local sName = DB.getValue(nodeSource, "name", "");
	if DB.getValue(nodeSource, "type", "") ~= "artifact" then
		ChatManager.SystemMessage("Only artifacts can be handed over to the Dawn Vault (" .. sName .. " is not one).");
		return;
	end

	local nodeArtifact = DB.createChild(DB.createChild(nodeArk, "vaultlist"));
	DB.copyNode(nodeSource, nodeArtifact);
	DB.setValue(nodeArtifact, "count", "number", 1);

	-- An artifact from the inventory of a character leaves it
	local sText = "The " .. sName .. " is handed over to the Dawn Vault";
	if sRecord:match("^charsheet%.[^%.]+%.inventorylist%.[^@]+$") then
		local nodeChar = DB.getChild(nodeSource, "...");
		sText = DB.getValue(nodeChar, "name", "") .. " hands over the " .. sName .. " to the Dawn Vault";
		local nCount = DB.getValue(nodeSource, "count", 1);
		if nCount &gt; 1 then
			DB.setValue(nodeSource, "count", "number", nCount - 1);
		else
			DB.deleteNode(nodeSource);
		end
	end
	announce(sText .. ".");
	applyDevBonus(nodeArtifact, 1);
end

function removeArtifact(nodeArtifact)
	announce("The " .. DB.getValue(nodeArtifact, "name", "") .. " is taken out of the Dawn Vault.");
	applyDevBonus(nodeArtifact, -1);
	DB.deleteNode(nodeArtifact);
end

-- A character who gets an artifact understands it only if the Ark has the DEV level it requires;
-- otherwise the character must roll Comprehend. In Elysium the Science required by an artifact is the one needed
-- to make it, so there is no warning
function onCharItemAdd(nodeItem)
	if CharManager.onCharItemAdd then
		CharManager.onCharItemAdd(nodeItem);
	end
	if isEnclave() or DB.getValue(nodeItem, "type", "") ~= "artifact" then
		return;
	end
	local nodeArk = DB.getChildList("ark")[1];
	if not nodeArk then
		return;
	end

	local aMissing = {};
	for _,rRequired in ipairs(parseDevList(DB.getValue(nodeItem, "devrequired", ""))) do
		local nLevel = DB.getValue(nodeArk, rRequired.rDev.field, 0);
		if nLevel &lt; rRequired.nValue then
			table.insert(aMissing, getDevName(rRequired.rDev) .. " " .. rRequired.nValue .. " (it has " .. nLevel .. ")");
		end
	end
	if #aMissing &gt; 0 then
		local nodeChar = DB.getChild(nodeItem, "...");
		announce(DB.getValue(nodeChar, "name", "") .. " must roll Comprehend to use the " .. DB.getValue(nodeItem, "name", "") ..
				": the Ark needs " .. table.concat(aMissing, ", ") .. " to understand it.");
	end
end

--
-- Starting a project
--

function startProject(nodeArk, sRecord)
	local nodeSource = managerChar.resolveRefNode(sRecord);
	if not nodeSource then
		return;
	end
	local sName = DB.getValue(nodeSource, "name", "");

	for _,nodeProject in ipairs(DB.getChildList(nodeArk, "projectlist")) do
		if DB.getValue(nodeProject, "name", ""):lower() == sName:lower() then
			if DB.getValue(nodeProject, "complete", 0) == 1 then
				ChatManager.SystemMessage("The project " .. sName .. " is already completed.");
			else
				ChatManager.SystemMessage("The project " .. sName .. " is already in progress.");
			end
			return;
		end
	end

	local aMissing = {};
	for _,rRequired in ipairs(parseDevList(DB.getValue(nodeSource, "devrequired", ""))) do
		local nLevel = DB.getValue(nodeArk, rRequired.rDev.field, 0);
		if nLevel &lt; rRequired.nValue then
			table.insert(aMissing, getDevName(rRequired.rDev) .. " " .. rRequired.nValue .. " (the Ark has " .. nLevel .. ")");
		end
	end
	if #aMissing &gt; 0 then
		ChatManager.SystemMessage("The project " .. sName .. " needs " .. table.concat(aMissing, ", ") .. ".");
		return;
	end

	local nodeProject = DB.createChild(DB.createChild(nodeArk, "projectlist"));
	DB.copyNode(nodeSource, nodeProject);
	local nWorkPoints = DB.getValue(nodeSource, "wppc", 1) * getPCCount();
	DB.setValue(nodeProject, "workpoints", "number", nWorkPoints);
	DB.setValue(nodeProject, "complete", "number", 0);

	local sText = "The People start the project " .. sName .. " (" .. nWorkPoints .. " work points)";
	local sOther = DB.getValue(nodeSource, "otherreq", "");
	if sOther ~= "" then
		sText = sText .. ". It also requires: " .. sOther;
	end
	announce(sText .. ".");
end

--
-- Working on a project: fills the dice pool of the character with one of the skills of the project;
-- the roll of the pool takes the work points
--

function workOnProject(nodeProject)
	if DB.getValue(nodeProject, "complete", 0) == 1 then
		ChatManager.SystemMessage("The project " .. DB.getValue(nodeProject, "name", "") .. " is already completed.");
		return;
	end

	if not Session.IsHost then
		local sIdentity = User.getCurrentIdentity();
		local nodeChar = sIdentity and DB.findNode("charsheet." .. sIdentity);
		if not nodeChar then
			ChatManager.SystemMessage("Choose one of your characters to work on the project.");
			return;
		end
		chooseSkill(nodeChar, nodeProject);
		return;
	end

	local aOptions = {};
	for _,nodeChar in ipairs(DB.getChildList("charsheet")) do
		table.insert(aOptions, { text = DB.getValue(nodeChar, "name", ""), linkclass = "charsheet", linkrecord = DB.getPath(nodeChar) });
	end
	if #aOptions == 0 then
		return;
	end
	DialogManager.requestSelectionDialog({ title = "Work on the project", msg = "Who works on " .. DB.getValue(nodeProject, "name", "") .. "?",
			options = aOptions, min = 1, max = 1, callback = onCharSelection, custom = { sProject = DB.getPath(nodeProject) } });
end

function onCharSelection(_, tCustom, aSelectionLinks)
	local nodeProject = DB.findNode(tCustom.sProject);
	local tLink = (aSelectionLinks or {})[1];
	local nodeChar = tLink and DB.findNode(tLink.linkrecord or "");
	if nodeProject and nodeChar then
		chooseSkill(nodeChar, nodeProject);
	end
end

-- The skills of a project are written as "Force or Scout" (also with commas or slashes)
function chooseSkill(nodeChar, nodeProject)
	local tProjectSkills = {};
	local sSkills = DB.getValue(nodeProject, "skills", ""):lower():gsub("%s+or%s+", ","):gsub("%s+o%s+", ",");
	for sSkill in sSkills:gmatch("[^,/]+") do
		tProjectSkills[StringManager.trim(sSkill)] = true;
	end

	local aSkills = {};
	for _,nodeSkill in ipairs(DB.getChildList(nodeChar, "skilllist")) do
		if tProjectSkills[DB.getValue(nodeSkill, "name", ""):lower()] then
			table.insert(aSkills, nodeSkill);
		end
	end

	if #aSkills == 0 then
		ChatManager.SystemMessage(DB.getValue(nodeChar, "name", "") .. " has none of the skills of the project (" .. DB.getValue(nodeProject, "skills", "") .. ").");
		return;
	end
	if #aSkills == 1 then
		setWorkPool(nodeChar, aSkills[1], nodeProject);
		return;
	end
	local aOptions = {};
	for _,nodeSkill in ipairs(aSkills) do
		table.insert(aOptions, { text = DB.getValue(nodeSkill, "name", ""), linkclass = "skill", linkrecord = DB.getPath(nodeSkill) });
	end
	DialogManager.requestSelectionDialog({ title = "Work on the project", msg = "Which skill does " .. DB.getValue(nodeChar, "name", "") .. " use?",
			options = aOptions, min = 1, max = 1, callback = onSkillSelection,
			custom = { sChar = DB.getPath(nodeChar), sProject = DB.getPath(nodeProject) } });
end

function onSkillSelection(_, tCustom, aSelectionLinks)
	local nodeChar = DB.findNode(tCustom.sChar);
	local nodeProject = DB.findNode(tCustom.sProject);
	local tLink = (aSelectionLinks or {})[1];
	local nodeSkill = tLink and DB.findNode(tLink.linkrecord or "");
	if nodeChar and nodeProject and nodeSkill then
		setWorkPool(nodeChar, nodeSkill, nodeProject);
	end
end

function setWorkPool(nodeChar, nodeSkill, nodeProject)
	local sAttribute = DB.getValue(nodeSkill, "attribute", "");
	local nAttribute = managerGame.getCurrentAttribute(nodeChar, sAttribute) or 0;
	DB.setValue(nodeChar, "dbase", "number", nAttribute);
	DB.setValue(nodeChar, "dskill", "number", math.max(0, DB.getValue(nodeSkill, "score", 0)));
	DB.setValue(nodeChar, "diceInfoAttribute", "string", sAttribute);
	DB.setValue(nodeChar, "diceInfoSkill", "string", DB.getValue(nodeSkill, "name", ""));
	DB.setValue(nodeChar, "diceInfoProject", "string", DB.getPath(nodeProject));
	ChatManager.SystemMessage(DB.getValue(nodeChar, "name", "") .. " works on " .. DB.getValue(nodeProject, "name", "") ..
			" with " .. DB.getValue(nodeSkill, "name", "") .. ": roll the dice pool of the character sheet (gear dice can be added).");
end

-- Called with the successes of a roll of the dice pool; returns the text for the roll message and the
-- project when it is completed with this roll
function applyWork(sCreatureNode, nSuccess)
	local nodeProject = DB.findNode(DB.getValue(sCreatureNode .. ".diceProjectf", ""));
	if not nodeProject or DB.getValue(nodeProject, "complete", 0) == 1 then
		return "", nil;
	end
	local sName = DB.getValue(nodeProject, "name", "");
	if nSuccess &lt;= 0 then
		return " [" .. sName .. ": no progress]", nil;
	end
	local nWorkPoints = math.max(0, DB.getValue(nodeProject, "workpoints", 0) - nSuccess);
	DB.setValue(nodeProject, "workpoints", "number", nWorkPoints);
	if nWorkPoints &gt; 0 then
		return " [" .. sName .. ": -" .. nSuccess .. " WP, " .. nWorkPoints .. " left]", nil;
	end
	return " [" .. sName .. ": COMPLETED]", nodeProject;
end

--
-- Completing and destroying projects
--

-- The DEV bonus of a project or an artifact is rolled and added to the Ark (nSign -1 takes it away again);
-- a negative bonus (Culture -1D6) is taken away when added
function applyDevBonus(nodeEntry, nSign)
	local nodeArk = getArkNode(nodeEntry);
	local sName = DB.getValue(nodeEntry, "name", "");
	for _,rBonus in ipairs(parseDevList(DB.getValue(nodeEntry, "devbonus", ""))) do
		local nBonusSign = nSign * rBonus.nSign;
		local sLabel = getDevName(rBonus.rDev);
		if rBonus.nDice &gt; 0 then
			RulesetWizardDiceRoller.Roll(nil, nil, "myz_devbonus", sName .. ": " .. sLabel, rBonus.nDice .. "d6", 0,
					{ sArk = DB.getPath(nodeArk), sField = rBonus.rDev.field, sLabel = sLabel, nSign = nBonusSign });
		elseif rBonus.nValue &gt; 0 then
			addDevLevel(nodeArk, rBonus.rDev, nBonusSign * rBonus.nValue, sName);
		end
	end
end

function addDevLevel(nodeArk, rDev, nChange, sSource)
	local nLevel = DB.getValue(nodeArk, rDev.field, 0);
	local nNewLevel = math.max(0, nLevel + nChange);
	DB.setValue(nodeArk, rDev.field, "number", nNewLevel);
	announce(sSource .. ": " .. getDevName(rDev) .. " " .. nLevel .. " -&gt; " .. nNewLevel .. ".");
end

function onDevBonusResult(rSource, rTarget, rRoll)
	local nTotal = ActionsManager.total(rRoll);
	local nodeArk = DB.findNode(rRoll.sArk or "");
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nodeArk then
		local nSign = tonumber(rRoll.nSign) or 1;
		local nLevel = DB.getValue(nodeArk, rRoll.sField, 0);
		local nNewLevel = math.max(0, nLevel + nSign * nTotal);
		DB.setValue(nodeArk, rRoll.sField, "number", nNewLevel);
		rMessage.text = rMessage.text .. " [" .. rRoll.sLabel .. " " .. nLevel .. " -&gt; " .. nNewLevel .. "]";
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

function completeProject(nodeProject)
	DB.setValue(nodeProject, "workpoints", "number", 0);
	DB.setValue(nodeProject, "complete", "number", 1);
	announce("The project " .. DB.getValue(nodeProject, "name", "") .. " is completed.");
	applyDevBonus(nodeProject, 1);
end

-- A destroyed project is erased from the Ark; if it was completed, its DEV bonus is rolled again and lost
function destroyProject(nodeProject)
	local sName = DB.getValue(nodeProject, "name", "");
	if DB.getValue(nodeProject, "complete", 0) == 1 then
		applyDevBonus(nodeProject, -1);
	end
	announce("The project " .. sName .. " is destroyed.");
	DB.deleteNode(nodeProject);
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>