<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>managerRecovery</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Natural recovery: after at least four hours of rest, each kind of trauma is recovered with its resource
-- (Strength with grub, Agility with water, Wits with sleep, Empathy with intimacy; Instinct of animals with the
-- behavior of their animal type). The first ration of grub or water, or the first sleep, only ends the hungry,
-- dehydrated or sleepless condition. In Genlab Alpha each ration of grub or water recovers a single point.

function isCondition(nodeChar, sCondition)
	return DB.getValue(nodeChar, sCondition, 0) ~= 0;
end

-- Name of a resource in the texts of the rest
local function getResourceText(sResource)
	return managerInventory.getResourceLabel(sResource):lower();
end

-- Spends one unit of a resource; false when there is none
function spendResource(nodeChar, sResource)
	if managerInventory.getResource(nodeChar, sResource) &lt;= 0 then
		return false;
	end
	CurrencyManager.addRecordCurrency(nodeChar, managerInventory.getResourceName(nodeChar, sResource), -1);
	return true;
end

-- Recovers the trauma of an attribute, unless a condition prevents it; spends the resource only then (a unit
-- for all the trauma, or one per point in Genlab Alpha). The conditions are checkboxes of the character sheet,
-- named in the texts by the string resources recovery_condition_&lt;field&gt;
function recoverAttribute(nodeChar, sCode, sResource, aBlockers)
	local rAttribute = managerGame.getAttribute(nodeChar, sCode);
	local sLoss = rAttribute.loss:lower();
	for _,sCondition in ipairs(aBlockers) do
		if isCondition(nodeChar, sCondition) then
			return string.format(Interface.getString("recovery_text_blocked"), sLoss, Interface.getString("recovery_condition_" .. sCondition));
		end
	end
	local sField = rAttribute.field;
	local nLoss = DB.getValue(nodeChar, sField .. "_loss", 0);
	if nLoss &lt;= 0 then
		return string.format(Interface.getString("recovery_text_no_loss"), sLoss);
	end
	if sResource and managerGame.isRecoveryPerPoint() then
		local nRecovered = math.min(nLoss, managerInventory.getResource(nodeChar, sResource));
		if nRecovered &lt;= 0 then
			return string.format(Interface.getString("recovery_text_no_resource"), getResourceText(sResource));
		end
		CurrencyManager.addRecordCurrency(nodeChar, managerInventory.getResourceName(nodeChar, sResource), -nRecovered);
		DB.setValue(nodeChar, sField .. "_loss", "number", nLoss - nRecovered);
		return string.format(Interface.getString("recovery_text_recovers_points"), nRecovered, sLoss, nRecovered, getResourceText(sResource));
	end
	if sResource and not spendResource(nodeChar, sResource) then
		return string.format(Interface.getString("recovery_text_no_resource"), getResourceText(sResource));
	end
	DB.setValue(nodeChar, sField .. "_loss", "number", 0);
	return string.format(Interface.getString("recovery_text_recovers"), nLoss, sLoss);
end

function endCondition(nodeChar, sCondition, sResource, sText)
	if sResource and not spendResource(nodeChar, sResource) then
		return string.format(Interface.getString("recovery_text_no_resource"), getResourceText(sResource));
	end
	DB.setValue(nodeChar, sCondition, "number", 0);
	return sText;
end

function eat(nodeChar)
	if isCondition(nodeChar, "starving") then
		return endCondition(nodeChar, "starving", managerInventory.RESOURCE_GRUB, Interface.getString("recovery_text_eat_condition"));
	end
	return recoverAttribute(nodeChar, "STR", managerInventory.RESOURCE_GRUB, { "dehydrated", "hypothermic" });
end

function drink(nodeChar)
	if isCondition(nodeChar, "dehydrated") then
		return endCondition(nodeChar, "dehydrated", managerInventory.RESOURCE_WATER, Interface.getString("recovery_text_drink_condition"));
	end
	return recoverAttribute(nodeChar, "AGI", managerInventory.RESOURCE_WATER, {});
end

function sleep(nodeChar)
	if isCondition(nodeChar, "sleepless") then
		return endCondition(nodeChar, "sleepless", nil, Interface.getString("recovery_text_sleep_condition"));
	end
	return recoverAttribute(nodeChar, "WIT", nil, { "dehydrated", "hypothermic" });
end

function share(nodeChar)
	return recoverAttribute(nodeChar, "EMP", nil, { "dehydrated" });
end

-- A dose of booze heals 1 damage and 1 doubt at once (they come back after 1D6 hours) and causes 1 confusion
function booze(nodeChar)
	if not spendResource(nodeChar, managerInventory.RESOURCE_BOOZE) then
		return string.format(Interface.getString("recovery_text_no_resource"), getResourceText(managerInventory.RESOURCE_BOOZE));
	end
	local aResults = {};
	for _,sCode in ipairs({ "STR", "EMP" }) do
		local rAttribute = managerGame.getAttribute(nodeChar, sCode);
		local nLoss = DB.getValue(nodeChar, rAttribute.field .. "_loss", 0);
		if nLoss &gt; 0 then
			DB.setValue(nodeChar, rAttribute.field .. "_loss", "number", nLoss - 1);
			table.insert(aResults, "1 " .. rAttribute.loss:lower());
		end
	end
	local sText = Interface.getString("recovery_text_booze");
	if #aResults &gt; 0 then
		sText = sText .. string.format(Interface.getString("recovery_text_booze_heals"), table.concat(aResults, " " .. Interface.getString("recovery_text_and") .. " "));
	end
	local sConfusion = managerRolls.applyAttributeLoss(DB.getPath(nodeChar), managerGame.getAttribute(nodeChar, "WIT"), 1);
	if sConfusion then
		sText = sText .. " [" .. sConfusion .. "]";
	end
	return sText;
end

-- The options must fit the width of the selection dialog
function rest(nodeChar)
	local aOptions = {};
	local tActions = {};
	local function addOption(sText, sAction)
		table.insert(aOptions, sText);
		tActions[sText] = sAction;
	end

	local bPerPoint = managerGame.isRecoveryPerPoint();
	if isCondition(nodeChar, "starving") then
		addOption(Interface.getString("recovery_option_eat_condition"), "eat");
	elseif bPerPoint then
		addOption(Interface.getString("recovery_option_eat_points"), "eat");
	else
		addOption(Interface.getString("recovery_option_eat"), "eat");
	end
	if isCondition(nodeChar, "dehydrated") then
		addOption(Interface.getString("recovery_option_drink_condition"), "drink");
	elseif bPerPoint then
		addOption(Interface.getString("recovery_option_drink_points"), "drink");
	else
		addOption(Interface.getString("recovery_option_drink"), "drink");
	end
	if isCondition(nodeChar, "sleepless") then
		addOption(Interface.getString("recovery_option_sleep_condition"), "sleep");
	else
		addOption(Interface.getString("recovery_option_sleep"), "sleep");
	end
	local rType = managerGame.getCharTypeData(nodeChar);
	addOption(string.format(Interface.getString("recovery_option_share"), managerGame.getEmpathyRecovery(nodeChar), rType.empathy), "share");
	addOption(Interface.getString("recovery_option_booze"), "booze");

	DialogManager.requestSelectionDialog({ title = Interface.getString("recovery_title"),
			msg = string.format(Interface.getString("recovery_msg_choose"), DB.getValue(nodeChar, "name", "")),
			options = aOptions, min = 1, max = #aOptions,
			callback = onRestSelection, custom = { sChar = DB.getPath(nodeChar), tActions = tActions } });
end

function onRestSelection(aSelections, tCustom)
	local nodeChar = DB.findNode(tCustom.sChar);
	if not nodeChar then
		return;
	end
	local aResults = {};
	for _,sSelection in ipairs(aSelections) do
		local sAction = tCustom.tActions[sSelection];
		if sAction then
			table.insert(aResults, managerRecovery[sAction](nodeChar));
		end
	end
	Comm.deliverChatMessage({ font = "msgfont", text = string.format(Interface.getString("recovery_msg_result"), DB.getValue(nodeChar, "name", ""), table.concat(aResults, "; ")) });
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>