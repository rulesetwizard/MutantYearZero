<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>managerDamage</ScriptName>
    <FolderID>9</FolderID>
    <Script>OOB_MSGTYPE_APPLYDAMAGE = "myz_applydamage";

-- English names of the Critical Injuries table and of the Broken effect; their names in the language of the
-- campaign are string resources, and both are recognized
CRITICAL_INJURIES_TABLE = "Critical Injuries";
BROKEN_EFFECT = "Broken";

local aAttributeFields = { "strength", "agility", "wits", "empathy" };

function onInit()
	GameManager.addAction("myz_soak", { });
	ActionsManager.registerResultHandler("myz_soak", onSoakResult);
	OOBManager.registerOOBMsgHandler(OOB_MSGTYPE_APPLYDAMAGE, handleDamage);

	if Session.IsHost then
		createCriticalInjuriesTable();
		for _,sField in ipairs(aAttributeFields) do
			for _,sPath in ipairs({ "charsheet.*.", "combattracker.list.*." }) do
				DB.addHandler(sPath .. sField, "onUpdate", onAttributeChanged);
				DB.addHandler(sPath .. sField .. "_loss", "onUpdate", onAttributeChanged);
			end
		end
	end
end

--
-- Kind of damage of a weapon (Elysium): "damage" (Strength), "fatigue" (Agility, stun weapons) or "both" (the armor
-- does not stop the fatigue); and the armor points it ignores (gauss weapons)
--

function getDamageWord(sType)
	if sType == "fatigue" then
		return Interface.getString("damage_word_fatigue");
	elseif sType == "both" then
		return Interface.getString("damage_word_both");
	end
	return Interface.getString("damage_word_damage");
end

-- The same, capitalized, to begin a text
function getDamageLabel(sType)
	if sType == "fatigue" then
		return Interface.getString("damage_label_fatigue");
	elseif sType == "both" then
		return Interface.getString("damage_label_both");
	end
	return Interface.getString("damage_label_damage");
end

-- Applies the damage to every target of the attacker, with the kind of damage and armor piercing of the weapon
-- that set it (kept in the attacker until the damage is applied); returns false when the attacker has no targets
function applyDamage(nodeAttacker, nDamage)
	local rSource = ActorManager.resolveActor(nodeAttacker);
	local aTargets = TargetingManager.getFullTargets(rSource);
	if #aTargets == 0 then
		return false;
	end
	local sType = DB.getValue(nodeAttacker, "ddamagetype", "");
	local nPierce = DB.getValue(nodeAttacker, "ddamagepierce", 0);
	for _,rTarget in ipairs(aTargets) do
		soakDamage(rSource, rTarget, nDamage, sType, nPierce);
	end
	DB.setValue(nodeAttacker, "ddamagetype", "string", "");
	DB.setValue(nodeAttacker, "ddamagepierce", "number", 0);
	return true;
end

-- PCs get the damage as pending, until their player rolls the armor of their choice or accepts it.
-- NPCs roll their best armor at once: each 6 stops 1 point of damage and each 1 lowers the armor by 1.
function soakDamage(rSource, rTarget, nDamage, sType, nPierce)
	local sAttacker = ActorManager.getDisplayName(rSource);
	local rDamage = { nDamage = nDamage, nRaw = nDamage, sType = sType or "", nPierce = nPierce or 0, sAttacker = sAttacker };
	if ActorManager.isPC(rTarget) then
		notifyDamage(rTarget, "pending", rDamage);
		return;
	end

	local nodeTarget = ActorManager.getCreatureNode(rTarget);
	local nodeArmor = getArmorNode(nodeTarget);
	local nArmor = 0;
	if nodeArmor then
		nArmor = math.max(0, DB.getValue(nodeArmor, getArmorField(nodeArmor), 0) - rDamage.nPierce);
	end
	if nArmor &lt;= 0 then
		notifyDamage(rTarget, "apply", rDamage);
		return;
	end

	local sDesc = string.format(Interface.getString("damage_desc_soak"), DB.getValue(nodeArmor, "name", ""), nDamage, getDamageWord(rDamage.sType));
	if rDamage.nPierce &gt; 0 then
		sDesc = sDesc .. " " .. string.format(Interface.getString("damage_text_pierce"), rDamage.nPierce);
	end
	RulesetWizardDiceRoller.Roll(nil, nodeTarget, "myz_soak", sDesc, nArmor .. "dgear", 0,
			{ nDamage = nDamage, sDamageType = rDamage.sType, sArmorNode = DB.getPath(nodeArmor), sAttacker = sAttacker });
end

-- The best armor of an NPC
function getArmorNode(nodeTarget)
	local nodeBest = nil;
	local nBest = 0;
	for _,nodeItem in ipairs(DB.getChildList(nodeTarget, "armorlist")) do
		local nValue = DB.getValue(nodeItem, "bonus", 0);
		if nValue &gt; nBest then
			nodeBest = nodeItem;
			nBest = nValue;
		end
	end
	return nodeBest;
end

-- Armor items of PCs keep their rating in "armor"; the armor of NPCs keeps it in "bonus"
function getArmorField(nodeArmor)
	if DB.getName(DB.getParent(nodeArmor)) == "inventorylist" then
		return "armor";
	end
	return "bonus";
end

-- Dice of an armor roll of a PC against the pending damage, less the armor the weapon ignores; with no dice left
-- the damage is taken at once and nil is returned
function getPendingArmorDice(nodeChar, nArmor)
	local nPierce = DB.getValue(nodeChar, "pendingpierce", 0);
	if nPierce &lt;= 0 or DB.getValue(nodeChar, "pendingdamage", 0) &lt;= 0 then
		return nArmor, "";
	end
	local nDice = math.max(0, nArmor - nPierce);
	if nDice &lt;= 0 then
		takePendingDamage(nodeChar, 0);
		return nil, "";
	end
	return nDice, string.format(Interface.getString("damage_text_pierce"), nPierce) .. " ";
end

function degradeArmor(sArmorNode, nBreak)
	local nodeArmor = DB.findNode(sArmorNode);
	if not nodeArmor or nBreak &lt;= 0 then
		return "";
	end
	local sField = getArmorField(nodeArmor);
	local nArmor = DB.getValue(nodeArmor, sField, 0);
	local nNewArmor = math.max(0, nArmor - nBreak);
	DB.setValue(nodeArmor, sField, "number", nNewArmor);
	return " [" .. string.format(Interface.getString("damage_text_armor"), DB.getValue(nodeArmor, "name", ""), nArmor, nNewArmor) .. "]";
end

function onSoakResult(rSource, rTarget, rRoll)
	local nStopped = 0;
	local nBreak = 0;
	for _,v in ipairs(rRoll.aDice) do
		if v.value == 6 then
			nStopped = nStopped + 1;
		elseif v.value == 1 then
			nBreak = nBreak + 1;
		end
	end
	local nRaw = tonumber(rRoll.nDamage) or 0;
	local nDamage = math.max(0, nRaw - nStopped);

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("roll_tag_damage_reduction"), nStopped);
	if nBreak &gt; 0 then
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("roll_tag_armor_break"), nBreak);
	end
	rMessage.dicedisplay = 0;
	rMessage.diceskipexpr = true;
	Comm.deliverChatMessage(rMessage);

	notifyDamage(rSource, "apply", { nDamage = nDamage, nRaw = nRaw, sType = rRoll.sDamageType or "",
			sArmorNode = rRoll.sArmorNode or "", nArmorBreak = nBreak, sAttacker = rRoll.sAttacker or "" });
	return true;
end

-- Takes the pending damage of a PC, less the damage stopped by an armor roll (0 to take it all)
function takePendingDamage(nodeChar, nStopped)
	local nPending = DB.getValue(nodeChar, "pendingdamage", 0);
	if nPending &lt;= 0 then
		return;
	end
	local rDamage = { nDamage = math.max(0, nPending - nStopped), nRaw = nPending, sType = DB.getValue(nodeChar, "pendingtype", ""),
			sAttacker = DB.getValue(nodeChar, "pendingattacker", "") };
	DB.setValue(nodeChar, "pendingdamage", "number", 0);
	DB.setValue(nodeChar, "pendingattacker", "string", "");
	DB.setValue(nodeChar, "pendingtype", "string", "");
	DB.setValue(nodeChar, "pendingpierce", "number", 0);
	notifyDamage(nodeChar, "apply", rDamage);
end

-- A successful Heal roll: a broken patient recovers 1 point per success
function notifyHeal(rTarget, nPoints, sHealer)
	notifyDamage(rTarget, "heal", { nDamage = nPoints, sAttacker = sHealer });
end

-- The target may belong to another user, so damage and healing are handled on the host.
-- rDamage: nDamage (after armor), nRaw (before armor), sType, nPierce, sArmorNode, nArmorBreak, sAttacker
function notifyDamage(vTarget, sMode, rDamage)
	local msgOOB = {
		type = OOB_MSGTYPE_APPLYDAMAGE,
		sMode = sMode,
		sTarget = ActorManager.getCreatureNodeName(vTarget),
		nDamage = rDamage.nDamage or 0,
		nRaw = rDamage.nRaw or rDamage.nDamage or 0,
		sType = rDamage.sType or "",
		nPierce = rDamage.nPierce or 0,
		sArmorNode = rDamage.sArmorNode or "",
		nArmorBreak = rDamage.nArmorBreak or 0,
		sAttacker = rDamage.sAttacker or "",
	};
	if Session.IsHost then
		handleDamage(msgOOB);
	else
		Comm.deliverOOBMessage(msgOOB, "");
	end
end

function handleDamage(msgOOB)
	local nodeTarget = DB.findNode(msgOOB.sTarget or "");
	if not nodeTarget then
		return;
	end
	if msgOOB.sMode == "pending" then
		handlePendingDamage(nodeTarget, msgOOB);
	elseif msgOOB.sMode == "heal" then
		handleHeal(nodeTarget, msgOOB);
	else
		handleApplyDamage(nodeTarget, msgOOB);
	end
end

function handlePendingDamage(nodeTarget, msgOOB)
	local nDamage = tonumber(msgOOB.nDamage) or 0;
	local nPending = DB.getValue(nodeTarget, "pendingdamage", 0) + nDamage;
	local nPierce = tonumber(msgOOB.nPierce) or 0;
	DB.setValue(nodeTarget, "pendingdamage", "number", nPending);
	DB.setValue(nodeTarget, "pendingattacker", "string", msgOOB.sAttacker or "");
	DB.setValue(nodeTarget, "pendingtype", "string", msgOOB.sType or "");
	DB.setValue(nodeTarget, "pendingpierce", "number", nPierce);

	local sText = string.format(Interface.getString("damage_msg_hit"), ActorManager.getDisplayName(nodeTarget), nDamage, getDamageWord(msgOOB.sType));
	if (msgOOB.sAttacker or "") ~= "" then
		sText = sText .. " " .. string.format(Interface.getString("damage_msg_hit_by"), msgOOB.sAttacker);
	end
	if nPierce &gt; 0 then
		sText = sText .. " " .. string.format(Interface.getString("damage_msg_hit_pierce"), nPierce);
	end
	sText = sText .. Interface.getString("damage_msg_hit_end");
	Comm.deliverChatMessage({ font = "msgfont", icon = "chat_damage", text = sText });
end

-- Takes points of an attribute of the target (up to its value); returns the text and whether it broke now
function takeAttributeLoss(nodeTarget, sField, sLabel, nPoints)
	local nValue = DB.getValue(nodeTarget, sField, 0);
	local nLoss = DB.getValue(nodeTarget, sField .. "_loss", 0);
	local nNewLoss = math.min(nValue, nLoss + nPoints);
	DB.setValue(nodeTarget, sField .. "_loss", "number", nNewLoss);
	local sText = " [" .. sLabel .. " " .. (nValue - nNewLoss) .. "/" .. nValue .. "]";
	local bBroken = (nNewLoss &gt;= nValue and nLoss &lt; nValue);
	if bBroken then
		sText = sText .. " " .. Interface.getString("damage_text_broken");
	end
	return sText, bBroken;
end

-- Damage lowers Strength and fatigue lowers Agility; with "both" the target also takes the fatigue the armor
-- did not stop
function handleApplyDamage(nodeTarget, msgOOB)
	local nDamage = tonumber(msgOOB.nDamage) or 0;
	local nRaw = tonumber(msgOOB.nRaw) or nDamage;
	local nArmorBreak = tonumber(msgOOB.nArmorBreak) or 0;
	local sType = msgOOB.sType or "";
	local bCritical = false;

	local nFatigue = 0;
	if sType == "fatigue" then
		nFatigue = nDamage;
		nDamage = 0;
	elseif sType == "both" then
		nFatigue = nRaw;
	end

	local sName = ActorManager.getDisplayName(nodeTarget);
	local sText = string.format(Interface.getString("damage_msg_takes_damage"), sName, nDamage);
	if sType == "fatigue" then
		sText = string.format(Interface.getString("damage_msg_takes_fatigue"), sName, nFatigue);
	elseif sType == "both" then
		sText = sText .. " " .. string.format(Interface.getString("damage_msg_and_fatigue"), nFatigue);
	end
	if (msgOOB.sAttacker or "") ~= "" then
		sText = sText .. " " .. string.format(Interface.getString("damage_msg_from"), msgOOB.sAttacker);
	end

	if nArmorBreak &gt; 0 and (msgOOB.sArmorNode or "") ~= "" then
		sText = sText .. degradeArmor(msgOOB.sArmorNode, nArmorBreak);
	end

	if nDamage &gt; 0 then
		local sLoss, bBroken = takeAttributeLoss(nodeTarget, "strength", managerGame.getAttribute(nodeTarget, "STR").label, nDamage);
		sText = sText .. sLoss;
		if bBroken then
			bCritical = true;
			sText = sText .. " " .. string.format(Interface.getString("damage_msg_roll_critical"), Interface.getString("table_critical_injuries"));
		end
	end
	if nFatigue &gt; 0 then
		sText = sText .. takeAttributeLoss(nodeTarget, "agility", managerGame.getAttribute(nodeTarget, "AGI").label, nFatigue);
	end

	Comm.deliverChatMessage({ font = "msgfont", icon = "chat_damage", text = sText });

	if bCritical then
		rollCriticalInjury(nodeTarget);
	end
end

-- Heal gets a broken patient back on their feet: the attribute that broke them recovers 1 point per success.
-- It has no effect on a patient who is not broken, who recovers by resting
function handleHeal(nodeTarget, msgOOB)
	local nPoints = tonumber(msgOOB.nDamage) or 0;
	local rAttribute = nil;
	for _,v in ipairs(managerGame.getAttributes(nodeTarget)) do
		local nValue = DB.getValue(nodeTarget, v.field, 0);
		if nValue &gt; 0 and DB.getValue(nodeTarget, v.field .. "_loss", 0) &gt;= nValue then
			rAttribute = v;
			break;
		end
	end
	if not rAttribute then
		Comm.deliverChatMessage({ font = "msgfont", text = string.format(Interface.getString("damage_msg_heal_notbroken"), ActorManager.getDisplayName(nodeTarget)) });
		return;
	end

	local nValue = DB.getValue(nodeTarget, rAttribute.field, 0);
	local nLoss = DB.getValue(nodeTarget, rAttribute.field .. "_loss", 0);
	local nNewLoss = math.max(0, nLoss - nPoints);
	DB.setValue(nodeTarget, rAttribute.field .. "_loss", "number", nNewLoss);

	local sText = string.format(Interface.getString("damage_msg_heal_recovers"), ActorManager.getDisplayName(nodeTarget), nLoss - nNewLoss, rAttribute.label);
	if (msgOOB.sAttacker or "") ~= "" then
		sText = sText .. " " .. string.format(Interface.getString("damage_msg_heal_thanks"), msgOOB.sAttacker);
	end
	sText = sText .. " [" .. rAttribute.label .. " " .. (nValue - nNewLoss) .. "/" .. nValue .. "]";
	Comm.deliverChatMessage({ font = "msgfont", icon = "chat_success", text = sText });
end

-- Rolls on the Critical Injuries table, if the campaign or a module has it
function rollCriticalInjury(nodeActor)
	local nodeTable = TableManager.findTable(Interface.getString("table_critical_injuries")) or TableManager.findTable(CRITICAL_INJURIES_TABLE);
	if not nodeTable then
		return;
	end
	TableManager.performRoll(nil, ActorManager.resolveActor(nodeActor), { nodeTable = nodeTable }, false);
end

-- Creates an empty d66 Critical Injuries table (rows 11 to 66) for the GM to fill, if the campaign has none
function createCriticalInjuriesTable()
	local sName = Interface.getString("table_critical_injuries");
	local sRoot = RecordDataManager.getDataPathRoot("table");
	for _,nodeTable in ipairs(DB.getChildList(sRoot)) do
		local sTable = DB.getValue(nodeTable, "name", "");
		if sTable == sName or sTable == CRITICAL_INJURIES_TABLE then
			return;
		end
	end

	local nodeTable = DB.createChild(sRoot);
	DB.setValue(nodeTable, "name", "string", sName);
	DB.setValue(nodeTable, "dice", "dice", { "d60", "d6" });
	DB.setValue(nodeTable, "mod", "number", 0);
	DB.setValue(nodeTable, "labelcol1", "string", Interface.getString("table_label_injury"));
	local nodeRows = DB.createChild(nodeTable, "tablerows");
	for nTens = 1, 6 do
		for nUnits = 1, 6 do
			local nodeRow = DB.createChild(nodeRows);
			local nValue = nTens * 10 + nUnits;
			DB.setValue(nodeRow, "fromrange", "number", nValue);
			DB.setValue(nodeRow, "torange", "number", nValue);
			local nodeResult = DB.createChild(DB.createChild(nodeRow, "results"));
			DB.setValue(nodeResult, "result", "string", "");
		end
	end
end

function onAttributeChanged(nodeField)
	updateBroken(DB.getParent(nodeField));
end

-- An actor is broken while any attribute it has is down to 0
function isBroken(nodeActor)
	for _,sField in ipairs(aAttributeFields) do
		local nValue = DB.getValue(nodeActor, sField, 0);
		if nValue &gt; 0 and DB.getValue(nodeActor, sField .. "_loss", 0) &gt;= nValue then
			return true;
		end
	end
	return false;
end

-- Keeps the Broken effect in the combat tracker in step with the attributes
function updateBroken(nodeActor)
	local nodeCT = ActorManager.getCTNode(nodeActor);
	if not nodeCT then
		return;
	end
	local sEffect = Interface.getString("effect_broken");
	local rActor = ActorManager.resolveActor(nodeCT);
	local bBroken = isBroken(nodeActor);
	local bHasEffect = EffectManager.hasEffect(rActor, sEffect) or EffectManager.hasEffect(rActor, BROKEN_EFFECT);
	if bBroken and not bHasEffect then
		EffectManager.addEffect("", "", nodeCT, { sName = sEffect, nDuration = 0, nGMOnly = 0 }, false);
	elseif not bBroken and bHasEffect then
		EffectManager.removeEffect(nodeCT, "^" .. sEffect .. "$");
		EffectManager.removeEffect(nodeCT, "^" .. BROKEN_EFFECT .. "$");
	end
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>