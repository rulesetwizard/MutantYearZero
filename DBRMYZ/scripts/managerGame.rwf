<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>managerGame</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- The game of the campaign (option Game: Mutant: Year Zero, Genlab Alpha or Elysium) and the type of each
-- character (mutant, animal or human): the labels and rules that change between them. The database fields do
-- not change: Instinct is kept in "empathy", Wild Points and Influence Points in "mutationpoints", Production,
-- Science and Security of the enclave in "foodsupply", "technology" and "warfare".
-- The labels in the tables below are string resources; the functions give them translated

OPTION_GAME = "MYZGAME";

-- devLabels: names of the development levels of the Ark (the enclave in Elysium), which start at devStart
local tGames = {
	myz = { chartype = "mutant", recoverPerPoint = false, gmPool = false, devStart = 0, bodyCount = true,
			devLabels = { foodsupply = "ark_dev_foodsupply", culture = "ark_dev_culture", technology = "ark_dev_technology", warfare = "ark_dev_warfare" } },
	-- Genlab Alpha: a ration of grub or water recovers one point of Strength or Agility, and the NPCs use a
	-- common pool of wild points of the GM
	genlab = { chartype = "animal", recoverPerPoint = true, gmPool = true, devStart = 0, bodyCount = true,
			devLabels = { foodsupply = "ark_dev_foodsupply", culture = "ark_dev_culture", technology = "ark_dev_technology", warfare = "ark_dev_warfare" } },
	-- Elysium: the enclave starts its levels at 80 and they go down; it has no body count
	elysium = { chartype = "human", recoverPerPoint = false, gmPool = false, devStart = 80, bodyCount = false,
			devLabels = { foodsupply = "ark_dev_production", culture = "ark_dev_culture", technology = "ark_dev_science", warfare = "ark_dev_security" } },
};

-- Powers: the list that takes the place of the mutations; points: the counter of the sheet; pointsShort: the
-- points gained when pushing (none for humans, whose counter is the influence for their contacts).
-- Rank (animals) and reputation (humans) are kept in "rank"
local tCharTypes = {
	mutant = { label = "chartype_mutant", empathy = "attribute_empathy", empathyCode = "EMP",
			powers = "chartype_mutant_powers", points = "chartype_mutant_points", pointsShort = "chartype_mutant_pointsshort", spendShort = "chartype_mutant_pointsshort", pushText = "chartype_mutant_push",
			empathyRecovery = "chartype_recovery_intimacy" },
	-- Animals recover Instinct with the behavior of their animal type
	animal = { label = "chartype_animal", empathy = "attribute_instinct", empathyCode = "INS",
			powers = "chartype_animal_powers", points = "chartype_animal_points", pointsShort = "chartype_animal_pointsshort", spendShort = "chartype_animal_pointsshort", pushText = "chartype_animal_push",
			empathyRecovery = "chartype_animal_recovery", rank = "chartype_animal_rank", hasAge = true },
	human = { label = "chartype_human", empathy = "attribute_empathy", empathyCode = "EMP",
			powers = "chartype_human_powers", points = "chartype_human_points", pointsShort = nil, spendShort = "chartype_human_spendshort", pushText = "chartype_human_push",
			empathyRecovery = "chartype_recovery_intimacy", rank = "chartype_human_rank", hasAge = true, contacts = true },
};
local aCharTypeTexts = { "label", "empathy", "powers", "points", "pointsShort", "spendShort", "pushText", "empathyRecovery", "rank" };

-- Animal types of Genlab Alpha and their key attribute. Their name, the behavior that recovers Instinct (short, to
-- fit in the Rest dialog) and their species are the string resources animal_&lt;value&gt;, animal_&lt;value&gt;_behavior and
-- animal_&lt;value&gt;_species
local aAnimalTypes = {
	{ value = "dog", key = "INS" },
	{ value = "cat", key = "AGI" },
	{ value = "rat", key = "AGI" },
	{ value = "bear", key = "STR" },
	{ value = "ape", key = "WIT" },
	{ value = "rabbit", key = "INS" },
	{ value = "badger", key = "STR" },
	{ value = "reptile", key = "WIT" },
	{ value = "moose", key = "STR" },
};

-- Houses of Elysium and the attribute of their predisposition: pushing a roll of it also rerolls the 1s
local aHouses = {
	{ value = "warburg", label = "Warburg", attribute = "STR" },
	{ value = "fortescue", label = "Fortescue", attribute = "AGI" },
	{ value = "kilgore", label = "Kilgore", attribute = "WIT" },
	{ value = "morningstar", label = "Morningstar", attribute = "EMP" },
};

local tAttributes = {
	STR = { field = "strength", label = "attribute_strength", loss = "attribute_damage" },
	AGI = { field = "agility", label = "attribute_agility", loss = "attribute_fatigue" },
	WIT = { field = "wits", label = "attribute_wits", loss = "attribute_confusion" },
	EMP = { field = "empathy", label = "attribute_empathy", loss = "attribute_doubt" },
};
local aAttributeOrder = { "STR", "AGI", "WIT", "EMP" };

-- Instinct (Genlab Alpha) is the fourth attribute, kept as Empathy
local tCodeAliases = { INS = "EMP" };

function onInit()
	OptionsManager.registerOptionData({
		sKey = OPTION_GAME, bLocal = false, sGroupRes = "option_header_mutant",
		tCustom = {
			labelsres = "option_val_game_genlab|option_val_game_elysium",
			values = "genlab|elysium",
			baselabelres = "option_val_game_myz",
			baseval = "myz",
			default = "myz",
		},
	});
end

-- A field of a character given as a database node or as a path
function getField(vChar, sField, vDefault)
	if type(vChar) == "string" then
		return DB.getValue(vChar .. "." .. sField, vDefault);
	end
	return DB.getValue(vChar, sField, vDefault);
end

function getGame()
	local sGame = OptionsManager.getOption(OPTION_GAME);
	if tGames[sGame] then
		return sGame;
	end
	return "myz";
end

function isRecoveryPerPoint()
	return tGames[getGame()].recoverPerPoint;
end

function usesGMPool()
	return tGames[getGame()].gmPool;
end

function getDefaultCharType()
	return tGames[getGame()].chartype;
end

--
-- Development levels of the Ark or the enclave
--

function getDevLabel(sField)
	local sRes = tGames[getGame()].devLabels[sField];
	if not sRes then
		return sField;
	end
	return Interface.getString(sRes);
end

function getDevStart()
	return tGames[getGame()].devStart;
end

function hasBodyCount()
	return tGames[getGame()].bodyCount;
end

--
-- Type of character
--

-- The type chosen in the character sheet, or the one of the game
function getCharType(vChar)
	local sType = "";
	if vChar then
		sType = getField(vChar, "chartype", "");
	end
	if tCharTypes[sType] then
		return sType;
	end
	return getDefaultCharType();
end

-- The data of the type of a character, with its labels translated
function getCharTypeData(vChar)
	local rData = {};
	for sKey, vValue in pairs(tCharTypes[getCharType(vChar)]) do
		rData[sKey] = vValue;
	end
	for _,sKey in ipairs(aCharTypeTexts) do
		if rData[sKey] then
			rData[sKey] = Interface.getString(rData[sKey]);
		end
	end
	return rData;
end

--
-- Animal types
--

local function getAnimalTypeData(rType)
	local sRes = "animal_" .. rType.value;
	return { value = rType.value, key = rType.key, label = Interface.getString(sRes),
			behavior = Interface.getString(sRes .. "_behavior"), species = Interface.getString(sRes .. "_species") };
end

function getAnimalTypes()
	local aResult = {};
	for _,rType in ipairs(aAnimalTypes) do
		table.insert(aResult, getAnimalTypeData(rType));
	end
	return aResult;
end

function getAnimalType(vChar)
	local sValue = getField(vChar, "animaltype", "");
	for _,rType in ipairs(aAnimalTypes) do
		if rType.value == sValue then
			return getAnimalTypeData(rType);
		end
	end
	return nil;
end

-- What recovers the fourth attribute: the behavior of the animal type for animals
function getEmpathyRecovery(vChar)
	if getCharType(vChar) == "animal" then
		local rAnimalType = getAnimalType(vChar);
		if rAnimalType then
			return rAnimalType.behavior;
		end
	end
	return getCharTypeData(vChar).empathyRecovery;
end

--
-- Houses
--

function getHouse(vChar)
	local sValue = getField(vChar, "house", "");
	for _,rHouse in ipairs(aHouses) do
		if rHouse.value == sValue then
			return rHouse;
		end
	end
	return nil;
end

-- True when a human pushes a roll of the attribute of the House
function isHouseAttribute(vChar, sCode)
	if getCharType(vChar) ~= "human" then
		return false;
	end
	local rHouse = getHouse(vChar);
	return rHouse ~= nil and rHouse.attribute == normalizeCode(sCode or "");
end

--
-- Attributes
--

function normalizeCode(sCode)
	return tCodeAliases[sCode] or sCode;
end

-- { field, label, loss, code } of an attribute for a character; nil for an unknown code
function getAttribute(vChar, sCode)
	local sCanonical = normalizeCode(sCode or "");
	local rAttribute = tAttributes[sCanonical];
	if not rAttribute then
		return nil;
	end
	local rResult = { field = rAttribute.field, label = Interface.getString(rAttribute.label), loss = Interface.getString(rAttribute.loss), code = sCanonical };
	if sCanonical == "EMP" then
		local rType = getCharTypeData(vChar);
		rResult.label = rType.empathy;
		rResult.code = rType.empathyCode;
	end
	return rResult;
end

function getAttributeByField(vChar, sField)
	for sCode, rAttribute in pairs(tAttributes) do
		if rAttribute.field == sField then
			return getAttribute(vChar, sCode);
		end
	end
	return nil;
end

-- The four attributes of a character, in the order of the sheet
function getAttributes(vChar)
	local aResult = {};
	for _,sCode in ipairs(aAttributeOrder) do
		table.insert(aResult, getAttribute(vChar, sCode));
	end
	return aResult;
end

-- Current value of an attribute (less its trauma, at least 0); nil for an unknown code
function getCurrentAttribute(vChar, sCode)
	local rAttribute = getAttribute(vChar, sCode);
	if not rAttribute then
		return nil;
	end
	return math.max(0, getField(vChar, rAttribute.field, 0) - getField(vChar, rAttribute.field .. "_loss", 0));
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>