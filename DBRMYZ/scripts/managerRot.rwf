<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>managerRot</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Rot: rotpoints counts all the rot points of a character, rotpermanent how many of them are permanent.
-- The rot level of a sector of the Zone (0 to 3) is how often the characters in it gain a rot point: the string
-- resources rot_level_0 to rot_level_3

function onInit()
	GameManager.addAction("myz_rot", { });
	ActionsManager.registerResultHandler("myz_rot", onRotResult);
	GameManager.addAction("myz_decontaminate", { });
	ActionsManager.registerResultHandler("myz_decontaminate", onDecontaminateResult);
end

function getTemporaryRot(nodeChar)
	return math.max(0, DB.getValue(nodeChar, "rotpoints", 0) - DB.getValue(nodeChar, "rotpermanent", 0));
end

-- Gaining rot points: roll one base die per rot point (permanent ones included); each 1 is 1 point of damage
function gainRot(nodeChar, nPoints)
	local nRot = math.min(DB.getValue(nodeChar, "rotpoints_max", 10), DB.getValue(nodeChar, "rotpoints", 0) + nPoints);
	DB.setValue(nodeChar, "rotpoints", "number", nRot);
	RulesetWizardDiceRoller.Roll(nil, nodeChar, "myz_rot", string.format(Interface.getString("rot_desc_roll"), nRot), nRot .. "dbase", 0, {});
end

function onRotResult(rSource, rTarget, rRoll)
	local nDamage = 0;
	for _,rDie in ipairs(rRoll.aDice) do
		if rDie.value == 1 then
			nDamage = nDamage + 1;
		end
	end

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nDamage &gt; 0 then
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("rot_tag_damage"), nDamage);
		local sResult = managerRolls.applyAttributeLoss(rSource.sCreatureNode, managerGame.getAttribute(rSource.sCreatureNode, "STR"), nDamage);
		if sResult then
			rMessage.text = rMessage.text .. " [" .. sResult .. "]";
		end
	else
		rMessage.text = rMessage.text .. " " .. Interface.getString("rot_tag_no_damage");
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

-- Decontamination in a rot-free place: roll one base die per temporary rot point; each 1 makes one of them
-- permanent, and the temporary ones are gone
function decontaminate(nodeChar)
	local nTemporary = getTemporaryRot(nodeChar);
	if nTemporary &lt;= 0 then
		ChatManager.SystemMessage(string.format(Interface.getString("rot_msg_no_temporary"), ActorManager.getDisplayName(nodeChar)));
		return;
	end
	RulesetWizardDiceRoller.Roll(nil, nodeChar, "myz_decontaminate", string.format(Interface.getString("rot_desc_decontaminate"), nTemporary), nTemporary .. "dbase", 0, {});
end

function onDecontaminateResult(rSource, rTarget, rRoll)
	local nodeChar = DB.findNode(rSource.sCreatureNode);
	local nNewPermanent = 0;
	for _,rDie in ipairs(rRoll.aDice) do
		if rDie.value == 1 then
			nNewPermanent = nNewPermanent + 1;
		end
	end

	local nPermanent = math.min(DB.getValue(nodeChar, "rotpoints", 0), DB.getValue(nodeChar, "rotpermanent", 0) + nNewPermanent);
	DB.setValue(nodeChar, "rotpermanent", "number", nPermanent);
	DB.setValue(nodeChar, "rotpoints", "number", nPermanent);

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nNewPermanent &gt; 0 then
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("rot_tag_permanent_new"), nNewPermanent);
	end
	if nPermanent &gt; 0 then
		rMessage.text = rMessage.text .. " " .. string.format(Interface.getString("rot_tag_permanent"), nPermanent);
	else
		rMessage.text = rMessage.text .. " " .. Interface.getString("rot_tag_none");
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

--
-- Rot of the sectors of the Zone log: the GM applies the rot point of a sector each time it is due (each day,
-- hour or minute, by its rot level) to the characters in it
--

function getRotLevelText(nLevel)
	return Interface.getString("rot_level_" .. math.max(0, math.min(3, nLevel)));
end

function applySectorRot(nodeSector)
	local nLevel = DB.getValue(nodeSector, "rotlevel", 0);
	local sSector = DB.getValue(nodeSector, "name", "");
	if nLevel &lt;= 0 then
		ChatManager.SystemMessage(string.format(Interface.getString("rot_msg_oasis"), sSector));
		return;
	end

	-- A player applies it to their own character; the GM chooses who is in the sector
	if not Session.IsHost then
		local sIdentity = User.getCurrentIdentity();
		local nodeChar = sIdentity and DB.findNode("charsheet." .. sIdentity);
		if nodeChar then
			applyRotToCharacters(nodeSector, { nodeChar });
		end
		return;
	end

	local aOptions = {};
	for _,nodeChar in ipairs(DB.getChildList("charsheet")) do
		table.insert(aOptions, { text = DB.getValue(nodeChar, "name", ""), linkclass = "charsheet", linkrecord = DB.getPath(nodeChar), selected = true });
	end
	if #aOptions == 0 then
		return;
	end
	DialogManager.requestSelectionDialog({ title = Interface.getString("rot_title"),
			msg = string.format(Interface.getString("rot_msg_who"), sSector, getRotLevelText(nLevel)),
			options = aOptions, min = 1, max = #aOptions, callback = onSectorRotSelection, custom = { sSector = DB.getPath(nodeSector) } });
end

function onSectorRotSelection(_, tCustom, aSelectionLinks)
	local nodeSector = DB.findNode(tCustom.sSector);
	if not nodeSector then
		return;
	end
	local aChars = {};
	for _,tLink in ipairs(aSelectionLinks or {}) do
		local nodeChar = DB.findNode(tLink.linkrecord or "");
		if nodeChar then
			table.insert(aChars, nodeChar);
		end
	end
	applyRotToCharacters(nodeSector, aChars);
end

function applyRotToCharacters(nodeSector, aChars)
	if #aChars == 0 then
		return;
	end
	local aNames = {};
	for _,nodeChar in ipairs(aChars) do
		table.insert(aNames, DB.getValue(nodeChar, "name", ""));
	end
	Comm.deliverChatMessage({ font = "msgfont", text = string.format(Interface.getString("rot_msg_sector"), DB.getValue(nodeSector, "name", ""),
			DB.getValue(nodeSector, "rotlevel", 0), table.concat(aNames, ", ")) });
	for _,nodeChar in ipairs(aChars) do
		gainRot(nodeChar, 1);
	end
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>