<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>managerRolls</ScriptName>
    <FolderID>9</FolderID>
    <Script>local aAttributes = {
	STR = { field = "strength", label = "Strength", loss = "Damage" },
	AGI = { field = "agility", label = "Agility", loss = "Fatigue" },
	WIT = { field = "wits", label = "Wits", loss = "Confusion" },
	EMP = { field = "empathy", label = "Empathy", loss = "Doubt" },
};

function getAttributeCode(sField)
	for sCode, rAttribute in pairs(aAttributes) do
		if rAttribute.field == sField then
			return sCode;
		end
	end
	return "";
end

-- Remembers the inventory item whose bonus goes into the gear dice; "*" when several items are used
function addGearSource(nodeChar, nodeItem)
	if DB.getName(DB.getParent(nodeItem)) ~= "inventorylist" then
		return;
	end
	local sPath = DB.getPath(nodeItem);
	local sCurrent = DB.getValue(nodeChar, "diceInfoGearPath", "");
	if sCurrent == "" then
		DB.setValue(nodeChar, "diceInfoGearPath", "string", sPath);
	elseif sCurrent ~= sPath then
		DB.setValue(nodeChar, "diceInfoGearPath", "string", "*");
	end
end

-- Keeps the attribute and the gear item of the roll, so that pushing it can apply trauma and gear damage
function storeRollSources(nodeChar)
	DB.setValue(nodeChar, "diceAttrf", "string", DB.getValue(nodeChar, "diceInfoAttribute", ""));
	DB.setValue(nodeChar, "diceGearf", "string", DB.getValue(nodeChar, "diceInfoGearPath", ""));
	DB.setValue(nodeChar, "diceInfoAttribute", "string", "");
	DB.setValue(nodeChar, "diceInfoGearPath", "string", "");
end

-- Each 1 on a base die after pushing: 1 point of trauma to the rolled attribute and 1 mutation point (PCs)
function applyTrauma(rSource, sCreatureNode, nTrauma)
	local aResults = {};

	local rAttribute = aAttributes[DB.getValue(sCreatureNode .. ".diceAttrf", "")];
	if rAttribute then
		local sLoss = sCreatureNode .. "." .. rAttribute.field .. "_loss";
		local nLoss = DB.getValue(sLoss, 0);
		local nNewLoss = math.min(DB.getValue(sCreatureNode .. "." .. rAttribute.field, 0), nLoss + nTrauma);
		if nNewLoss &gt; nLoss then
			DB.setValue(sLoss, "number", nNewLoss);
			table.insert(aResults, rAttribute.label .. " -" .. (nNewLoss - nLoss) .. " (" .. rAttribute.loss .. ")");
		end
	end

	if ActorManager.isPC(rSource) then
		local nMP = DB.getValue(sCreatureNode .. ".mutationpoints", 0);
		local nNewMP = math.min(DB.getValue(sCreatureNode .. ".mutationpoints_max", 10), nMP + nTrauma);
		if nNewMP &gt; nMP then
			DB.setValue(sCreatureNode .. ".mutationpoints", "number", nNewMP);
			table.insert(aResults, "MP +" .. (nNewMP - nMP));
		end
	end

	if #aResults == 0 then
		return "";
	end
	return " [" .. table.concat(aResults, ", ") .. "]";
end

-- Each 1 on a gear die after pushing lowers the bonus of the item by 1, when the roll used a single item
function applyGearBreak(sCreatureNode, nBreak)
	local sItem = DB.getValue(sCreatureNode .. ".diceGearf", "");
	if sItem == "" or sItem == "*" or not DB.findNode(sItem) then
		return "";
	end
	local nBonus = DB.getValue(sItem .. ".bonus", 0);
	local nNewBonus = math.max(0, nBonus - nBreak);
	DB.setValue(sItem .. ".bonus", "number", nNewBonus);
	return " [" .. DB.getValue(sItem .. ".name", "") .. " bonus " .. nBonus .. " -&gt; " .. nNewBonus .. "]";
end

function challenge(rSource, rTarget, rRoll)

--  Name the function and accept 3 parameters

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	--  Create a message from the rSource and rRoll parameters using CoreRPGs createActionMessage function
	local nSuccess = 0;
	
	local nodeChar = rSource.sCreatureNode;
	--  Capture the Character Node
--	local sIcon;
--	if rSource.sType == "npc" then
--		sIcon = "portrait_gm_token";
--	else
--		sIcon = DB.getValue(nodeChar .. ".token");
--		if sIcon then
--			sIcon = string.gsub(sIcon, "token", "chat");
--		end;
--	end
--	 
	 
	local msg = {font = "msgfont"};
	local aAddIcons = {};
--	rMessage.icon = sIcon;

	for k, v in ipairs(rRoll.aDice) do
--		Debug.chat(k, v, rRoll.aDice[k]);
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 6 then
				table.insert(aAddIcons, "chat_success");
				DB.setValue(nodeChar .. ".dbases", "number", DB.getValue(nodeChar .. ".dbases")+1);
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				DB.setValue(nodeChar .. ".dbasef", "number", DB.getValue(nodeChar .. ".dbasef")+1);
			else
				local dbaser = DB.getValue(nodeChar .. ".dbaser")+1;
				DB.setValue(nodeChar .. ".dbaser", "number", DB.getValue(nodeChar .. ".dbaser")+1);
			end
		elseif rRoll.aDice[k].type == "dskill" then
			if rRoll.aDice[k].value == 6 then
				table.insert(aAddIcons, "chat_success");
				DB.setValue(nodeChar .. ".dskills", "number", DB.getValue(nodeChar .. ".dskills")+1);
				nSuccess = nSuccess+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dskillr")+1;
				DB.setValue(nodeChar .. ".dskillr", "number", DB.getValue(nodeChar .. ".dskillr")+1);
			end
		elseif rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 6 then
				table.insert(aAddIcons, "chat_success");
				DB.setValue(nodeChar .. ".dgears", "number", DB.getValue(nodeChar .. ".dgears")+1);
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				DB.setValue(nodeChar .. ".dgearf", "number", DB.getValue(nodeChar .. ".dgearf")+1);
			else
				local dbaser = DB.getValue(nodeChar .. ".dgearr")+1;
				DB.setValue(nodeChar .. ".dgearr", "number", DB.getValue(nodeChar .. ".dgearr")+1);
			end
		end
	end
	
	if #aAddIcons &gt; 0 then
		rMessage.icon = { rMessage.icon };
		for _,v in ipairs(aAddIcons) do
			table.insert (rMessage.icon, tostring(v));
		end
	end
	      	      
	if nSuccess &gt; 0 then
		rMessage.text = rMessage.text .. " [SUCCESS (" .. nSuccess .. ")]";
	else
		rMessage.text = rMessage.text .. " [FAIL]";
	end

    rMessage.dicedisplay = 0;
    rMessage.diceskipexpr = true;
    	 	 
	Comm.deliverChatMessage(rMessage); 
	 return true
end

function push(rSource, rTarget, rRoll)

--  Name the function and accept 3 parameters

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	--  Create a message from the rSource and rRoll parameters using CoreRPGs createActionMessage function
	
	local nodeChar = rSource.sCreatureNode;
	--  Capture the Character Node
--	local sIcon;
--	if rSource.sType == "npc" then
--		sIcon = "portrait_gm_token";
--	else
--		sIcon = DB.getValue(nodeChar .. ".token");
--		sIcon = string.gsub(sIcon, "token", "chat");
--	end
	 
	local nSuccess = DB.getValue(nodeChar .. ".dbases")+DB.getValue(nodeChar .. ".dskills")+DB.getValue(nodeChar .. ".dgears");
	local nMutant = DB.getValue(nodeChar .. ".dbasef");
	local nBreak = DB.getValue(nodeChar .. ".dgearf");
		
 	DB.setValue(nodeChar .. ".dbases", "number", 0);	
	DB.setValue(nodeChar .. ".dskills", "number", 0);	
	DB.setValue(nodeChar .. ".dgears", "number", 0);	
	
	local msg = {font = "msgfont"};
	local aAddIcons = {};
--	rMessage.icon = sIcon;

	nFirstSuccess = nSuccess;
	
	while nFirstSuccess &gt; 0 do
		table.insert(aAddIcons, "chat_success");
		nFirstSuccess = nFirstSuccess-1;
	end
	
	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 6 then
				table.insert(aAddIcons, "chat_pushsuccess");
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				nMutant = nMutant+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dbaser")+1;
			end
		elseif rRoll.aDice[k].type == "dskill" then
			if rRoll.aDice[k].value == 6 then
				table.insert(aAddIcons, "chat_pushsuccess");
				nSuccess = nSuccess+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dskillr")+1;
			end
		elseif rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 6 then
				table.insert(aAddIcons, "chat_pushsuccess");
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				nBreak = nBreak+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dgearr")+1;
			end
		end
	end
 
	if nSuccess &gt; 0 then
		rMessage.text = rMessage.text .. " [PUSH] [SUCCESS (" .. nSuccess .. ")]";
	else
		rMessage.text = rMessage.text .. " [PUSH] [FAIL]";
	end

	if nMutant &gt; 0 then 
		rMessage.text = rMessage.text .. " Trauma and Mutation (" .. nMutant .. ")";
		rMessage.text = rMessage.text .. applyTrauma(rSource, nodeChar, nMutant);
	end
	
	if nBreak &gt; 0 then 
		rMessage.text = rMessage.text .. " Gear Break (" .. nBreak .. ")";
		rMessage.text = rMessage.text .. applyGearBreak(nodeChar, nBreak);
	end

	DB.setValue(nodeChar .. ".diceAttrf", "string", "");
	DB.setValue(nodeChar .. ".diceGearf", "string", "");

  	while nMutant &gt; 0 do
		table.insert(aAddIcons, "chat_mutant");
		nMutant = nMutant-1;
	end
	
	while nBreak &gt; 0 do
		table.insert(aAddIcons, "chat_break");
		nBreak = nBreak-1;
	end

    rMessage.dicedisplay = 0;
    rMessage.diceskipexpr = true;

  	DB.setValue(nodeChar .. ".dbasef", "number", 0);	
	DB.setValue(nodeChar .. ".dgearf", "number", 0);	
	
	if #aAddIcons &gt; 0 then
		rMessage.icon = { rMessage.icon };
		for _,v in ipairs(aAddIcons) do
			table.insert (rMessage.icon, tostring(v));
		end
	end
 
  	DB.setValue(nodeChar, "dbasef", "number", 0);	
	DB.setValue(nodeChar, "dgearf", "number", 0);	
    
	Comm.deliverChatMessage(rMessage); 
	return true
end


function initiative(rSource, rTarget, rRoll)

	local nodeChar = rSource.sCreatureNode;
	DB.setValue(nodeChar .. '.initresult', "number", rRoll.nTotal + rRoll.nMod);

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = "Initiative";
    Comm.deliverChatMessage(rMessage);
	
end

function backfire(rSource, rTarget, rRoll)

	local backfire = false;
	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 1 then
				backfire = true;
			end;
		end;
	end;

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if backfire then
		rMessage.text = rMessage.text .. " [BACKFIRE]";
	else
		rMessage.text = rMessage.text .. " [SUCCESS]";
	end;
	Comm.deliverChatMessage(rMessage); 
	return true;

end

function armor(rSource, rTarget, rRoll)

	local nArmor = 0;
	local nDamage = 0;

	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 1 then
				nDamage = nDamage + 1; 
			end;
			if rRoll.aDice[k].value == 6 then
				nArmor = nArmor + 1;
			end;
		end;
	end;

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = rMessage.text .. " [Damage Reduction (" .. nArmor .. ")]";
	if nDamage &gt; 0 then
		rMessage.text = rMessage.text .. " [Armor Break (" .. nDamage .. ")]";
	end;
	Comm.deliverChatMessage(rMessage); 
	return true;

end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>