<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>managerRolls</ScriptName>
    <FolderID>9</FolderID>
    <Script>local aAttributes = {
	STR = { field = "strength", label = "Strength", loss = "Damage" },
	AGI = { field = "agility", label = "Agility", loss = "Fatigue" },
	WIT = { field = "wits", label = "Wits", loss = "Confusion" },
	EMP = { field = "empathy", label = "Empathy", loss = "Doubt" },
};

function getAttributeCode(sField)
	for sCode, rAttribute in pairs(aAttributes) do
		if rAttribute.field == sField then
			return sCode;
		end
	end
	return "";
end

-- Remembers the item whose bonus goes into the gear dice ("*" when several items are used),
-- and the weapon, whose damage is used when the roll succeeds
function addGearSource(nodeChar, nodeItem)
	local sList = DB.getName(DB.getParent(nodeItem));
	if sList ~= "inventorylist" and sList ~= "gearlist" then
		return;
	end
	local sPath = DB.getPath(nodeItem);
	local sCurrent = DB.getValue(nodeChar, "diceInfoGearPath", "");
	if sCurrent == "" then
		DB.setValue(nodeChar, "diceInfoGearPath", "string", sPath);
	elseif sCurrent ~= sPath then
		DB.setValue(nodeChar, "diceInfoGearPath", "string", "*");
	end
	if DB.getValue(nodeItem, "damage", 0) &gt; 0 then
		DB.setValue(nodeChar, "diceInfoWeaponPath", "string", sPath);
	end
end

-- Keeps the attribute, skill, gear item and weapon of the roll, for the result and for pushing it
function storeRollSources(nodeChar)
	DB.setValue(nodeChar, "diceAttrf", "string", DB.getValue(nodeChar, "diceInfoAttribute", ""));
	DB.setValue(nodeChar, "diceSkillf", "string", DB.getValue(nodeChar, "diceInfoSkill", ""));
	DB.setValue(nodeChar, "diceGearf", "string", DB.getValue(nodeChar, "diceInfoGearPath", ""));
	DB.setValue(nodeChar, "diceWeaponf", "string", DB.getValue(nodeChar, "diceInfoWeaponPath", ""));
	DB.setValue(nodeChar, "diceInfoAttribute", "string", "");
	DB.setValue(nodeChar, "diceInfoGearPath", "string", "");
	DB.setValue(nodeChar, "diceInfoWeaponPath", "string", "");
end

-- Skill dice of the pool: below 0 they are negative dice, whose 6s cancel successes
function getSkillDice(nSkill)
	if nSkill &gt; 0 then
		return nSkill .. "dskill+";
	elseif nSkill &lt; 0 then
		return (-nSkill) .. "dneg+";
	end
	return "";
end

function getNegativeText(nCancel)
	if nCancel &lt;= 0 then
		return "";
	end
	return " [NEGATIVE (" .. nCancel .. ")]";
end

-- A successful roll with a weapon deals its damage plus 1 per extra success, ready in the Damage counter
function setWeaponDamage(sCreatureNode, nSuccess)
	local sWeapon = DB.getValue(sCreatureNode .. ".diceWeaponf", "");
	if nSuccess &lt;= 0 or sWeapon == "" or not DB.findNode(sWeapon) then
		return "";
	end
	local nDamage = DB.getValue(sWeapon .. ".damage", 0) + nSuccess - 1;
	DB.setValue(sCreatureNode .. ".ddamage", "number", nDamage);
	return " [Damage " .. nDamage .. "]";
end

function isHealRoll(sCreatureNode)
	return DB.getValue(sCreatureNode .. ".diceSkillf", ""):lower() == "heal";
end

-- Text for a Heal roll without targets to heal
function getHealText(rSource, sCreatureNode, nPoints)
	if nPoints &lt;= 0 or not isHealRoll(sCreatureNode) then
		return "";
	end
	if #TargetingManager.getFullTargets(rSource) == 0 then
		return " [Heal: target the patient to heal them]";
	end
	return "";
end

-- Each success of a Heal roll gives back 1 point to each target of the healer
function healTargets(rSource, sCreatureNode, nPoints)
	if nPoints &lt;= 0 or not isHealRoll(sCreatureNode) then
		return;
	end
	local sHealer = ActorManager.getDisplayName(rSource);
	for _,rTarget in ipairs(TargetingManager.getFullTargets(rSource)) do
		managerDamage.notifyHeal(rTarget, nPoints, sHealer);
	end
end

-- Takes points of an attribute (up to its value) and describes it; the host keeps the Broken effect in step
function applyAttributeLoss(sCreatureNode, rAttribute, nPoints)
	local nAttribute = DB.getValue(sCreatureNode .. "." .. rAttribute.field, 0);
	local sLoss = sCreatureNode .. "." .. rAttribute.field .. "_loss";
	local nLoss = DB.getValue(sLoss, 0);
	local nNewLoss = math.min(nAttribute, nLoss + nPoints);
	if nNewLoss &lt;= nLoss then
		return nil;
	end
	DB.setValue(sLoss, "number", nNewLoss);
	local sResult = rAttribute.label .. " -" .. (nNewLoss - nLoss) .. " (" .. rAttribute.loss .. ")";
	if nNewLoss &gt;= nAttribute then
		sResult = sResult .. " BROKEN";
	end
	return sResult;
end

-- Each 1 on a base die after pushing: 1 point of trauma to the rolled attribute and 1 mutation point (PCs)
function applyTrauma(rSource, sCreatureNode, nTrauma)
	local aResults = {};

	local rAttribute = aAttributes[DB.getValue(sCreatureNode .. ".diceAttrf", "")];
	if rAttribute then
		local sResult = applyAttributeLoss(sCreatureNode, rAttribute, nTrauma);
		if sResult then
			table.insert(aResults, sResult);
		end
	end

	if ActorManager.isPC(rSource) then
		local nMP = DB.getValue(sCreatureNode .. ".mutationpoints", 0);
		local nNewMP = math.min(DB.getValue(sCreatureNode .. ".mutationpoints_max", 10), nMP + nTrauma);
		if nNewMP &gt; nMP then
			DB.setValue(sCreatureNode .. ".mutationpoints", "number", nNewMP);
			table.insert(aResults, "MP +" .. (nNewMP - nMP));
		end
	end

	if #aResults == 0 then
		return "";
	end
	return " [" .. table.concat(aResults, ", ") .. "]";
end

-- Each 1 on a gear die after pushing lowers the bonus of the item by 1, when the roll used a single item
function applyGearBreak(sCreatureNode, nBreak)
	local sItem = DB.getValue(sCreatureNode .. ".diceGearf", "");
	if sItem == "" or sItem == "*" or not DB.findNode(sItem) then
		return "";
	end
	local nBonus = DB.getValue(sItem .. ".bonus", 0);
	local nNewBonus = math.max(0, nBonus - nBreak);
	DB.setValue(sItem .. ".bonus", "number", nNewBonus);
	return " [" .. DB.getValue(sItem .. ".name", "") .. " bonus " .. nBonus .. " -&gt; " .. nNewBonus .. "]";
end

-- Each 1 when using a mutation: 1 point of damage (physical mutation) or confusion (mental mutation)
function applyMisfire(sCreatureNode, nMisfire)
	local sMutation = DB.getValue(sCreatureNode .. ".diceMutationf", "");
	local rAttribute = aAttributes.STR;
	if sMutation ~= "" and DB.getValue(sMutation .. ".mutationtype", "") == "mental" then
		rAttribute = aAttributes.WIT;
	end
	local sResult = applyAttributeLoss(sCreatureNode, rAttribute, nMisfire);
	if not sResult then
		return "";
	end
	return " [" .. sResult .. "]";
end

function challenge(rSource, rTarget, rRoll)

--  Name the function and accept 3 parameters

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	--  Create a message from the rSource and rRoll parameters using CoreRPGs createActionMessage function
	local nSuccess = 0;
	local nCancel = 0;
	
	local nodeChar = rSource.sCreatureNode;
	--  Capture the Character Node
--	local sIcon;
--	if rSource.sType == "npc" then
--		sIcon = "portrait_gm_token";
--	else
--		sIcon = DB.getValue(nodeChar .. ".token");
--		if sIcon then
--			sIcon = string.gsub(sIcon, "token", "chat");
--		end;
--	end
--	 
	 
	local msg = {font = "msgfont"};
	local aAddIcons = {};
--	rMessage.icon = sIcon;

	for k, v in ipairs(rRoll.aDice) do
--		Debug.chat(k, v, rRoll.aDice[k]);
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 6 then
				DB.setValue(nodeChar .. ".dbases", "number", DB.getValue(nodeChar .. ".dbases")+1);
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				DB.setValue(nodeChar .. ".dbasef", "number", DB.getValue(nodeChar .. ".dbasef")+1);
			else
				local dbaser = DB.getValue(nodeChar .. ".dbaser")+1;
				DB.setValue(nodeChar .. ".dbaser", "number", DB.getValue(nodeChar .. ".dbaser")+1);
			end
		elseif rRoll.aDice[k].type == "dskill" then
			if rRoll.aDice[k].value == 6 then
				DB.setValue(nodeChar .. ".dskills", "number", DB.getValue(nodeChar .. ".dskills")+1);
				nSuccess = nSuccess+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dskillr")+1;
				DB.setValue(nodeChar .. ".dskillr", "number", DB.getValue(nodeChar .. ".dskillr")+1);
			end
		elseif rRoll.aDice[k].type == "dneg" then
			if rRoll.aDice[k].value == 6 then
				DB.setValue(nodeChar .. ".dnegs", "number", DB.getValue(nodeChar .. ".dnegs", 0)+1);
				nCancel = nCancel+1;
			else
				DB.setValue(nodeChar .. ".dnegr", "number", DB.getValue(nodeChar .. ".dnegr", 0)+1);
			end
		elseif rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 6 then
				DB.setValue(nodeChar .. ".dgears", "number", DB.getValue(nodeChar .. ".dgears")+1);
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				DB.setValue(nodeChar .. ".dgearf", "number", DB.getValue(nodeChar .. ".dgearf")+1);
			else
				local dbaser = DB.getValue(nodeChar .. ".dgearr")+1;
				DB.setValue(nodeChar .. ".dgearr", "number", DB.getValue(nodeChar .. ".dgearr")+1);
			end
		end
	end

	nSuccess = math.max(0, nSuccess - nCancel);
	for i = 1, nSuccess do
		table.insert(aAddIcons, "chat_success");
	end
	
	if #aAddIcons &gt; 0 then
		rMessage.icon = { rMessage.icon };
		for _,v in ipairs(aAddIcons) do
			table.insert (rMessage.icon, tostring(v));
		end
	end
	      	      
	rMessage.text = rMessage.text .. getNegativeText(nCancel);
	if nSuccess &gt; 0 then
		rMessage.text = rMessage.text .. " [SUCCESS (" .. nSuccess .. ")]";
		rMessage.text = rMessage.text .. setWeaponDamage(nodeChar, nSuccess);
		rMessage.text = rMessage.text .. getHealText(rSource, nodeChar, nSuccess);
	else
		rMessage.text = rMessage.text .. " [FAIL]";
	end

    rMessage.dicedisplay = 0;
    rMessage.diceskipexpr = true;
    	 	 
	Comm.deliverChatMessage(rMessage); 

	healTargets(rSource, nodeChar, nSuccess);
	 return true
end

function push(rSource, rTarget, rRoll)

--  Name the function and accept 3 parameters

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	--  Create a message from the rSource and rRoll parameters using CoreRPGs createActionMessage function
	
	local nodeChar = rSource.sCreatureNode;
	--  Capture the Character Node
--	local sIcon;
--	if rSource.sType == "npc" then
--		sIcon = "portrait_gm_token";
--	else
--		sIcon = DB.getValue(nodeChar .. ".token");
--		sIcon = string.gsub(sIcon, "token", "chat");
--	end
	 
	local nSuccess = DB.getValue(nodeChar .. ".dbases")+DB.getValue(nodeChar .. ".dskills")+DB.getValue(nodeChar .. ".dgears");
	-- The 6s of the negative dice in the first roll keep cancelling successes
	local nCancel = DB.getValue(nodeChar .. ".dnegs", 0);
	local nPreviousSuccess = math.max(0, nSuccess - nCancel);
	local nMutant = DB.getValue(nodeChar .. ".dbasef");
	local nBreak = DB.getValue(nodeChar .. ".dgearf");
		
 	DB.setValue(nodeChar .. ".dbases", "number", 0);	
	DB.setValue(nodeChar .. ".dskills", "number", 0);	
	DB.setValue(nodeChar .. ".dgears", "number", 0);	
	DB.setValue(nodeChar .. ".dnegs", "number", 0);	
	
	local msg = {font = "msgfont"};
	local aAddIcons = {};
--	rMessage.icon = sIcon;

	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 6 then
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				nMutant = nMutant+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dbaser")+1;
			end
		elseif rRoll.aDice[k].type == "dskill" then
			if rRoll.aDice[k].value == 6 then
				nSuccess = nSuccess+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dskillr")+1;
			end
		elseif rRoll.aDice[k].type == "dneg" then
			if rRoll.aDice[k].value == 6 then
				nCancel = nCancel+1;
			end
		elseif rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 6 then
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				nBreak = nBreak+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dgearr")+1;
			end
		end
	end

	nSuccess = math.max(0, nSuccess - nCancel);
	local nKept = math.min(nPreviousSuccess, nSuccess);
	for i = 1, nKept do
		table.insert(aAddIcons, "chat_success");
	end
	for i = nKept + 1, nSuccess do
		table.insert(aAddIcons, "chat_pushsuccess");
	end

	-- Healing from the first roll is already applied; only the new successes heal now
	local nNewSuccess = nSuccess - nPreviousSuccess;
 
	rMessage.text = rMessage.text .. " [PUSH]" .. getNegativeText(nCancel);
	if nSuccess &gt; 0 then
		rMessage.text = rMessage.text .. " [SUCCESS (" .. nSuccess .. ")]";
		rMessage.text = rMessage.text .. setWeaponDamage(nodeChar, nSuccess);
		rMessage.text = rMessage.text .. getHealText(rSource, nodeChar, nNewSuccess);
	else
		rMessage.text = rMessage.text .. " [FAIL]";
	end

	if nMutant &gt; 0 then 
		rMessage.text = rMessage.text .. " Trauma and Mutation (" .. nMutant .. ")";
		rMessage.text = rMessage.text .. applyTrauma(rSource, nodeChar, nMutant);
	end
	
	if nBreak &gt; 0 then 
		rMessage.text = rMessage.text .. " Gear Break (" .. nBreak .. ")";
		rMessage.text = rMessage.text .. applyGearBreak(nodeChar, nBreak);
	end

	DB.setValue(nodeChar .. ".diceAttrf", "string", "");
	DB.setValue(nodeChar .. ".diceGearf", "string", "");

  	while nMutant &gt; 0 do
		table.insert(aAddIcons, "chat_mutant");
		nMutant = nMutant-1;
	end
	
	while nBreak &gt; 0 do
		table.insert(aAddIcons, "chat_break");
		nBreak = nBreak-1;
	end

    rMessage.dicedisplay = 0;
    rMessage.diceskipexpr = true;

  	DB.setValue(nodeChar .. ".dbasef", "number", 0);	
	DB.setValue(nodeChar .. ".dgearf", "number", 0);	
	
	if #aAddIcons &gt; 0 then
		rMessage.icon = { rMessage.icon };
		for _,v in ipairs(aAddIcons) do
			table.insert (rMessage.icon, tostring(v));
		end
	end
 
  	DB.setValue(nodeChar, "dbasef", "number", 0);	
	DB.setValue(nodeChar, "dgearf", "number", 0);	
    
	Comm.deliverChatMessage(rMessage); 

	healTargets(rSource, nodeChar, nNewSuccess);
	return true
end


function initiative(rSource, rTarget, rRoll)

	local nodeChar = rSource.sCreatureNode;
	DB.setValue(nodeChar .. '.initresult', "number", rRoll.nTotal + rRoll.nMod);

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = "Initiative";
    Comm.deliverChatMessage(rMessage);
	
end

-- Using a mutation: the mutation points were spent before rolling; each 1 is a misfire
function backfire(rSource, rTarget, rRoll)

	local nMisfire = 0;
	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 1 then
				nMisfire = nMisfire + 1;
			end;
		end;
	end;

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nMisfire &gt; 0 then
		rMessage.text = rMessage.text .. " [BACKFIRE (" .. nMisfire .. ")]";
		rMessage.text = rMessage.text .. applyMisfire(rSource.sCreatureNode, nMisfire);
	else
		rMessage.text = rMessage.text .. " [SUCCESS]";
	end;
	DB.setValue(rSource.sCreatureNode .. ".diceMutationf", "string", "");
	Comm.deliverChatMessage(rMessage); 
	return true;

end

-- Armor roll of a PC: each 6 stops 1 point of the pending damage, each 1 lowers the armor by 1
function armor(rSource, rTarget, rRoll)

	local nArmor = 0;
	local nDamage = 0;

	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 1 then
				nDamage = nDamage + 1; 
			end;
			if rRoll.aDice[k].value == 6 then
				nArmor = nArmor + 1;
			end;
		end;
	end;

	local nodeChar = DB.findNode(rSource.sCreatureNode);
	local nPending = DB.getValue(nodeChar, "pendingdamage", 0);

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = rMessage.text .. " [Damage Reduction (" .. nArmor .. ")]";
	if nDamage &gt; 0 then
		rMessage.text = rMessage.text .. " [Armor Break (" .. nDamage .. ")]";
		rMessage.text = rMessage.text .. managerDamage.degradeArmor(DB.getValue(nodeChar, "diceArmorf", ""), nDamage);
	end;
	if nPending &gt; 0 then
		rMessage.text = rMessage.text .. " [Pending damage " .. nPending .. " -&gt; " .. math.max(0, nPending - nArmor) .. "]";
	end
	Comm.deliverChatMessage(rMessage); 

	if nPending &gt; 0 then
		managerDamage.takePendingDamage(nodeChar, nArmor);
	end
	return true;

end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>