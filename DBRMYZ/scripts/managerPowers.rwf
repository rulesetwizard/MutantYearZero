<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>managerPowers</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Using mutations and animal powers: the points are spent before rolling a base die per point. Each 1 is a
-- misfire for a mutant (managerRolls.backfire); for an animal, one or more 1s are a wild effect (a base die on
-- the table below). In Genlab Alpha the NPCs share a pool of wild points of the GM, kept in the combat tracker.
-- Humans (Elysium) have implants instead, whose bonus is used as gear dice and can bring the mechanical fever,
-- and they activate their contacts with influence points.

POOL_PATH = "combattracker.wildpool";

-- An animal never has more than four abilities (animal powers, and the mutations of the stained)
MAX_ANIMAL_ABILITIES = 4;

-- Wild effects of Genlab Alpha, by the base die rolled: the string resources powers_wild_1 to powers_wild_6
-- Negative reactions of contacts (Elysium), by the base die rolled: the string resources powers_reaction_1 to
-- powers_reaction_6

function onInit()
	GameManager.addAction("myz_wild", { });
	ActionsManager.registerResultHandler("myz_wild", onWildResult);
	GameManager.addAction("myz_contact", { });
	ActionsManager.registerResultHandler("myz_contact", onContactResult);
	GameManager.addAction("myz_reaction", { });
	ActionsManager.registerResultHandler("myz_reaction", onReactionResult);

	if Session.IsHost then
		DB.addHandler("charsheet.*.mutationlist", "onChildAdded", onAbilityAdded);
	end
end

-- An ability added to an animal that already has four is taken away again (also those added by players, as the
-- host sees every new entry)
function onAbilityAdded(nodeList, nodeAbility)
	local nodeChar = DB.getParent(nodeList);
	if managerGame.getCharType(nodeChar) ~= "animal" or DB.getChildCount(nodeList) &lt;= MAX_ANIMAL_ABILITIES then
		return;
	end
	DB.deleteNode(nodeAbility);
	Comm.deliverChatMessage({ font = "msgfont", text = string.format(Interface.getString("powers_msg_max_abilities"), DB.getValue(nodeChar, "name", ""), MAX_ANIMAL_ABILITIES) });
end

-- Spends the points to use a power; false (with a message) when the character cannot
function spendPoints(nodeChar, nodePower, nSpend)
	if nSpend &lt;= 0 then
		return false;
	end
	local rType = managerGame.getCharTypeData(nodeChar);
	if not rType.pointsShort then
		ChatManager.SystemMessage(string.format(Interface.getString("powers_msg_no_points"), DB.getValue(nodeChar, "name", "")));
		return false;
	end
	local nPoints = DB.getValue(nodeChar, "mutationpoints", 0);
	if nPoints &lt; nSpend then
		ChatManager.SystemMessage(string.format(Interface.getString("powers_msg_not_enough"), DB.getValue(nodeChar, "name", ""), nPoints, rType.pointsShort, nSpend));
		return false;
	end
	DB.setValue(nodeChar, "mutationpoints", "number", nPoints - nSpend);
	DB.setValue(nodeChar, "diceMutationf", "string", DB.getPath(nodePower));
	DB.setValue(nodeChar, "diceMutationSpent", "number", nSpend);
	return true;
end

function onPowerResult(rSource, rTarget, rRoll)
	local sChar = rSource.sCreatureNode;
	if managerGame.getCharType(sChar) ~= "animal" then
		return managerRolls.backfire(rSource, rTarget, rRoll);
	end

	local nOnes = 0;
	for _,rDie in ipairs(rRoll.aDice) do
		if rDie.type == "dbase" and rDie.value == 1 then
			nOnes = nOnes + 1;
		end
	end
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nOnes &gt; 0 then
		rMessage.text = rMessage.text .. " " .. Interface.getString("powers_tag_wild");
	else
		rMessage.text = rMessage.text .. " " .. Interface.getString("roll_tag_success");
	end
	Comm.deliverChatMessage(rMessage);
	DB.setValue(sChar .. ".diceMutationf", "string", "");

	if nOnes &gt; 0 then
		RulesetWizardDiceRoller.Roll(nil, DB.findNode(sChar), "myz_wild", Interface.getString("powers_desc_wild"), "1dbase", 0,
				{ sChar = sChar, nSpent = DB.getValue(sChar .. ".diceMutationSpent", 0) });
	end
	return true;
end

-- 5 takes all the wild points, 6 gives back the points spent
function onWildResult(rSource, rTarget, rRoll)
	local nResult = (rRoll.aDice[1] and rRoll.aDice[1].value) or 1;
	local sChar = rRoll.sChar or rSource.sCreatureNode;
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = rMessage.text .. " [" .. Interface.getString("powers_wild_" .. nResult) .. "]";

	local sPoints = Interface.getString("chartype_animal_pointsshort");
	local nPoints = DB.getValue(sChar .. ".mutationpoints", 0);
	if nResult == 5 and nPoints &gt; 0 then
		DB.setValue(sChar .. ".mutationpoints", "number", 0);
		rMessage.text = rMessage.text .. " [" .. sPoints .. " " .. nPoints .. " -&gt; 0]";
	elseif nResult == 6 then
		local nNewPoints = math.min(DB.getValue(sChar .. ".mutationpoints_max", 10), nPoints + (tonumber(rRoll.nSpent) or 0));
		DB.setValue(sChar .. ".mutationpoints", "number", nNewPoints);
		rMessage.text = rMessage.text .. " [" .. sPoints .. " " .. nPoints .. " -&gt; " .. nNewPoints .. "]";
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

--
-- Start of a session (Genlab Alpha): each animal PC gains as many wild points as animal powers it has, keeping
-- the unspent ones (10 at most); then the pool of the GM, which is not kept between sessions, is the total of the
-- points of the players. The pool grows when NPCs push their rolls
--

function startSession()
	if not managerGame.usesGMPool() then
		ChatManager.SystemMessage(Interface.getString("powers_msg_session_notgenlab"));
		return;
	end
	local nTotal = 0;
	for _,nodeChar in ipairs(DB.getChildList("charsheet")) do
		if managerGame.getCharType(nodeChar) == "animal" then
			local nPowers = DB.getChildCount(nodeChar, "mutationlist");
			local nPoints = DB.getValue(nodeChar, "mutationpoints", 0);
			local nNewPoints = math.min(DB.getValue(nodeChar, "mutationpoints_max", 10), nPoints + nPowers);
			DB.setValue(nodeChar, "mutationpoints", "number", nNewPoints);
			Comm.deliverChatMessage({ font = "msgfont", text = string.format(Interface.getString("powers_msg_session_gain"),
					DB.getValue(nodeChar, "name", ""), nNewPoints - nPoints, nPowers, nPoints, nNewPoints) });
		end
		if managerGame.getCharTypeData(nodeChar).pointsShort then
			nTotal = nTotal + DB.getValue(nodeChar, "mutationpoints", 0);
		end
	end
	DB.setValue(POOL_PATH, "number", nTotal);
	ChatManager.SystemMessage(string.format(Interface.getString("powers_msg_session_gm"), nTotal));
end

-- Points of a pushed NPC roll go to the pool; returns the text for the roll message
function addToGMPool(nPoints)
	if not managerGame.usesGMPool() or nPoints &lt;= 0 or not Session.IsHost then
		return nil;
	end
	local nPool = DB.getValue(POOL_PATH, 0) + nPoints;
	DB.setValue(POOL_PATH, "number", nPool);
	return string.format(Interface.getString("powers_text_gm_pool"), nPoints);
end

--
-- Contacts (Elysium): activating a contact spends influence points and rolls a base die per point; any 1 is a
-- negative reaction, rolled on the table above
--

function activateContact(nodeContact)
	local nodeChar = DB.getChild(nodeContact, "...");
	local sChar = DB.getValue(nodeChar, "name", "");
	local nSpend = DB.getValue(nodeContact, "influence", 0);
	if nSpend &lt;= 0 then
		ChatManager.SystemMessage(Interface.getString("powers_msg_contact_noinfluence"));
		return;
	end
	local sPoints = Interface.getString("chartype_human_spendshort");
	local nPoints = DB.getValue(nodeChar, "mutationpoints", 0);
	if nPoints &lt; nSpend then
		ChatManager.SystemMessage(string.format(Interface.getString("powers_msg_not_enough"), sChar, nPoints, sPoints, nSpend));
		return;
	end
	DB.setValue(nodeChar, "mutationpoints", "number", nPoints - nSpend);
	local sDesc = string.format(Interface.getString("powers_desc_contact"), DB.getValue(nodeContact, "name", ""), nSpend, sPoints);
	RulesetWizardDiceRoller.Roll(nil, nodeChar, "myz_contact", sDesc, nSpend .. "dbase", 0, { sChar = DB.getPath(nodeChar) });
end

function onContactResult(rSource, rTarget, rRoll)
	local nOnes = 0;
	for _,rDie in ipairs(rRoll.aDice) do
		if rDie.value == 1 then
			nOnes = nOnes + 1;
		end
	end
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nOnes &gt; 0 then
		rMessage.text = rMessage.text .. " " .. Interface.getString("powers_tag_negative_reaction");
	else
		rMessage.text = rMessage.text .. " " .. Interface.getString("powers_tag_contact_helps");
	end
	Comm.deliverChatMessage(rMessage);
	if nOnes &gt; 0 then
		RulesetWizardDiceRoller.Roll(nil, DB.findNode(rRoll.sChar or rSource.sCreatureNode), "myz_reaction", Interface.getString("powers_desc_reaction"), "1dbase", 0, {});
	end
	return true;
end

function onReactionResult(rSource, rTarget, rRoll)
	local nResult = (rRoll.aDice[1] and rRoll.aDice[1].value) or 1;
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = rMessage.text .. " [" .. Interface.getString("powers_reaction_" .. nResult) .. "]";
	Comm.deliverChatMessage(rMessage);
	return true;
end

--
-- Implants (Elysium): their bonus is used as gear dice; pushing with 1s on them lowers the bonus and brings the
-- mechanical fever (1: a point of fatigue; 2: broken by fatigue; 3 or more: psychosis and Empathy -1 for good)
--

function useImplant(nodeChar, nodeImplant)
	local nBonus = DB.getValue(nodeImplant, "score", 0);
	if nBonus &lt;= 0 then
		ChatManager.SystemMessage(Interface.getString("powers_msg_implant_nobonus"));
		return;
	end
	DB.setValue(nodeChar, "dgear", "number", DB.getValue(nodeChar, "dgear", 0) + nBonus);
	local sPath = DB.getPath(nodeImplant);
	local sCurrent = DB.getValue(nodeChar, "diceInfoGearPath", "");
	if sCurrent == "" then
		DB.setValue(nodeChar, "diceInfoGearPath", "string", sPath);
	elseif sCurrent ~= sPath then
		DB.setValue(nodeChar, "diceInfoGearPath", "string", "*");
	end
	DB.setValue(nodeChar, "diceInfoGear", "string", DB.getValue(nodeImplant, "name", ""));
end

function isImplant(sItem)
	return DB.getName(DB.getParent(DB.findNode(sItem))) == "mutationlist";
end

-- Returns the text for the push message
function applyFever(sCreatureNode, nOnes)
	local nodeChar = DB.findNode(sCreatureNode);
	if nOnes == 1 then
		local sResult = managerRolls.applyAttributeLoss(sCreatureNode, managerGame.getAttribute(nodeChar, "AGI"), 1);
		return " [" .. Interface.getString("powers_text_fever_1") .. (sResult and (", " .. sResult) or "") .. "]";
	elseif nOnes == 2 then
		local nAgility = DB.getValue(nodeChar, "agility", 0);
		DB.setValue(nodeChar, "agility_loss", "number", nAgility);
		return " [" .. Interface.getString("powers_text_fever_2") .. "]";
	end
	local nEmpathy = DB.getValue(nodeChar, "empathy", 0);
	DB.setValue(nodeChar, "empathy", "number", math.max(0, nEmpathy - 1));
	return " [" .. string.format(Interface.getString("powers_text_psychosis"), nEmpathy, math.max(0, nEmpathy - 1)) .. "]";
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>