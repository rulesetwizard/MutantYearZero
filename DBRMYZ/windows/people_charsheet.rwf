    <LUACode>-- Humans (Elysium) activate their contacts with influence points
function onInit()
	local bContacts = managerGame.getCharTypeData(DB.getChild(getDatabaseNode(), "...")).contacts == true;
	influence.setVisible(bContacts);
	activate.setVisible(bContacts);
end
</LUACode>
