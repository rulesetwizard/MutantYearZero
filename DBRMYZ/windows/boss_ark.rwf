    <LUACode>-- Dropping an NPC on the Boss links its sheet
function onDrop(x, y, draginfo)
	if draginfo.isType("shortcut") then
		local sClass, sRecord = draginfo.getShortcutData();
		if sClass == "npc" then
			managerBoss.linkBossNPC(getDatabaseNode(), sRecord);
			return true;
		end
	end
end
</LUACode>
