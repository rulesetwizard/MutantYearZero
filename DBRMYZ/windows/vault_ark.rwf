    <LUACode>-- Right-click menu: take the artifact out of the Dawn Vault, losing its DEV bonus
function onInit()
	name.setReadOnly(true);
	devrequired.setReadOnly(true);
	devbonus.setReadOnly(true);
	registerMenuItem("Take out of the Dawn Vault", "erase", 4);
end

function onMenuSelection(selection)
	if selection == 4 then
		managerArk.removeArtifact(getDatabaseNode());
	end
end
</LUACode>
