    <LUACode>-- Dropping an artifact hands it over to the Dawn Vault and adds its DEV bonus to the Ark
function onDrop(x, y, draginfo)
	if draginfo.isType("shortcut") then
		local sClass, sRecord = draginfo.getShortcutData();
		if sClass == "item" or sClass == "reference_item" then
			managerArk.storeArtifact(window.getDatabaseNode(), sRecord);
			return true;
		end
	end
end
</LUACode>
