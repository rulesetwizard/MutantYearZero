    <LUACode>function onInit()
	if super and super.onInit then
		super.onInit();
	end
	onValueChanged();
end

-- Only shown when an NPC is linked (the field itself reports its own record when empty)
function onValueChanged()
	local _, sRecord = DB.getValue(window.getDatabaseNode(), "npc");
	setVisible((sRecord or "") ~= "");
end
</LUACode>
