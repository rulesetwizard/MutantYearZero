    <LUACode>-- Fields of the type of character: age and rank (reputation for humans), and the animal type and species
function onInit()
	DB.addHandler(DB.getPath(getDatabaseNode(), "chartype"), "onUpdate", onTypeChanged);
	OptionsManager.registerCallback(managerGame.OPTION_GAME, onTypeChanged);
	updateTypeFields();
end

function onClose()
	DB.removeHandler(DB.getPath(getDatabaseNode(), "chartype"), "onUpdate", onTypeChanged);
	OptionsManager.unregisterCallback(managerGame.OPTION_GAME, onTypeChanged);
end

function onTypeChanged()
	updateTypeFields();
end

function updateTypeFields()
	local nodeChar = getDatabaseNode();
	local rType = managerGame.getCharTypeData(nodeChar);
	local bAge = (rType.hasAge == true);
	age_label.setVisible(bAge);
	age.setComboBoxVisible(bAge);
	local bRank = (rType.rank ~= nil);
	rank_label.setVisible(bRank);
	rank.setVisible(bRank);
	if bRank then
		rank_label.setValue(rType.rank);
	end
	local bAnimal = (managerGame.getCharType(nodeChar) == "animal");
	animaltype_label.setVisible(bAnimal);
	animaltype.setComboBoxVisible(bAnimal);
	species_label.setVisible(bAnimal);
	species.setVisible(bAnimal);
end
</LUACode>
