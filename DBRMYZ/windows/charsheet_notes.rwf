    <LUACode>function onInit()
	if super and super.onInit then
		super.onInit();
	end
	updateTooltip();
end

function onValueChanged()
	if super and super.onValueChanged then
		super.onValueChanged();
	end
	updateTooltip();
end

-- Key attribute, Instinct recovery and common species of the animal type
function updateTooltip()
	local nodeChar = window.getDatabaseNode();
	local rAnimalType = managerGame.getAnimalType(nodeChar);
	if not rAnimalType then
		setTooltipText("Animal type of the character (Genlab Alpha)");
		return;
	end
	setTooltipText("Key attribute: " .. managerGame.getAttribute(nodeChar, rAnimalType.key).label ..
			". Recovers Instinct: " .. rAnimalType.behavior .. ". Species: " .. rAnimalType.species .. ".");
end
</LUACode>
