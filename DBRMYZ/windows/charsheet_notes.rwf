    <LUACode>-- A new character takes the type of the game of the campaign
function onInit()
	if super and super.onInit then
		super.onInit();
	end
	local nodeChar = window.getDatabaseNode();
	if DB.getValue(nodeChar, "chartype", "") == "" and DB.isOwner(nodeChar) then
		setValue(managerGame.getDefaultCharType());
	end
end
</LUACode>
