    <LUACode>function update()
	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());

	devrequired.setReadOnly(bReadOnly);
	skills.setReadOnly(bReadOnly);
	otherreq.setReadOnly(bReadOnly);
	wppc.setReadOnly(bReadOnly);
	devbonus.setReadOnly(bReadOnly);
	workpoints.setReadOnly(bReadOnly);
	complete.setReadOnly(bReadOnly);
	bodycount.setReadOnly(bReadOnly);
	comment.setReadOnly(bReadOnly);
	description.setReadOnly(bReadOnly);
end
</LUACode>
