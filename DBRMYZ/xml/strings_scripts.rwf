	&lt;string name="rot_desc_decontaminate"&gt;Decontamination (%d temporary rot points)&lt;/string&gt;
	&lt;string name="rot_tag_permanent_new"&gt;[PERMANENT ROT +%d]&lt;/string&gt;
	&lt;string name="rot_tag_permanent"&gt;[Permanent rot points: %d]&lt;/string&gt;
	&lt;string name="rot_tag_none"&gt;[No rot points left]&lt;/string&gt;
