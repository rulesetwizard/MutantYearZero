    <LUACode>function onInit()
	if ActorManager.resolveActor(window.getDatabaseNode()).sType == 'charsheet' then
		setVisible(false);
	end
end

function onDoubleClick(x, y)
	local nodeCT = window.getDatabaseNode();
	local nDamage = DB.getValue(nodeCT, "ddamage", 0);
	if nDamage &lt;= 0 then
		return true;
	end
	if managerDamage.applyDamage(nodeCT, nDamage) then
		DB.setValue(nodeCT, "ddamage", "number", 0);
	else
		ChatManager.SystemMessage("Select a target to apply the damage.");
	end
	return true;
end
</LUACode>
