    <LUACode>function update()
	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());

	coordinates.setReadOnly(bReadOnly);
	terrain.setReadOnly(bReadOnly);
	threat.setReadOnly(bReadOnly);
	rotlevel.setReadOnly(bReadOnly);
	comment.setReadOnly(bReadOnly);
end
