    <LUACode>-- Using a mutation spends as many mutation points as this value and rolls as many base dice
function onBeforeDiceRoll()
	local nodeMutation = window.getDatabaseNode();
	local nodeChar = DB.getChild(nodeMutation, "...");
	local nSpend = getValue();
	if nSpend &lt;= 0 then
		return false;
	end
	local nMP = DB.getValue(nodeChar, "mutationpoints", 0);
	if nMP &lt; nSpend then
		ChatManager.SystemMessage(DB.getValue(nodeChar, "name", "") .. " has " .. nMP .. " MP and cannot spend " .. nSpend .. ".");
		return false;
	end
	DB.setValue(nodeChar, "mutationpoints", "number", nMP - nSpend);
	DB.setValue(nodeChar, "diceMutationf", "string", DB.getPath(nodeMutation));
	return true;
end
</LUACode>
