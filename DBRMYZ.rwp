    <LUACode>-- Below 0 the skill dice are negative dice: red frame
function onInit()
	onValueChanged();
end

function onValueChanged()
	if getValue() &lt; 0 then
		setFrame("dred");
	else
		setFrame("dgreen");
	end
end
</LUACode>
