      {"Name":"XPos","Value":{"@xsi:type":"xsd:int","#text":"0"}},
      {"Name":"YPos","Value":{"@xsi:type":"xsd:int","#text":"0"}}
]}}</Definition>
    <LUACode>function update(bReadOnly)
	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());

	type.setReadOnly(bReadOnly);
	gang.setReadOnly(bReadOnly);
	description.setReadOnly(bReadOnly);
end

-- Dropping an NPC on the Boss links its sheet
function onDrop(x, y, draginfo)
	if draginfo.isType("shortcut") then
		local sClass, sRecord = draginfo.getShortcutData();
		if sClass == "npc" then
			managerBoss.linkBossNPC(getDatabaseNode(), sRecord);
			return true;
		end
	end
end
</LUACode>
