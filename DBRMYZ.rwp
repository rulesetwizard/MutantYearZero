    <LUACode>function onInit()
	update();
end
function update()
	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());

	cost.setReadOnly(bReadOnly);
	weight.setReadOnly(bReadOnly);
	size.setReadOnly(bReadOnly);
	reach.setReadOnly(bReadOnly);
	weight.setReadOnly(bReadOnly);
	speed.setReadOnly(bReadOnly);

	bonus.setReadOnly(bReadOnly);
	armor.setReadOnly(bReadOnly);
	resilience.setReadOnly(bReadOnly);
	occupants.setReadOnly(bReadOnly);

	description.setReadOnly(bReadOnly);

end
</LUACode>
