    <LUACode>function onDoubleClick(x, y)
	local nodeChar = window.getDatabaseNode();

	local nBonus = DB.getValue(nodeChar, "ddamage", 0);

	if nBonus &gt; 0 and managerDamage.applyDamage(nodeChar, nBonus) then
		DB.setValue(nodeChar, "ddamage", "number", 0);
		return true;
	end

		if nodeChar.getChild("token").getValue() then
			sIcon = nodeChar.getChild("token").getValue();
			sIcon = string.gsub(sIcon, "token", "chat");
		else
			sIcon = "portrait_gm_token";
		end
				
		local msg = ChatManager.createBaseMessage(nil, nil);

		local aAddIcons = {};
		table.insert(aAddIcons, sIcon);
		table.insert(aAddIcons, "chat_damage");

	if #aAddIcons &gt; 0 then
		msg.icon = {};
		for _,v in ipairs(aAddIcons) do
			table.insert (msg.icon, tostring(v));
		end
	end

		msg.text = msg.text .. nBonus .. " damage.";
		Comm.deliverChatMessage(msg);
	
	DB.setValue(nodeChar, "ddamage", "number", 0);
	
	return true;
end
</LUACode>
