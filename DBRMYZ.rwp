    <LUACode>function onInit()
	if super and super.onInit then
		super.onInit();
	end
	applyFilter();
end

function onListChanged()
	if super and super.onListChanged then
		super.onListChanged();
	end
	applyFilter();
end

-- Everything that is not a weapon or an armor is gear, including items without type
-- (created from the CoreRPG Inventory tab or dropped as text)
function onFilter(w)
	local sType = DB.getValue(w.getDatabaseNode(), "type", "");
	return (sType ~= "weapon") and (sType ~= "armor");
end

function onDrop(x, y, draginfo)
	return ItemManager.handleAnyDrop(window.getDatabaseNode(), draginfo);
end

function addEntry()
	local wNew = createWindow(nil, true);
	local node = wNew.getDatabaseNode();
	DB.setValue(node, "type", "string", "gear");
	DB.setValue(node, "count", "number", 1);
	DB.setValue(node, "weight", "number", 1);
	RecordManager.onRecordAddEvent("gear", node);
	return wNew;
end
</LUACode>
