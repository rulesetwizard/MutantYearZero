    <LUACode>function onInit()
	if super and super.onInit then
		super.onInit();
	end
	updateTooltip();
end

function onValueChanged()
	updateTooltip();
end

function updateTooltip()
	setTooltipText(managerRot.getRotLevelText(getValue()));
end
