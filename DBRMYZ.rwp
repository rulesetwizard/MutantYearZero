    <LUACode>
function onDoubleClick(x, y)
	local nodeEntry = window.getDatabaseNode();
	local nodeChar = window.getDatabaseNode().getParent().getParent();
	local nTalent = window.bonus.getValue();
	
	local nBase = DB.getValue(nodeChar, "dbase", 0);
	DB.setValue(nodeChar, "dbase", "number", nBase+getValue());

	
end
</LUACode>
