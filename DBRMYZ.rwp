    <LUACode>-- Dropping a project record starts it, if the DEV levels of the Ark are high enough
function onDrop(x, y, draginfo)
	if draginfo.isType("shortcut") then
		local sClass, sRecord = draginfo.getShortcutData();
		if sClass == "project" then
			managerArk.startProject(window.getDatabaseNode(), sRecord);
			return true;
		end
	end
end
</LUACode>
