    <LUACode>function onInit()
	update();
end
function update()
	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());

    for _,w in ipairs(project_list.getWindows()) do 
        w.name.setReadOnly(bReadOnly);
        w.skills.setReadOnly(bReadOnly);
        w.complete.setReadOnly(bReadOnly);
        w.workpoints.setReadOnly(bReadOnly);
	end
end
</LUACode>
