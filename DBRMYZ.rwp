    <LUACode>-- Labels that depend on the type of character (managerGame): Empathy or Instinct, and the powers and the points
-- gained when pushing (none for humans)
function onInit()
	DB.addHandler(DB.getPath(getDatabaseNode(), "chartype"), "onUpdate", onTypeChanged);
	OptionsManager.registerCallback(managerGame.OPTION_GAME, onTypeChanged);
	updateTypeLabels();
end

function onClose()
	DB.removeHandler(DB.getPath(getDatabaseNode(), "chartype"), "onUpdate", onTypeChanged);
	OptionsManager.unregisterCallback(managerGame.OPTION_GAME, onTypeChanged);
end

function onTypeChanged()
	updateTypeLabels();
end

function updateTypeLabels()
	local rType = managerGame.getCharTypeData(getDatabaseNode());
	empathy_label.setValue(rType.empathy);
	mutation_label.setValue(rType.powers);
	local bPoints = (rType.points ~= nil);
	mp_label.setVisible(bPoints);
	mutationpoints_counter.setVisible(bPoints);
	if bPoints then
		mp_label.setValue(rType.points);
	end
end
</LUACode>
