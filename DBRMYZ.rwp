    <LUACode>-- EMP, or INS for animals (Genlab Alpha)
function onInit()
	local nodeCT = window.getDatabaseNode();
	local rActor = ActorManager.resolveActor(nodeCT);
	setValue(managerGame.getAttribute((rActor and rActor.sCreatureNode) or nodeCT, "EMP").code);
end
