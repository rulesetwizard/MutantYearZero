    <LUACode>
function onInit()

	local nodeChar = window.getDatabaseNode();
	
	if ActorManager.resolveActor(nodeChar).sType == 'charsheet' then
		setVisible(false);
		return true;
	end
	onValueChanged();
end

-- Below 0 the skill dice are negative dice: red frame
function onValueChanged()
	if getValue() &lt; 0 then
		setFrame("dred");
	else
		setFrame("dgreen");
	end
end
</LUACode>
