    <LUACode>function onBeforeDiceRoll()
	local nodeChar = window.getDatabaseNode().getParent().getParent();
	DB.setValue(nodeChar, "diceArmorf", "string", DB.getPath(window.getDatabaseNode()));
	return true;
end
</LUACode>
