    <LUACode>function update(bReadOnly)
	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());

	names.setReadOnly(bReadOnly);
	desc.setReadOnly(bReadOnly);
	attribute.setReadOnly(bReadOnly);
	appearance.setReadOnly(bReadOnly);
	talent_list.setReadOnly(bReadOnly);
	relpc.setReadOnly(bReadOnly);
	relnpc.setReadOnly(bReadOnly);
	dream.setReadOnly(bReadOnly);
	gear_text.setReadOnly(bReadOnly);
	gear_list.setReadOnly(bReadOnly);
	weapon_list.setReadOnly(bReadOnly);
	startbullets.setReadOnly(bReadOnly);
	startgrub.setReadOnly(bReadOnly);
	startwater.setReadOnly(bReadOnly);
end
</LUACode>
