    <LUACode>-- Right-click menu: complete the project by hand, or destroy it (losing its DEV bonus if it was completed)
function onInit()
	registerMenuItem("Complete project", "radial_magicwand", 2);
	registerMenuItem("Destroy project", "erase", 4);
end

function onMenuSelection(selection)
	local nodeProject = getDatabaseNode();
	if selection == 2 then
		if DB.getValue(nodeProject, "complete", 0) == 0 then
			managerArk.completeProject(nodeProject);
		end
	elseif selection == 4 then
		managerArk.destroyProject(nodeProject);
	end
end
</LUACode>
