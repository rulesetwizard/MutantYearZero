    <LUACode>local sProjects;

function onInit()
	update();
	updateDerived();

	-- Completed projects can change the body count
	sProjects = DB.getPath(getDatabaseNode(), "projectlist");
	DB.addHandler(sProjects .. ".*.complete", "onUpdate", updateBodyCount);
	DB.addHandler(sProjects .. ".*.bodycount", "onUpdate", updateBodyCount);
	DB.addHandler(sProjects, "onChildDeleted", updateBodyCount);
end

function onClose()
	DB.removeHandler(sProjects .. ".*.complete", "onUpdate", updateBodyCount);
	DB.removeHandler(sProjects .. ".*.bodycount", "onUpdate", updateBodyCount);
	DB.removeHandler(sProjects, "onChildDeleted", updateBodyCount);
end

function update()
	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());

	description.setReadOnly(bReadOnly);
	foodsupply.setReadOnly(bReadOnly);
	culture.setReadOnly(bReadOnly);
	technology.setReadOnly(bReadOnly);
	warfare.setReadOnly(bReadOnly);
	population.setReadOnly(bReadOnly);
	watersource.setReadOnly(bReadOnly);
	season.setReadOnly(bReadOnly);

	-- The type of a Boss is chosen in its record
    for _,w in ipairs(boss_list.getWindows()) do 
        w.name.setReadOnly(bReadOnly);
    end
end

-- What each DEV level means for the Ark (grub price, Battle Level...), shown next to it
function updateDerived()
	for _,sField in ipairs({ "foodsupply", "culture", "technology", "warfare" }) do
		local sText, sTooltip = managerArk.getDerivedText(sField, self[sField].getValue());
		self[sField .. "_derived"].setValue(sText);
		self[sField .. "_derived"].setTooltipText(sTooltip);
	end
	updateBodyCount();
end

function updateBodyCount()
	local sDice, aSources = managerArk.getBodyCountText(getDatabaseNode());
	bodycount_dice.setValue(sDice);
	if #aSources &gt; 0 then
		bodycount_dice.setTooltipText(table.concat(aSources, ", "));
	else
		bodycount_dice.setTooltipText("");
	end
end
</LUACode>
