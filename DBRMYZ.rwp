    <LUACode>function onInit()
	updateColor();
end

function onValueChanged()
	updateColor();
end

-- Red when the load is over the maximum (Strength x 2)
function updateColor()
	if not window.encmax then
		return;
	end
	if getValue() &gt; window.encmax.getValue() then
		setColor("FFC00000");
	else
		setColor("FF000000");
	end
end
</LUACode>
