    <LUACode>function onInit()
	update();
end
function update()
	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());

	cost.setReadOnly(bReadOnly);
	weight.setReadOnly(bReadOnly);

	description.setReadOnly(bReadOnly);
	armor.setReadOnly(bReadOnly);

end
</LUACode>
