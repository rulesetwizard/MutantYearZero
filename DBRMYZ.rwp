    <LUACode>-- Hidden for PCs; for NPCs, Mutations, Animal Powers or Implants by the type of the game
function onInit()
	local nodeChar = window.getDatabaseNode();
	if ActorManager.resolveActor(nodeChar).sType == 'charsheet' then
		setVisible(false);
		return true;
	end
	setValue(managerGame.getCharTypeData(nodeChar).powers);
end
</LUACode>
