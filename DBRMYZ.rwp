    <LUACode>function action(draginfo)
	local nodeWin = window.getDatabaseNode();
	local nodeChar = nodeWin.getParent().getParent();

	local sMessage = DB.getText(nodeWin, "name", 0);
	local sBonus = DB.getText(nodeWin, "bonus", 0);

		if nodeChar.getChild("token").getValue() then
			sIcon = nodeChar.getChild("token").getValue();
			sIcon = string.gsub(sIcon, "token", "chat");
		else
			sIcon = "portrait_gm_token";
		end
				
		msg = {};

		local aAddIcons = {};
		table.insert(aAddIcons, sIcon);
		table.insert(aAddIcons, "chat_damage");
	
	if #aAddIcons &gt; 0 then
		msg.icon = { msg.icon };
		for _,v in ipairs(aAddIcons) do
			table.insert (msg.icon, tostring(v));
		end
	end

		msg.text = sMessage .. " damage " .. sBonus;
--		msg.icon = string.gsub(DB.getPath(nodeChar), "charsheet.", "portrait_") .. "_chat";
		Comm.deliverChatMessage(msg);
	
	return true;
end

function onDoubleClick(x, y)
--	local nodeEntry = window.getDatabaseNode();
	local nodeChar = window.getDatabaseNode().getParent().getParent();
	--local nDamage = window.bonus.getValue();
	
--	local nGear = DB.getValue(nodeChar, "ddamage", 0);
	DB.setValue(nodeChar, "ddamage", "number", getValue());

	
end
</LUACode>
