    <LUACode>function onInit()
	super.onInit();
	onValueChanged();	
	
end	


function onValueChanged()
	if window.getDatabaseNode().getChild("type").getValue() == '' then
		window.getDatabaseNode().getChild("type").setValue("gear");
	end

	local sType = window.getDatabaseNode().getChild("type").getValue();
	window.item_gear.setVisible(sType == "gear");
	window.item_weapon.setVisible(sType == "weapon");
	window.item_armor.setVisible(sType == "armor");
	window.item_artifact.setVisible(sType == "artifact");
end

</LUACode>
