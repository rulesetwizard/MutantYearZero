    <LUACode>-- An NPC dropped here becomes a Boss of the Ark linked to its sheet; Boss records are copied as usual
function onDrop(x, y, draginfo)
	if draginfo.isType("shortcut") then
		local sClass, sRecord = draginfo.getShortcutData();
		if sClass == "npc" then
			managerBoss.addBossNPC(window.getDatabaseNode(), sRecord);
			return true;
		end
	end
end
</LUACode>
