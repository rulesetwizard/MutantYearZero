  </Scripts>
  <Scripts>
    <ScriptName>managerArk</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Ark projects: started from the Projects tab of the Ark if its DEV levels are high enough, worked on with a
-- skill roll of a character (each success is a work point), and adding their DEV bonus to the Ark when completed.
-- Also the values derived from the DEV levels, the body count of the session and the Dawn Vault

local aDevLevels = {
	{ field = "foodsupply", label = "Food Supply", keys = { "food", "abastecimiento", "comida" } },
	{ field = "culture", label = "Culture", keys = { "cultur" } },
	{ field = "technology", label = "Technology", keys = { "technolog", "tecnolog" } },
	{ field = "warfare", label = "Warfare", keys = { "warfare", "guerra" } },
};

-- Short text and tooltip of each step of the DEV levels (0-9, 10-19, 20-29, 30+)
local tDerived = {
	foodsupply = {
		{ "1 grub per bullet", "A desperate struggle for food. A bullet buys 1 grub." },
		{ "2 grub per bullet", "Enough grub for daily needs while harvests and hunts go well. A bullet buys 2 grub. Body count -1." },
		{ "3 grub per bullet", "Almost everyone eats every day, with some reserves. A bullet buys 3 grub. Body count -2." },
		{ "4 grub per bullet", "Nobody goes hungry; cooking and brewing are refined. A bullet buys 4 grub. Body count -3." },
	},
	culture = {
		{ "Campfire tales", "Apart from the Chroniclers, only tales around the barrel fires." },
		{ "Basic literacy", "Most can read and write a little; maybe a place of worship, plays or exhibitions." },
		{ "Schools", "Writing is advanced and widespread; maybe an organized school." },
		{ "Self-government", "The ideals of the Ancients are known; maybe some form of voting or participatory rule." },
	},
	technology = {
		{ "Gearheads only", "Only the Gearheads understand technology; most artifacts are puzzles." },
		{ "Mills and stills", "Basic technical knowledge: simple constructions like a mill or a still." },
		{ "Workshops", "Mechanical construction: workshops, new roads, machines like a printing press." },
		{ "Steam engines", "On the edge of a revolution: steam engines, heliographs, electric lights, breech-loading guns." },
	},
	warfare = {
		{ "", "Only simple barricades: the Ark is defenseless against outside enemies." },
		{ "", "Scrap palisades and watchtowers, maybe some patrols." },
		{ "", "Probably an organized militia, maybe an armory." },
		{ "", "A standing army; the Ark is defended by home-made cannons and flamethrowers." },
	},
};

function onInit()
	GameManager.addAction("myz_devbonus", { });
	ActionsManager.registerResultHandler("myz_devbonus", onDevBonusResult);
	GameManager.addAction("myz_bodycount", { });
	ActionsManager.registerResultHandler("myz_bodycount", onBodyCountResult);
	ItemManager.setCustomCharAdd(onCharItemAdd);
end

function getDevLevel(sText)
	local sLower = sText:lower();
	for _,rDev in ipairs(aDevLevels) do
		for _,sKey in ipairs(rDev.keys) do
			if sLower:find(sKey, 1, true) then
				return rDev;
			end
		end
	end
	return nil;
end

-- "Culture 5, Technology 10" or "Warfare +2D6, Culture -1D6": a list of { rDev, nDice, nValue, nSign }
function parseDevList(sText)
	local aList = {};
	for sPart in sText:gmatch("[^,;]+") do
		local rDev = getDevLevel(sPart);
		if rDev then
			local nDice = tonumber(sPart:lower():match("(%d+)%s*d6"));
			local nSign = sPart:match("%-%s*%d") and -1 or 1;
			table.insert(aList, { rDev = rDev, nDice = nDice or 0, nValue = nDice and 0 or (tonumber(sPart:match("(%d+)")) or 0), nSign = nSign });
		end
	end
	return aList;
end

-- The Ark of a project or of an artifact in the Dawn Vault
function getArkNode(nodeEntry)
	return DB.getChild(nodeEntry, "...");
end

-- Work points are given per player character
function getPCCount()
	local nPCs = DB.getChildCount("partysheet.partyinformation");
	if nPCs == 0 then
		nPCs = DB.getChildCount("charsheet");
	end
	return math.max(1, nPCs);
end

function announce(sText)
	Comm.deliverChatMessage({ font = "msgfont", text = sText });
end

--
-- Values derived from the DEV levels
--

function getDevStep(nLevel)
	return math.min(3, math.floor(math.max(0, nLevel) / 10));
end

-- 0-9 is Battle Level 1, 10-19 is 2...
function getBattleLevel(nWarfare)
	return math.floor(math.max(0, nWarfare) / 10) + 1;
end

function getDerivedText(sField, nLevel)
	local aStep = tDerived[sField][getDevStep(nLevel) + 1];
	if sField == "warfare" then
		return "Battle Level " .. getBattleLevel(nLevel), aStep[2] .. " Battle Level +1 when the Ark is on alert.";
	end
	return aStep[1], aStep[2];
end

--
-- Body count of the session: 1D6 at the end of each session, lowered by the food supply and changed by
-- completed projects (their body count field, e.g. -1 or +1D6); the result is taken from the population
--

function getBodyCount(nodeArk)
	local nDice, nMod = 1, 0;
	local aSources = {};
	local nFood = getDevStep(DB.getValue(nodeArk, "foodsupply", 0));
	if nFood &gt; 0 then
		nMod = nMod - nFood;
		table.insert(aSources, "Food Supply -" .. nFood);
	end
	for _,nodeProject in ipairs(DB.getChildList(nodeArk, "projectlist")) do
		local sChange = DB.getValue(nodeProject, "bodycount", ""):gsub("%s+", ""):lower();
		if DB.getValue(nodeProject, "complete", 0) == 1 and sChange ~= "" then
			for sSign, sTerm in sChange:gmatch("([%+%-]?)([^%+%-]+)") do
				local nSign = (sSign == "-") and -1 or 1;
				local sDice = sTerm:match("^(%d*)d6$");
				if sDice then
					if nSign &gt; 0 then
						nDice = nDice + (tonumber(sDice) or 1);
					end
				elseif tonumber(sTerm) then
					nMod = nMod + nSign * tonumber(sTerm);
				end
			end
			table.insert(aSources, DB.getValue(nodeProject, "name", "") .. " " .. DB.getValue(nodeProject, "bodycount", ""));
		end
	end
	return nDice, nMod, aSources;
end

function getBodyCountText(nodeArk)
	local nDice, nMod, aSources = getBodyCount(nodeArk);
	local sDice = nDice .. "D6";
	if nMod ~= 0 then
		sDice = sDice .. string.format("%+d", nMod);
	end
	return sDice, aSources;
end

function rollBodyCount(nodeArk)
	local nDice, nMod, aSources = getBodyCount(nodeArk);
	local sDesc = "Body count of the session";
	if #aSources &gt; 0 then
		sDesc = sDesc .. " [" .. table.concat(aSources, ", ") .. "]";
	end
	local sDice = nDice .. "d6";
	if nMod ~= 0 then
		sDice = sDice .. string.format("%+d", nMod);
	end
	RulesetWizardDiceRoller.Roll(nil, nil, "myz_bodycount", sDesc, sDice, 0, { sArk = DB.getPath(nodeArk) });
end

function onBodyCountResult(rSource, rTarget, rRoll)
	local nDead = math.max(0, ActionsManager.total(rRoll));
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	local nodeArk = DB.findNode(rRoll.sArk or "");
	if nodeArk then
		local nPopulation = DB.getValue(nodeArk, "population", 0);
		local nNewPopulation = math.max(0, nPopulation - nDead);
		DB.setValue(nodeArk, "population", "number", nNewPopulation);
		rMessage.text = rMessage.text .. " [" .. nDead .. " dead] [Population " .. nPopulation .. " -&gt; " .. nNewPopulation .. "]";
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

--
-- Dawn Vault: artifacts handed over to it add their DEV bonus to the Ark (rolled), and lose it when taken out
--

function storeArtifact(nodeArk, sRecord)
	local nodeSource = managerChar.resolveRefNode(sRecord);
	if not nodeSource then
		return;
	end
	local sName = DB.getValue(nodeSource, "name", "");
	if DB.getValue(nodeSource, "type", "") ~= "artifact" then
		ChatManager.SystemMessage("Only artifacts can be handed over to the Dawn Vault (" .. sName .. " is not one).");
		return;
	end

	local nodeArtifact = DB.createChild(DB.createChild(nodeArk, "vaultlist"));
	DB.copyNode(nodeSource, nodeArtifact);
	DB.setValue(nodeArtifact, "count", "number", 1);

	-- An artifact from the inventory of a character leaves it
	local sText = "The " .. sName .. " is handed over to the Dawn Vault";
	if sRecord:match("^charsheet%.[^%.]+%.inventorylist%.[^@]+$") then
		local nodeChar = DB.getChild(nodeSource, "...");
		sText = DB.getValue(nodeChar, "name", "") .. " hands over the " .. sName .. " to the Dawn Vault";
		local nCount = DB.getValue(nodeSource, "count", 1);
		if nCount &gt; 1 then
			DB.setValue(nodeSource, "count", "number", nCount - 1);
		else
			DB.deleteNode(nodeSource);
		end
	end
	announce(sText .. ".");
	applyDevBonus(nodeArtifact, 1);
end

function removeArtifact(nodeArtifact)
	announce("The " .. DB.getValue(nodeArtifact, "name", "") .. " is taken out of the Dawn Vault.");
	applyDevBonus(nodeArtifact, -1);
	DB.deleteNode(nodeArtifact);
end

-- A character who gets an artifact understands it only if the Ark has the DEV level it requires;
-- otherwise the character must roll Comprehend
function onCharItemAdd(nodeItem)
	if CharManager.onCharItemAdd then
		CharManager.onCharItemAdd(nodeItem);
	end
	if DB.getValue(nodeItem, "type", "") ~= "artifact" then
		return;
	end
	local nodeArk = DB.getChildList("ark")[1];
	if not nodeArk then
		return;
	end

	local aMissing = {};
	for _,rRequired in ipairs(parseDevList(DB.getValue(nodeItem, "devrequired", ""))) do
		local nLevel = DB.getValue(nodeArk, rRequired.rDev.field, 0);
		if nLevel &lt; rRequired.nValue then
			table.insert(aMissing, rRequired.rDev.label .. " " .. rRequired.nValue .. " (it has " .. nLevel .. ")");
		end
	end
	if #aMissing &gt; 0 then
		local nodeChar = DB.getChild(nodeItem, "...");
		announce(DB.getValue(nodeChar, "name", "") .. " must roll Comprehend to use the " .. DB.getValue(nodeItem, "name", "") ..
				": the Ark needs " .. table.concat(aMissing, ", ") .. " to understand it.");
	end
end

--
-- Starting a project
--

function startProject(nodeArk, sRecord)
	local nodeSource = managerChar.resolveRefNode(sRecord);
	if not nodeSource then
		return;
	end
	local sName = DB.getValue(nodeSource, "name", "");

	for _,nodeProject in ipairs(DB.getChildList(nodeArk, "projectlist")) do
		if DB.getValue(nodeProject, "name", ""):lower() == sName:lower() then
			if DB.getValue(nodeProject, "complete", 0) == 1 then
				ChatManager.SystemMessage("The project " .. sName .. " is already completed.");
			else
				ChatManager.SystemMessage("The project " .. sName .. " is already in progress.");
			end
			return;
		end
	end

	local aMissing = {};
	for _,rRequired in ipairs(parseDevList(DB.getValue(nodeSource, "devrequired", ""))) do
		local nLevel = DB.getValue(nodeArk, rRequired.rDev.field, 0);
		if nLevel &lt; rRequired.nValue then
			table.insert(aMissing, rRequired.rDev.label .. " " .. rRequired.nValue .. " (the Ark has " .. nLevel .. ")");
		end
	end
	if #aMissing &gt; 0 then
		ChatManager.SystemMessage("The project " .. sName .. " needs " .. table.concat(aMissing, ", ") .. ".");
		return;
	end

	local nodeProject = DB.createChild(DB.createChild(nodeArk, "projectlist"));
	DB.copyNode(nodeSource, nodeProject);
	local nWorkPoints = DB.getValue(nodeSource, "wppc", 1) * getPCCount();
	DB.setValue(nodeProject, "workpoints", "number", nWorkPoints);
	DB.setValue(nodeProject, "complete", "number", 0);

	local sText = "The People start the project " .. sName .. " (" .. nWorkPoints .. " work points)";
	local sOther = DB.getValue(nodeSource, "otherreq", "");
	if sOther ~= "" then
		sText = sText .. ". It also requires: " .. sOther;
	end
	announce(sText .. ".");
end

--
-- Working on a project: fills the dice pool of the character with one of the skills of the project;
-- the roll of the pool takes the work points
--

function workOnProject(nodeProject)
	if DB.getValue(nodeProject, "complete", 0) == 1 then
		ChatManager.SystemMessage("The project " .. DB.getValue(nodeProject, "name", "") .. " is already completed.");
		return;
	end

	if not Session.IsHost then
		local sIdentity = User.getCurrentIdentity();
		local nodeChar = sIdentity and DB.findNode("charsheet." .. sIdentity);
		if not nodeChar then
			ChatManager.SystemMessage("Choose one of your characters to work on the project.");
			return;
		end
		chooseSkill(nodeChar, nodeProject);
		return;
	end

	local aOptions = {};
	for _,nodeChar in ipairs(DB.getChildList("charsheet")) do
		table.insert(aOptions, { text = DB.getValue(nodeChar, "name", ""), linkclass = "charsheet", linkrecord = DB.getPath(nodeChar) });
	end
	if #aOptions == 0 then
		return;
	end
	DialogManager.requestSelectionDialog({ title = "Work on the project", msg = "Who works on " .. DB.getValue(nodeProject, "name", "") .. "?",
			options = aOptions, min = 1, max = 1, callback = onCharSelection, custom = { sProject = DB.getPath(nodeProject) } });
end

function onCharSelection(_, tCustom, aSelectionLinks)
	local nodeProject = DB.findNode(tCustom.sProject);
	local tLink = (aSelectionLinks or {})[1];
	local nodeChar = tLink and DB.findNode(tLink.linkrecord or "");
	if nodeProject and nodeChar then
		chooseSkill(nodeChar, nodeProject);
	end
end

-- The skills of a project are written as "Force or Scout" (also with commas or slashes)
function chooseSkill(nodeChar, nodeProject)
	local tProjectSkills = {};
	local sSkills = DB.getValue(nodeProject, "skills", ""):lower():gsub("%s+or%s+", ","):gsub("%s+o%s+", ",");
	for sSkill in sSkills:gmatch("[^,/]+") do
		tProjectSkills[StringManager.trim(sSkill)] = true;
	end

	local aSkills = {};
	for _,nodeSkill in ipairs(DB.getChildList(nodeChar, "skilllist")) do
		if tProjectSkills[DB.getValue(nodeSkill, "name", ""):lower()] then
			table.insert(aSkills, nodeSkill);
		end
	end

	if #aSkills == 0 then
		ChatManager.SystemMessage(DB.getValue(nodeChar, "name", "") .. " has none of the skills of the project (" .. DB.getValue(nodeProject, "skills", "") .. ").");
		return;
	end
	if #aSkills == 1 then
		setWorkPool(nodeChar, aSkills[1], nodeProject);
		return;
	end
	local aOptions = {};
	for _,nodeSkill in ipairs(aSkills) do
		table.insert(aOptions, { text = DB.getValue(nodeSkill, "name", ""), linkclass = "skill", linkrecord = DB.getPath(nodeSkill) });
	end
	DialogManager.requestSelectionDialog({ title = "Work on the project", msg = "Which skill does " .. DB.getValue(nodeChar, "name", "") .. " use?",
			options = aOptions, min = 1, max = 1, callback = onSkillSelection,
			custom = { sChar = DB.getPath(nodeChar), sProject = DB.getPath(nodeProject) } });
end

function onSkillSelection(_, tCustom, aSelectionLinks)
	local nodeChar = DB.findNode(tCustom.sChar);
	local nodeProject = DB.findNode(tCustom.sProject);
	local tLink = (aSelectionLinks or {})[1];
	local nodeSkill = tLink and DB.findNode(tLink.linkrecord or "");
	if nodeChar and nodeProject and nodeSkill then
		setWorkPool(nodeChar, nodeSkill, nodeProject);
	end
end

function setWorkPool(nodeChar, nodeSkill, nodeProject)
	local sAttribute = DB.getValue(nodeSkill, "attribute", "");
	local nAttribute = managerGame.getCurrentAttribute(nodeChar, sAttribute) or 0;
	DB.setValue(nodeChar, "dbase", "number", nAttribute);
	DB.setValue(nodeChar, "dskill", "number", math.max(0, DB.getValue(nodeSkill, "score", 0)));
	DB.setValue(nodeChar, "diceInfoAttribute", "string", sAttribute);
	DB.setValue(nodeChar, "diceInfoSkill", "string", DB.getValue(nodeSkill, "name", ""));
	DB.setValue(nodeChar, "diceInfoProject", "string", DB.getPath(nodeProject));
	ChatManager.SystemMessage(DB.getValue(nodeChar, "name", "") .. " works on " .. DB.getValue(nodeProject, "name", "") ..
			" with " .. DB.getValue(nodeSkill, "name", "") .. ": roll the dice pool of the character sheet (gear dice can be added).");
end

-- Called with the successes of a roll of the dice pool; returns the text for the roll message and the
-- project when it is completed with this roll
function applyWork(sCreatureNode, nSuccess)
	local nodeProject = DB.findNode(DB.getValue(sCreatureNode .. ".diceProjectf", ""));
	if not nodeProject or DB.getValue(nodeProject, "complete", 0) == 1 then
		return "", nil;
	end
	local sName = DB.getValue(nodeProject, "name", "");
	if nSuccess &lt;= 0 then
		return " [" .. sName .. ": no progress]", nil;
	end
	local nWorkPoints = math.max(0, DB.getValue(nodeProject, "workpoints", 0) - nSuccess);
	DB.setValue(nodeProject, "workpoints", "number", nWorkPoints);
	if nWorkPoints &gt; 0 then
		return " [" .. sName .. ": -" .. nSuccess .. " WP, " .. nWorkPoints .. " left]", nil;
	end
	return " [" .. sName .. ": COMPLETED]", nodeProject;
end

--
-- Completing and destroying projects
--

-- The DEV bonus of a project or an artifact is rolled and added to the Ark (nSign -1 takes it away again);
-- a negative bonus (Culture -1D6) is taken away when added
function applyDevBonus(nodeEntry, nSign)
	local nodeArk = getArkNode(nodeEntry);
	local sName = DB.getValue(nodeEntry, "name", "");
	for _,rBonus in ipairs(parseDevList(DB.getValue(nodeEntry, "devbonus", ""))) do
		local nBonusSign = nSign * rBonus.nSign;
		if rBonus.nDice &gt; 0 then
			RulesetWizardDiceRoller.Roll(nil, nil, "myz_devbonus", sName .. ": " .. rBonus.rDev.label, rBonus.nDice .. "d6", 0,
					{ sArk = DB.getPath(nodeArk), sField = rBonus.rDev.field, sLabel = rBonus.rDev.label, nSign = nBonusSign });
		elseif rBonus.nValue &gt; 0 then
			addDevLevel(nodeArk, rBonus.rDev, nBonusSign * rBonus.nValue, sName);
		end
	end
end

function addDevLevel(nodeArk, rDev, nChange, sSource)
	local nLevel = DB.getValue(nodeArk, rDev.field, 0);
	local nNewLevel = math.max(0, nLevel + nChange);
	DB.setValue(nodeArk, rDev.field, "number", nNewLevel);
	announce(sSource .. ": " .. rDev.label .. " " .. nLevel .. " -&gt; " .. nNewLevel .. ".");
end

function onDevBonusResult(rSource, rTarget, rRoll)
	local nTotal = ActionsManager.total(rRoll);
	local nodeArk = DB.findNode(rRoll.sArk or "");
	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nodeArk then
		local nSign = tonumber(rRoll.nSign) or 1;
		local nLevel = DB.getValue(nodeArk, rRoll.sField, 0);
		local nNewLevel = math.max(0, nLevel + nSign * nTotal);
		DB.setValue(nodeArk, rRoll.sField, "number", nNewLevel);
		rMessage.text = rMessage.text .. " [" .. rRoll.sLabel .. " " .. nLevel .. " -&gt; " .. nNewLevel .. "]";
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

function completeProject(nodeProject)
	DB.setValue(nodeProject, "workpoints", "number", 0);
	DB.setValue(nodeProject, "complete", "number", 1);
	announce("The project " .. DB.getValue(nodeProject, "name", "") .. " is completed.");
	applyDevBonus(nodeProject, 1);
end

-- A destroyed project is erased from the Ark; if it was completed, its DEV bonus is rolled again and lost
function destroyProject(nodeProject)
	local sName = DB.getValue(nodeProject, "name", "");
	if DB.getValue(nodeProject, "complete", 0) == 1 then
		applyDevBonus(nodeProject, -1);
	end
	announce("The project " .. sName .. " is destroyed.");
	DB.deleteNode(nodeProject);
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>managerBoss</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Bosses of the Ark: their type, and the NPC sheet linked to them (attributes, skills and weapons for a fight)

local tBossTypes = {
	["Despot"] = "Obsessed with power and with showing it; lets others do the dirty work, sees enemies everywhere and crushes any sign of rebellion.",
	["Commander"] = "Drills the followers like soldiers and does not mind getting dirty hands now and then.",
	["Agitator"] = "Inspires the People with fiery speeches about a better future; the other Bosses see the Agitator as a threat.",
	["Revolutionary"] = "Wants to overthrow the Elder and build a fair order: no private property, no Bosses, decisions by consensus.",
	["Kingpin"] = "Treats the followers almost as slaves and pushes huge projects through with violence.",
	["Bureaucrat"] = "A neutral leader who rules by the old rules and orders of the Elder.",
	["Cult Leader"] = "Worshipped as divine by a cult of fanatics; any doubt is punished, and the cult keeps to itself.",
	["Collector"] = "Obsessed with artifacts of the Old Age; never hands anything over to the Dawn Vault.",
	["Worker"] = "Works side by side with the followers; wants to build something new instead of plotting.",
};

function getBossTypeText(sType)
	return tBossTypes[sType] or "";
end

-- An NPC dropped on the Bosses list of the Ark becomes a new Boss linked to its sheet
function addBossNPC(nodeArk, sRecord)
	local nodeNPC = DB.findNode(sRecord);
	if not nodeNPC then
		return;
	end
	local nodeBoss = DB.createChild(DB.createChild(nodeArk, "bosslist"));
	DB.setValue(nodeBoss, "name", "string", DB.getValue(nodeNPC, "name", ""));
	linkBossNPC(nodeBoss, sRecord);
end

function linkBossNPC(nodeBoss, sRecord)
	local nodeNPC = DB.findNode(sRecord);
	if not nodeNPC then
		return;
	end
	DB.setValue(nodeBoss, "npc", "windowreference", "npc", sRecord);
	DB.setValue(nodeBoss, "npcname", "string", DB.getValue(nodeNPC, "name", ""));
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>managerChar</ScriptName>
    <FolderID>9</FolderID>
    <Script>function onInit()
	if Session.IsHost then
		migrateAllChars();
	end

	DB.addEventHandler("onAuxCharLoad", onCharImport);
	DB.addEventHandler("onImport", onImport);
end

function onCharImport(nodeChar)
	migrateChar(nodeChar);
end

function onImport(node)
	local aPath = StringManager.split(DB.getPath(node), ".");
	if #aPath == 2 and aPath[1] == "charsheet" then
		migrateChar(node);
	end
end

function migrateAllChars()
	for _,nodeChar in ipairs(DB.getChildList("charsheet")) do
		migrateChar(nodeChar);
	end
end

function migrateChar(nodeChar)
	migrateCharGear(nodeChar);
	migrateCharArmor(nodeChar);
end

-- Weapons, gear and armor used to be stored in "gearlist"; they now live in the CoreRPG "inventorylist"
function migrateCharGear(nodeChar)
	if DB.getChildCount(nodeChar, "gearlist") &gt; 0 then
		local nodeInventory = DB.createChild(nodeChar, "inventorylist");
		for _,nodeItem in ipairs(DB.getChildList(nodeChar, "gearlist")) do
			local nodeNew = DB.createChild(nodeInventory);
			if nodeNew then
				DB.copyNode(nodeItem, nodeNew);
				if DB.getValue(nodeNew, "count", 0) == 0 then
					DB.setValue(nodeNew, "count", "number", 1);
				end
				DB.deleteNode(nodeItem);
			end
		end
	end
	if DB.getChildCount(nodeChar, "gearlist") == 0 then
		DB.deleteChild(nodeChar, "gearlist");
	end
end

-- The armor rating on the sheet used to be stored in "bonus"; it is now "armor", as in the item record
function migrateCharArmor(nodeChar)
	for _,nodeItem in ipairs(DB.getChildList(nodeChar, "inventorylist")) do
		if DB.getValue(nodeItem, "type", "") == "armor" and not DB.getChild(nodeItem, "armor") and DB.getChild(nodeItem, "bonus") then
			DB.setValue(nodeItem, "armor", "number", DB.getValue(nodeItem, "bonus", 0));
		end
	end
end

function resolveRefNode(sRecord)
    local nodeSource = DB.findNode(sRecord);
    if not nodeSource then
        local sRecordSansModule = StringManager.split(sRecord, "@")[1];
        nodeSource = DB.findNode(sRecordSansModule .. "@*");
        if not nodeSource then
            ChatManager.SystemMessage(Interface.getString("char_error_missingrecord"));
        end
    end

    return nodeSource;
end


-- Taking a role: role name and link, its specialist skill, its gear, a reminder of its starting resources,
-- and a choice of one of its talents and one of its starting weapons
function addRole(nodeChar, sClass, sRecord)
	local nodeSource = resolveRefNode(sRecord);
	if not nodeSource then
		return;
	end

	local sRoleName = DB.getValue(nodeSource, "name", "");
	local _, sCurrentRecord = DB.getValue(nodeChar, "link_role");
	if sCurrentRecord == sRecord then
		ChatManager.SystemMessage(DB.getValue(nodeChar, "name", "") .. " already has the role " .. sRoleName .. ".");
		return;
	end

	DB.setValue(nodeChar, "link_role", "windowreference", sClass, sRecord);
	DB.setValue(nodeChar, "role", "string", sRoleName);

	local aAdded = {};
	local sSkill = addRoleSkill(nodeChar, sRoleName);
	if sSkill then
		table.insert(aAdded, "skill " .. sSkill);
	end
	for _,nodeGear in ipairs(DB.getChildList(nodeSource, "gear")) do
		table.insert(aAdded, addRoleItem(nodeChar, nodeGear, "gear"));
	end
	local sText = DB.getValue(nodeChar, "name", "") .. " takes the role " .. sRoleName;
	if #aAdded &gt; 0 then
		sText = sText .. ": " .. table.concat(aAdded, ", ");
	end
	announce(sText .. ".");
	managerInventory.announceStartingResources(nodeChar, nodeSource);

	chooseRoleEntry(nodeChar, DB.getChildList(nodeSource, "talent"), "talent",
			"Talent", "Choose the talent of your " .. sRoleName .. ".", "addRoleTalent");
	chooseRoleEntry(nodeChar, DB.getChildList(nodeSource, "weapon"), "item",
			"Weapon", "Choose the starting weapon of your " .. sRoleName .. ".", "addRoleWeapon");
end

function announce(sText)
	Comm.deliverChatMessage({ font = "msgfont", text = sText });
end

function hasEntry(nodeChar, sList, sName)
	for _,nodeEntry in ipairs(DB.getChildList(nodeChar, sList)) do
		if DB.getValue(nodeEntry, "name", ""):lower() == sName:lower() then
			return true;
		end
	end
	return false;
end

-- The specialist skill of a role is the skill record named "&lt;role&gt;: &lt;skill&gt;"
function addRoleSkill(nodeChar, sRoleName)
	local sPrefix = sRoleName:lower() .. ":";
	for _,sMapping in ipairs(RecordDataManager.getDataPaths("skill")) do
		for _,nodeSkill in ipairs(DB.getChildrenGlobal(sMapping)) do
			local sName = DB.getValue(nodeSkill, "name", "");
			if sName:lower():sub(1, #sPrefix) == sPrefix then
				if not hasEntry(nodeChar, "skilllist", sName) then
					local nodeNew = DB.createChild(DB.createChild(nodeChar, "skilllist"));
					DB.copyNode(nodeSkill, nodeNew);
					DB.setValue(nodeNew, "score", "number", 0);
					DB.setValue(nodeNew, "link", "windowreference", "skill", DB.getPath(nodeSkill));
				end
				return sName;
			end
		end
	end
	return nil;
end

-- Items without weight are normal items (weight 1)
function addRoleItem(nodeChar, nodeItem, sDefaultType)
	local nodeNew = DB.createChild(DB.createChild(nodeChar, "inventorylist"));
	DB.copyNode(nodeItem, nodeNew);
	if DB.getValue(nodeNew, "type", "") == "" then
		DB.setValue(nodeNew, "type", "string", sDefaultType);
	end
	if DB.getValue(nodeNew, "count", 0) == 0 then
		DB.setValue(nodeNew, "count", "number", 1);
	end
	if not DB.getChild(nodeNew, "weight") then
		DB.setValue(nodeNew, "weight", "number", 1);
	end
	return DB.getValue(nodeNew, "name", "");
end

function addRoleTalent(nodeChar, nodeTalent)
	local sName = DB.getValue(nodeTalent, "name", "");
	if hasEntry(nodeChar, "talentlist", sName) then
		return;
	end
	local nodeNew = DB.createChild(DB.createChild(nodeChar, "talentlist"));
	DB.copyNode(nodeTalent, nodeNew);
	announce(DB.getValue(nodeChar, "name", "") .. " learns the talent " .. sName .. ".");
end

function addRoleWeapon(nodeChar, nodeWeapon)
	local sName = addRoleItem(nodeChar, nodeWeapon, "weapon");
	announce(DB.getValue(nodeChar, "name", "") .. " takes the weapon " .. sName .. ".");
end

-- A single option is taken at once; with several, the player chooses one in a dialog
function chooseRoleEntry(nodeChar, aEntries, sLinkClass, sTitle, sMsg, sAddFunction)
	if #aEntries == 0 then
		return;
	end
	if #aEntries == 1 then
		managerChar[sAddFunction](nodeChar, aEntries[1]);
		return;
	end
	local aOptions = {};
	for _,nodeEntry in ipairs(aEntries) do
		table.insert(aOptions, { text = DB.getValue(nodeEntry, "name", ""), linkclass = sLinkClass, linkrecord = DB.getPath(nodeEntry) });
	end
	DialogManager.requestSelectionDialog({ title = sTitle, msg = sMsg, options = aOptions, min = 1, max = 1,
			callback = onRoleSelection, custom = { sChar = DB.getPath(nodeChar), sAddFunction = sAddFunction } });
end

function onRoleSelection(_, tCustom, aSelectionLinks)
	local nodeChar = DB.findNode(tCustom.sChar);
	if not nodeChar then
		return;
	end
	for _,tLink in ipairs(aSelectionLinks or {}) do
		local nodeEntry = DB.findNode(tLink.linkrecord or "");
		if nodeEntry then
			managerChar[tCustom.sAddFunction](nodeChar, nodeEntry);
		end
	end
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>managerDamage</ScriptName>
    <FolderID>9</FolderID>
    <Script>OOB_MSGTYPE_APPLYDAMAGE = "myz_applydamage";
CRITICAL_INJURIES_TABLE = "Critical Injuries";

local aAttributeFields = { "strength", "agility", "wits", "empathy" };

function onInit()
	GameManager.addAction("myz_soak", { });
	ActionsManager.registerResultHandler("myz_soak", onSoakResult);
	OOBManager.registerOOBMsgHandler(OOB_MSGTYPE_APPLYDAMAGE, handleDamage);

	if Session.IsHost then
		createCriticalInjuriesTable();
		for _,sField in ipairs(aAttributeFields) do
			for _,sPath in ipairs({ "charsheet.*.", "combattracker.list.*." }) do
				DB.addHandler(sPath .. sField, "onUpdate", onAttributeChanged);
				DB.addHandler(sPath .. sField .. "_loss", "onUpdate", onAttributeChanged);
			end
		end
	end
end

-- Applies the damage to every target of the attacker; returns false when the attacker has no targets
function applyDamage(nodeAttacker, nDamage)
	local rSource = ActorManager.resolveActor(nodeAttacker);
	local aTargets = TargetingManager.getFullTargets(rSource);
	if #aTargets == 0 then
		return false;
	end
	for _,rTarget in ipairs(aTargets) do
		soakDamage(rSource, rTarget, nDamage);
	end
	return true;
end

-- PCs get the damage as pending, until their player rolls the armor of their choice or accepts it.
-- NPCs roll their best armor at once: each 6 stops 1 point of damage and each 1 lowers the armor by 1.
function soakDamage(rSource, rTarget, nDamage)
	local sAttacker = ActorManager.getDisplayName(rSource);
	if ActorManager.isPC(rTarget) then
		notifyDamage(rTarget, "pending", nDamage, "", 0, sAttacker);
		return;
	end

	local nodeTarget = ActorManager.getCreatureNode(rTarget);
	local nodeArmor = getArmorNode(nodeTarget);
	local nArmor = 0;
	if nodeArmor then
		nArmor = DB.getValue(nodeArmor, getArmorField(nodeArmor), 0);
	end
	if nArmor &lt;= 0 then
		notifyDamage(rTarget, "apply", nDamage, "", 0, sAttacker);
		return;
	end

	local sDesc = "Armor (" .. DB.getValue(nodeArmor, "name", "") .. ") vs " .. nDamage .. " damage";
	RulesetWizardDiceRoller.Roll(nil, nodeTarget, "myz_soak", sDesc, nArmor .. "dgear", 0,
			{ nDamage = nDamage, sArmorNode = DB.getPath(nodeArmor), sAttacker = sAttacker });
end

-- The best armor of an NPC
function getArmorNode(nodeTarget)
	local nodeBest = nil;
	local nBest = 0;
	for _,nodeItem in ipairs(DB.getChildList(nodeTarget, "armorlist")) do
		local nValue = DB.getValue(nodeItem, "bonus", 0);
		if nValue &gt; nBest then
			nodeBest = nodeItem;
			nBest = nValue;
		end
	end
	return nodeBest;
end

-- Armor items of PCs keep their rating in "armor"; the armor of NPCs keeps it in "bonus"
function getArmorField(nodeArmor)
	if DB.getName(DB.getParent(nodeArmor)) == "inventorylist" then
		return "armor";
	end
	return "bonus";
end

function degradeArmor(sArmorNode, nBreak)
	local nodeArmor = DB.findNode(sArmorNode);
	if not nodeArmor or nBreak &lt;= 0 then
		return "";
	end
	local sField = getArmorField(nodeArmor);
	local nArmor = DB.getValue(nodeArmor, sField, 0);
	local nNewArmor = math.max(0, nArmor - nBreak);
	DB.setValue(nodeArmor, sField, "number", nNewArmor);
	return " [" .. DB.getValue(nodeArmor, "name", "") .. " armor " .. nArmor .. " -&gt; " .. nNewArmor .. "]";
end

function onSoakResult(rSource, rTarget, rRoll)
	local nStopped = 0;
	local nBreak = 0;
	for _,v in ipairs(rRoll.aDice) do
		if v.value == 6 then
			nStopped = nStopped + 1;
		elseif v.value == 1 then
			nBreak = nBreak + 1;
		end
	end
	local nDamage = math.max(0, (tonumber(rRoll.nDamage) or 0) - nStopped);

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = rMessage.text .. " [Damage Reduction (" .. nStopped .. ")]";
	if nBreak &gt; 0 then
		rMessage.text = rMessage.text .. " [Armor Break (" .. nBreak .. ")]";
	end
	rMessage.dicedisplay = 0;
	rMessage.diceskipexpr = true;
	Comm.deliverChatMessage(rMessage);

	notifyDamage(rSource, "apply", nDamage, rRoll.sArmorNode or "", nBreak, rRoll.sAttacker or "");
	return true;
end

-- Takes the pending damage of a PC, less the damage stopped by an armor roll (0 to take it all)
function takePendingDamage(nodeChar, nStopped)
	local nPending = DB.getValue(nodeChar, "pendingdamage", 0);
	if nPending &lt;= 0 then
		return;
	end
	local sAttacker = DB.getValue(nodeChar, "pendingattacker", "");
	DB.setValue(nodeChar, "pendingdamage", "number", 0);
	DB.setValue(nodeChar, "pendingattacker", "string", "");
	notifyDamage(nodeChar, "apply", math.max(0, nPending - nStopped), "", 0, sAttacker);
end

-- A successful Heal roll: the patient recovers 1 point per success
function notifyHeal(rTarget, nPoints, sHealer)
	notifyDamage(rTarget, "heal", nPoints, "", 0, sHealer);
end

-- The target may belong to another user, so damage and healing are handled on the host
function notifyDamage(vTarget, sMode, nDamage, sArmorNode, nArmorBreak, sAttacker)
	local msgOOB = {
		type = OOB_MSGTYPE_APPLYDAMAGE,
		sMode = sMode,
		sTarget = ActorManager.getCreatureNodeName(vTarget),
		nDamage = nDamage,
		sArmorNode = sArmorNode,
		nArmorBreak = nArmorBreak,
		sAttacker = sAttacker,
	};
	if Session.IsHost then
		handleDamage(msgOOB);
	else
		Comm.deliverOOBMessage(msgOOB, "");
	end
end

function handleDamage(msgOOB)
	local nodeTarget = DB.findNode(msgOOB.sTarget or "");
	if not nodeTarget then
		return;
	end
	if msgOOB.sMode == "pending" then
		handlePendingDamage(nodeTarget, msgOOB);
	elseif msgOOB.sMode == "heal" then
		handleHeal(nodeTarget, msgOOB);
	else
		handleApplyDamage(nodeTarget, msgOOB);
	end
end

function handlePendingDamage(nodeTarget, msgOOB)
	local nDamage = tonumber(msgOOB.nDamage) or 0;
	local nPending = DB.getValue(nodeTarget, "pendingdamage", 0) + nDamage;
	DB.setValue(nodeTarget, "pendingdamage", "number", nPending);
	DB.setValue(nodeTarget, "pendingattacker", "string", msgOOB.sAttacker or "");

	local sText = ActorManager.getDisplayName(nodeTarget) .. " is hit for " .. nDamage .. " damage";
	if (msgOOB.sAttacker or "") ~= "" then
		sText = sText .. " by " .. msgOOB.sAttacker;
	end
	sText = sText .. ". Roll an armor, or double-click the pending damage on the sheet to take it.";
	Comm.deliverChatMessage({ font = "msgfont", icon = "chat_damage", text = sText });
end

function handleApplyDamage(nodeTarget, msgOOB)
	local nDamage = tonumber(msgOOB.nDamage) or 0;
	local nArmorBreak = tonumber(msgOOB.nArmorBreak) or 0;
	local bCritical = false;

	local sText = ActorManager.getDisplayName(nodeTarget) .. " takes " .. nDamage .. " damage";
	if (msgOOB.sAttacker or "") ~= "" then
		sText = sText .. " from " .. msgOOB.sAttacker;
	end

	if nArmorBreak &gt; 0 and (msgOOB.sArmorNode or "") ~= "" then
		sText = sText .. degradeArmor(msgOOB.sArmorNode, nArmorBreak);
	end

	if nDamage &gt; 0 then
		local nStrength = DB.getValue(nodeTarget, "strength", 0);
		local nLoss = DB.getValue(nodeTarget, "strength_loss", 0);
		local nNewLoss = math.min(nStrength, nLoss + nDamage);
		DB.setValue(nodeTarget, "strength_loss", "number", nNewLoss);
		sText = sText .. " [Strength " .. (nStrength - nNewLoss) .. "/" .. nStrength .. "]";
		if nNewLoss &gt;= nStrength and nLoss &lt; nStrength then
			bCritical = true;
			sText = sText .. " BROKEN! Roll on the " .. CRITICAL_INJURIES_TABLE .. " table.";
		end
	end

	Comm.deliverChatMessage({ font = "msgfont", icon = "chat_damage", text = sText });

	if bCritical then
		rollCriticalInjury(nodeTarget);
	end
end

-- Heals the attribute that has broken the target (Strength if none has)
function handleHeal(nodeTarget, msgOOB)
	local nPoints = tonumber(msgOOB.nDamage) or 0;
	local aAttributes = managerGame.getAttributes(nodeTarget);
	local rAttribute = aAttributes[1];
	for _,v in ipairs(aAttributes) do
		local nValue = DB.getValue(nodeTarget, v.field, 0);
		if nValue &gt; 0 and DB.getValue(nodeTarget, v.field .. "_loss", 0) &gt;= nValue then
			rAttribute = v;
			break;
		end
	end

	local nValue = DB.getValue(nodeTarget, rAttribute.field, 0);
	local nLoss = DB.getValue(nodeTarget, rAttribute.field .. "_loss", 0);
	local nNewLoss = math.max(0, nLoss - nPoints);
	DB.setValue(nodeTarget, rAttribute.field .. "_loss", "number", nNewLoss);

	local sText = ActorManager.getDisplayName(nodeTarget) .. " recovers " .. (nLoss - nNewLoss) .. " " .. rAttribute.label;
	if (msgOOB.sAttacker or "") ~= "" then
		sText = sText .. " thanks to " .. msgOOB.sAttacker;
	end
	sText = sText .. " [" .. rAttribute.label .. " " .. (nValue - nNewLoss) .. "/" .. nValue .. "]";
	Comm.deliverChatMessage({ font = "msgfont", icon = "chat_success", text = sText });
end

-- Rolls on the Critical Injuries table, if the campaign or a module has it
function rollCriticalInjury(nodeActor)
	local nodeTable = TableManager.findTable(CRITICAL_INJURIES_TABLE);
	if not nodeTable then
		return;
	end
	TableManager.performRoll(nil, ActorManager.resolveActor(nodeActor), { nodeTable = nodeTable }, false);
end

-- Creates an empty d66 Critical Injuries table (rows 11 to 66) for the GM to fill, if the campaign has none
function createCriticalInjuriesTable()
	local sRoot = RecordDataManager.getDataPathRoot("table");
	for _,nodeTable in ipairs(DB.getChildList(sRoot)) do
		if DB.getValue(nodeTable, "name", "") == CRITICAL_INJURIES_TABLE then
			return;
		end
	end

	local nodeTable = DB.createChild(sRoot);
	DB.setValue(nodeTable, "name", "string", CRITICAL_INJURIES_TABLE);
	DB.setValue(nodeTable, "dice", "dice", { "d60", "d6" });
	DB.setValue(nodeTable, "mod", "number", 0);
	DB.setValue(nodeTable, "labelcol1", "string", "Injury");
	local nodeRows = DB.createChild(nodeTable, "tablerows");
	for nTens = 1, 6 do
		for nUnits = 1, 6 do
			local nodeRow = DB.createChild(nodeRows);
			local nValue = nTens * 10 + nUnits;
			DB.setValue(nodeRow, "fromrange", "number", nValue);
			DB.setValue(nodeRow, "torange", "number", nValue);
			local nodeResult = DB.createChild(DB.createChild(nodeRow, "results"));
			DB.setValue(nodeResult, "result", "string", "");
		end
	end
end

function onAttributeChanged(nodeField)
	updateBroken(DB.getParent(nodeField));
end

-- An actor is broken while any attribute it has is down to 0
function isBroken(nodeActor)
	for _,sField in ipairs(aAttributeFields) do
		local nValue = DB.getValue(nodeActor, sField, 0);
		if nValue &gt; 0 and DB.getValue(nodeActor, sField .. "_loss", 0) &gt;= nValue then
			return true;
		end
	end
	return false;
end

-- Keeps the Broken effect in the combat tracker in step with the attributes
function updateBroken(nodeActor)
	local nodeCT = ActorManager.getCTNode(nodeActor);
	if not nodeCT then
		return;
	end
	local bBroken = isBroken(nodeActor);
	local bHasEffect = EffectManager.hasEffect(ActorManager.resolveActor(nodeCT), "Broken");
	if bBroken and not bHasEffect then
		EffectManager.addEffect("", "", nodeCT, { sName = "Broken", nDuration = 0, nGMOnly = 0 }, false);
	elseif not bBroken and bHasEffect then
		EffectManager.removeEffect(nodeCT, "^Broken$");
	end
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>managerGame</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- The game of the campaign (option Game: Mutant: Year Zero, Genlab Alpha or Elysium) and the type of each
-- character (mutant, animal or human): the labels and rules that change between them. The database fields do
-- not change: Instinct is kept in "empathy", Wild Points in "mutationpoints"

OPTION_GAME = "MYZGAME";

local tGames = {
	myz = { chartype = "mutant", recoverPerPoint = false },
	-- Genlab Alpha: a ration of grub or water recovers one point of Strength or Agility
	genlab = { chartype = "animal", recoverPerPoint = true },
	elysium = { chartype = "human", recoverPerPoint = false },
};

-- Powers: the list that takes the place of the mutations, and the points gained when pushing (none for humans)
local tCharTypes = {
	mutant = { label = "Mutant", empathy = "Empathy", empathyCode = "EMP",
			powers = "Mutations", points = "Mutation Points", pointsShort = "MP", pushText = "Trauma and Mutation",
			empathyRecovery = "Share a moment of intimacy" },
	-- Animals recover Instinct with the behavior of their animal type (grooming, hiding in a hole...)
	animal = { label = "Animal", empathy = "Instinct", empathyCode = "INS",
			powers = "Animal Powers", points = "Wild Points", pointsShort = "WP", pushText = "Trauma and Wild Points",
			empathyRecovery = "Animal behavior" },
	human = { label = "Human", empathy = "Empathy", empathyCode = "EMP",
			powers = "Implants", points = nil, pointsShort = nil, pushText = "Trauma",
			empathyRecovery = "Share a moment of intimacy" },
};

local tAttributes = {
	STR = { field = "strength", label = "Strength", loss = "Damage" },
	AGI = { field = "agility", label = "Agility", loss = "Fatigue" },
	WIT = { field = "wits", label = "Wits", loss = "Confusion" },
	EMP = { field = "empathy", label = "Empathy", loss = "Doubt" },
};
local aAttributeOrder = { "STR", "AGI", "WIT", "EMP" };

-- Instinct (Genlab Alpha) is the fourth attribute, kept as Empathy
local tCodeAliases = { INS = "EMP" };

function onInit()
	OptionsManager.registerOptionData({
		sKey = OPTION_GAME, bLocal = false, sGroupRes = "option_header_mutant",
		tCustom = {
			labelsres = "option_val_game_genlab|option_val_game_elysium",
			values = "genlab|elysium",
			baselabelres = "option_val_game_myz",
			baseval = "myz",
			default = "myz",
		},
	});
end

-- A field of a character given as a database node or as a path
function getField(vChar, sField, vDefault)
	if type(vChar) == "string" then
		return DB.getValue(vChar .. "." .. sField, vDefault);
	end
	return DB.getValue(vChar, sField, vDefault);
end

function getGame()
	local sGame = OptionsManager.getOption(OPTION_GAME);
	if tGames[sGame] then
		return sGame;
	end
	return "myz";
end

function isRecoveryPerPoint()
	return tGames[getGame()].recoverPerPoint;
end

function getDefaultCharType()
	return tGames[getGame()].chartype;
end

-- The type chosen in the character sheet, or the one of the game
function getCharType(vChar)
	local sType = "";
	if vChar then
		sType = getField(vChar, "chartype", "");
	end
	if tCharTypes[sType] then
		return sType;
	end
	return getDefaultCharType();
end

function getCharTypeData(vChar)
	return tCharTypes[getCharType(vChar)];
end

--
-- Attributes
--

function normalizeCode(sCode)
	return tCodeAliases[sCode] or sCode;
end

-- { field, label, loss, code } of an attribute for a character; nil for an unknown code
function getAttribute(vChar, sCode)
	local sCanonical = normalizeCode(sCode or "");
	local rAttribute = tAttributes[sCanonical];
	if not rAttribute then
		return nil;
	end
	local rResult = { field = rAttribute.field, label = rAttribute.label, loss = rAttribute.loss, code = sCanonical };
	if sCanonical == "EMP" then
		local rType = getCharTypeData(vChar);
		rResult.label = rType.empathy;
		rResult.code = rType.empathyCode;
	end
	return rResult;
end

function getAttributeByField(vChar, sField)
	for sCode, rAttribute in pairs(tAttributes) do
		if rAttribute.field == sField then
			return getAttribute(vChar, sCode);
		end
	end
	return nil;
end

-- The four attributes of a character, in the order of the sheet
function getAttributes(vChar)
	local aResult = {};
	for _,sCode in ipairs(aAttributeOrder) do
		table.insert(aResult, getAttribute(vChar, sCode));
	end
	return aResult;
end

-- Current value of an attribute (less its trauma, at least 0); nil for an unknown code
function getCurrentAttribute(vChar, sCode)
	local rAttribute = getAttribute(vChar, sCode);
	if not rAttribute then
		return nil;
	end
	return math.max(0, getField(vChar, rAttribute.field, 0) - getField(vChar, rAttribute.field .. "_loss", 0));
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>managerInventory</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Resources are CoreRPG currencies of the character (Inventory tab); the load counts items and resources
-- in normal items, and a character can carry Strength x 2 of them

RESOURCE_GRUB = "Grub";
RESOURCE_WATER = "Water";
RESOURCE_BULLETS = "Bullets";
RESOURCE_BOOZE = "Booze";

function onInit()
	GameSystem.currencies = {
		{ name = RESOURCE_GRUB, weight = 0.25 },
		{ name = RESOURCE_WATER, weight = 0.25 },
		{ name = RESOURCE_BULLETS, weight = 0 },
		{ name = RESOURCE_BOOZE, weight = 0.1 },
	};
	GameSystem.currencyDefault = RESOURCE_BULLETS;

	GameManager.setOption("encloadnoround", true);
	CharEncumbranceManager.addCustomCalc(calcEncumbrance);

	if Session.IsHost then
		DB.addHandler("charsheet.*.strength", "onUpdate", onStrengthChanged);
	end
end

function onStrengthChanged(nodeStrength)
	CharEncumbranceManager.updateEncumbrance(DB.getParent(nodeStrength));
end

function getResource(nodeChar, sResource)
	for _,nodeCurrency in ipairs(DB.getChildList(nodeChar, "coins")) do
		if DB.getValue(nodeCurrency, "name", ""):lower() == sResource:lower() then
			return DB.getValue(nodeCurrency, "amount", 0);
		end
	end
	return 0;
end

-- Up to 10 bullets are tiny; more than 10 are a light item, more than 20 a normal one, more than 40 a heavy one
function getBulletsLoad(nBullets)
	if nBullets &gt; 40 then
		return 2;
	elseif nBullets &gt; 20 then
		return 1;
	elseif nBullets &gt; 10 then
		return 0.5;
	end
	return 0;
end

-- Items not left aside count with their weight (normal item 1, light 0.5, heavy 2, tiny 0; 1 if not set);
-- four rations of grub or water are a normal item, and so is each bottle of 10 doses of booze
function calcEncumbrance(nodeChar)
	local nLoad = 0;
	for _,nodeItem in ipairs(DB.getChildList(nodeChar, "inventorylist")) do
		if DB.getValue(nodeItem, "carried", 1) ~= 0 then
			nLoad = nLoad + DB.getValue(nodeItem, "count", 1) * DB.getValue(nodeItem, "weight", 1);
		end
	end
	nLoad = nLoad + (getResource(nodeChar, RESOURCE_GRUB) + getResource(nodeChar, RESOURCE_WATER)) / 4;
	nLoad = nLoad + getBulletsLoad(getResource(nodeChar, RESOURCE_BULLETS));
	nLoad = nLoad + math.ceil(getResource(nodeChar, RESOURCE_BOOZE) / 10);

	DB.setValue(nodeChar, "encumbrance.max", "number", DB.getValue(nodeChar, "strength", 0) * 2);
	CharEncumbranceManager.setDefaultEncumbranceValue(nodeChar, nLoad);
end

-- Starting resources of a role ("1D6", "2D6"...): the player rolls them and writes them in the Inventory tab
function announceStartingResources(nodeChar, nodeRole)
	local aResources = {};
	for _,sResource in ipairs({ RESOURCE_BULLETS, RESOURCE_GRUB, RESOURCE_WATER }) do
		local sDice = StringManager.trim(DB.getValue(nodeRole, "start" .. sResource:lower(), ""));
		if sDice ~= "" then
			table.insert(aResources, sResource .. " " .. sDice);
		end
	end
	if #aResources == 0 then
		return;
	end
	Comm.deliverChatMessage({ font = "msgfont", text = DB.getValue(nodeChar, "name", "") .. " starts with " ..
			table.concat(aResources, ", ") .. ". Roll them and add them to the resources in the Inventory tab." });
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>managerRecovery</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Natural recovery: after at least four hours of rest, each kind of trauma is recovered with its resource
-- (Strength with grub, Agility with water, Wits with sleep, Empathy with intimacy; Instinct of animals with the
-- behavior of their animal type). The first ration of grub or water, or the first sleep, only ends the hungry,
-- dehydrated or sleepless condition. In Genlab Alpha each ration of grub or water recovers a single point.

-- Condition checkboxes of the character sheet and how the book calls them
local tConditionNames = { starving = "hungry", dehydrated = "dehydrated", sleepless = "sleepless", hypothermic = "hypothermic" };

function isCondition(nodeChar, sCondition)
	return DB.getValue(nodeChar, sCondition, 0) ~= 0;
end

-- Spends one unit of a resource; false when there is none
function spendResource(nodeChar, sResource)
	if managerInventory.getResource(nodeChar, sResource) &lt;= 0 then
		return false;
	end
	CurrencyManager.addRecordCurrency(nodeChar, sResource, -1);
	return true;
end

-- Recovers the trauma of an attribute, unless a condition prevents it; spends the resource only then (a unit
-- for all the trauma, or one per point in Genlab Alpha)
function recoverAttribute(nodeChar, sField, sLoss, sResource, aBlockers)
	for _,sCondition in ipairs(aBlockers) do
		if isCondition(nodeChar, sCondition) then
			return "cannot recover " .. sLoss .. " while " .. tConditionNames[sCondition];
		end
	end
	local nLoss = DB.getValue(nodeChar, sField .. "_loss", 0);
	if nLoss &lt;= 0 then
		return "has no " .. sLoss .. " to recover";
	end
	if sResource and managerGame.isRecoveryPerPoint() then
		local nRecovered = math.min(nLoss, managerInventory.getResource(nodeChar, sResource));
		if nRecovered &lt;= 0 then
			return "has no " .. sResource:lower() .. " left";
		end
		CurrencyManager.addRecordCurrency(nodeChar, sResource, -nRecovered);
		DB.setValue(nodeChar, sField .. "_loss", "number", nLoss - nRecovered);
		return "recovers " .. nRecovered .. " " .. sLoss .. " (" .. nRecovered .. " " .. sResource:lower() .. ")";
	end
	if sResource and not spendResource(nodeChar, sResource) then
		return "has no " .. sResource:lower() .. " left";
	end
	DB.setValue(nodeChar, sField .. "_loss", "number", 0);
	return "recovers " .. nLoss .. " " .. sLoss;
end

function endCondition(nodeChar, sCondition, sResource, sText)
	if sResource and not spendResource(nodeChar, sResource) then
		return "has no " .. sResource:lower() .. " left";
	end
	DB.setValue(nodeChar, sCondition, "number", 0);
	return sText;
end

function eat(nodeChar)
	if isCondition(nodeChar, "starving") then
		return endCondition(nodeChar, "starving", managerInventory.RESOURCE_GRUB, "eats and is no longer hungry");
	end
	return recoverAttribute(nodeChar, "strength", "damage", managerInventory.RESOURCE_GRUB, { "dehydrated", "hypothermic" });
end

function drink(nodeChar)
	if isCondition(nodeChar, "dehydrated") then
		return endCondition(nodeChar, "dehydrated", managerInventory.RESOURCE_WATER, "drinks and is no longer dehydrated");
	end
	return recoverAttribute(nodeChar, "agility", "fatigue", managerInventory.RESOURCE_WATER, {});
end

function sleep(nodeChar)
	if isCondition(nodeChar, "sleepless") then
		return endCondition(nodeChar, "sleepless", nil, "sleeps and is no longer sleepless");
	end
	return recoverAttribute(nodeChar, "wits", "confusion", nil, { "dehydrated", "hypothermic" });
end

function share(nodeChar)
	return recoverAttribute(nodeChar, "empathy", "doubt", nil, { "dehydrated" });
end

-- A dose of booze heals 1 damage and 1 doubt at once (they come back after 1D6 hours) and causes 1 confusion
function booze(nodeChar)
	if not spendResource(nodeChar, managerInventory.RESOURCE_BOOZE) then
		return "has no booze left";
	end
	local aResults = {};
	for _,t in ipairs({ { "strength", "damage" }, { "empathy", "doubt" } }) do
		local nLoss = DB.getValue(nodeChar, t[1] .. "_loss", 0);
		if nLoss &gt; 0 then
			DB.setValue(nodeChar, t[1] .. "_loss", "number", nLoss - 1);
			table.insert(aResults, "1 " .. t[2]);
		end
	end
	local sText = "drinks booze";
	if #aResults &gt; 0 then
		sText = sText .. ", heals " .. table.concat(aResults, " and ") .. " for 1D6 hours";
	end
	local sConfusion = managerRolls.applyAttributeLoss(DB.getPath(nodeChar), managerGame.getAttribute(nodeChar, "WIT"), 1);
	if sConfusion then
		sText = sText .. " [" .. sConfusion .. "]";
	end
	return sText;
end

-- The options must fit the width of the selection dialog
function rest(nodeChar)
	local aOptions = {};
	local tActions = {};
	local function addOption(sText, sAction)
		table.insert(aOptions, sText);
		tActions[sText] = sAction;
	end

	local bPerPoint = managerGame.isRecoveryPerPoint();
	if isCondition(nodeChar, "starving") then
		addOption("Eat a ration of grub (no longer hungry)", "eat");
	elseif bPerPoint then
		addOption("Eat grub (1 ration per point of Strength)", "eat");
	else
		addOption("Eat a ration of grub (recover Strength)", "eat");
	end
	if isCondition(nodeChar, "dehydrated") then
		addOption("Drink a ration of water (no longer dehydrated)", "drink");
	elseif bPerPoint then
		addOption("Drink water (1 ration per point of Agility)", "drink");
	else
		addOption("Drink a ration of water (recover Agility)", "drink");
	end
	if isCondition(nodeChar, "sleepless") then
		addOption("Sleep four hours (no longer sleepless)", "sleep");
	else
		addOption("Sleep four hours (recover Wits)", "sleep");
	end
	local rType = managerGame.getCharTypeData(nodeChar);
	addOption(rType.empathyRecovery .. " (recover " .. rType.empathy .. ")", "share");
	addOption("Drink a dose of booze (1 damage, 1 doubt)", "booze");

	DialogManager.requestSelectionDialog({ title = "Rest",
			msg = DB.getValue(nodeChar, "name", "") .. " rests at least four hours. Choose what to do:",
			options = aOptions, min = 1, max = #aOptions,
			callback = onRestSelection, custom = { sChar = DB.getPath(nodeChar), tActions = tActions } });
end

function onRestSelection(aSelections, tCustom)
	local nodeChar = DB.findNode(tCustom.sChar);
	if not nodeChar then
		return;
	end
	local aResults = {};
	for _,sSelection in ipairs(aSelections) do
		local sAction = tCustom.tActions[sSelection];
		if sAction then
			table.insert(aResults, managerRecovery[sAction](nodeChar));
		end
	end
	Comm.deliverChatMessage({ font = "msgfont", text = DB.getValue(nodeChar, "name", "") .. " rests: " .. table.concat(aResults, "; ") .. ".", });
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>managerRolls</ScriptName>
    <FolderID>9</FolderID>
    <Script>function onInit()
	CombatManager.setCustomSort(sortCombatants);
end

-- Attribute code of a field for the roll description (Instinct is INS for animals)
function getAttributeCode(sField, vChar)
	local rAttribute = managerGame.getAttributeByField(vChar, sField);
	if not rAttribute then
		return "";
	end
	return rAttribute.code;
end

--
-- Initiative (updated rules of Genlab Alpha, for all the games): 1D6 without attributes; ties go to the
-- highest current Agility
--

function getCurrentAgility(nodeCT)
	local rActor = ActorManager.resolveActor(nodeCT);
	local sCreature = rActor and rActor.sCreatureNode or DB.getPath(nodeCT);
	return DB.getValue(sCreature .. ".agility", 0) - DB.getValue(sCreature .. ".agility_loss", 0);
end

function sortCombatants(node1, node2)
	if DB.getValue(node1, "initresult", 0) == DB.getValue(node2, "initresult", 0) then
		-- Only when both initiatives are shown, as the standard order does
		local sOptCTSI = OptionsManager.getOption("CTSI");
		local function isShown(node)
			return Session.IsHost or (sOptCTSI == "on") or ((sOptCTSI == "friend") and (DB.getValue(node, "friendfoe", "") == "friend"));
		end
		if isShown(node1) and isShown(node2) then
			local nAgility1 = getCurrentAgility(node1);
			local nAgility2 = getCurrentAgility(node2);
			if nAgility1 ~= nAgility2 then
				return nAgility1 &gt; nAgility2;
			end
		end
	end
	return CombatManager.sortfuncStandard(node1, node2);
end

-- Remembers the item whose bonus goes into the gear dice ("*" when several items are used),
-- and the weapon, whose damage is used when the roll succeeds
function addGearSource(nodeChar, nodeItem)
	local sList = DB.getName(DB.getParent(nodeItem));
	if sList ~= "inventorylist" and sList ~= "gearlist" then
		return;
	end
	local sPath = DB.getPath(nodeItem);
	local sCurrent = DB.getValue(nodeChar, "diceInfoGearPath", "");
	if sCurrent == "" then
		DB.setValue(nodeChar, "diceInfoGearPath", "string", sPath);
	elseif sCurrent ~= sPath then
		DB.setValue(nodeChar, "diceInfoGearPath", "string", "*");
	end
	if DB.getValue(nodeItem, "damage", 0) &gt; 0 then
		DB.setValue(nodeChar, "diceInfoWeaponPath", "string", sPath);
	end
end

-- Keeps the attribute, skill, gear item, weapon and Ark project of the roll, for the result and for pushing it
function storeRollSources(nodeChar)
	DB.setValue(nodeChar, "diceAttrf", "string", DB.getValue(nodeChar, "diceInfoAttribute", ""));
	DB.setValue(nodeChar, "diceSkillf", "string", DB.getValue(nodeChar, "diceInfoSkill", ""));
	DB.setValue(nodeChar, "diceGearf", "string", DB.getValue(nodeChar, "diceInfoGearPath", ""));
	DB.setValue(nodeChar, "diceWeaponf", "string", DB.getValue(nodeChar, "diceInfoWeaponPath", ""));
	DB.setValue(nodeChar, "diceProjectf", "string", DB.getValue(nodeChar, "diceInfoProject", ""));
	DB.setValue(nodeChar, "diceInfoAttribute", "string", "");
	DB.setValue(nodeChar, "diceInfoGearPath", "string", "");
	DB.setValue(nodeChar, "diceInfoWeaponPath", "string", "");
	DB.setValue(nodeChar, "diceInfoProject", "string", "");
end

-- Skill dice of the pool: below 0 they are negative dice, whose 6s cancel successes
function getSkillDice(nSkill)
	if nSkill &gt; 0 then
		return nSkill .. "dskill+";
	elseif nSkill &lt; 0 then
		return (-nSkill) .. "dneg+";
	end
	return "";
end

function getNegativeText(nCancel)
	if nCancel &lt;= 0 then
		return "";
	end
	return " [NEGATIVE (" .. nCancel .. ")]";
end

-- A successful roll with a weapon deals its damage plus 1 per extra success, ready in the Damage counter
function setWeaponDamage(sCreatureNode, nSuccess)
	local sWeapon = DB.getValue(sCreatureNode .. ".diceWeaponf", "");
	if nSuccess &lt;= 0 or sWeapon == "" or not DB.findNode(sWeapon) then
		return "";
	end
	local nDamage = DB.getValue(sWeapon .. ".damage", 0) + nSuccess - 1;
	DB.setValue(sCreatureNode .. ".ddamage", "number", nDamage);
	return " [Damage " .. nDamage .. "]";
end

function isHealRoll(sCreatureNode)
	return DB.getValue(sCreatureNode .. ".diceSkillf", ""):lower() == "heal";
end

-- Text for a Heal roll without targets to heal
function getHealText(rSource, sCreatureNode, nPoints)
	if nPoints &lt;= 0 or not isHealRoll(sCreatureNode) then
		return "";
	end
	if #TargetingManager.getFullTargets(rSource) == 0 then
		return " [Heal: target the patient to heal them]";
	end
	return "";
end

-- Each success of a Heal roll gives back 1 point to each target of the healer
function healTargets(rSource, sCreatureNode, nPoints)
	if nPoints &lt;= 0 or not isHealRoll(sCreatureNode) then
		return;
	end
	local sHealer = ActorManager.getDisplayName(rSource);
	for _,rTarget in ipairs(TargetingManager.getFullTargets(rSource)) do
		managerDamage.notifyHeal(rTarget, nPoints, sHealer);
	end
end

-- Takes points of an attribute (up to its value) and describes it; the host keeps the Broken effect in step
function applyAttributeLoss(sCreatureNode, rAttribute, nPoints)
	local nAttribute = DB.getValue(sCreatureNode .. "." .. rAttribute.field, 0);
	local sLoss = sCreatureNode .. "." .. rAttribute.field .. "_loss";
	local nLoss = DB.getValue(sLoss, 0);
	local nNewLoss = math.min(nAttribute, nLoss + nPoints);
	if nNewLoss &lt;= nLoss then
		return nil;
	end
	DB.setValue(sLoss, "number", nNewLoss);
	local sResult = rAttribute.label .. " -" .. (nNewLoss - nLoss) .. " (" .. rAttribute.loss .. ")";
	if nNewLoss &gt;= nAttribute then
		sResult = sResult .. " BROKEN";
	end
	return sResult;
end

-- Text of the 1s on base dice after pushing: trauma, and the points gained by the type of character
function getTraumaText(sCreatureNode, nTrauma)
	return " " .. managerGame.getCharTypeData(sCreatureNode).pushText .. " (" .. nTrauma .. ")";
end

-- Each 1 on a base die after pushing: 1 point of trauma to the rolled attribute, and 1 mutation point
-- (wild point for animals, nothing for humans) for PCs
function applyTrauma(rSource, sCreatureNode, nTrauma)
	local aResults = {};

	local rAttribute = managerGame.getAttribute(sCreatureNode, DB.getValue(sCreatureNode .. ".diceAttrf", ""));
	if rAttribute then
		local sResult = applyAttributeLoss(sCreatureNode, rAttribute, nTrauma);
		if sResult then
			table.insert(aResults, sResult);
		end
	end

	local rType = managerGame.getCharTypeData(sCreatureNode);
	if ActorManager.isPC(rSource) and rType.pointsShort then
		local nMP = DB.getValue(sCreatureNode .. ".mutationpoints", 0);
		local nNewMP = math.min(DB.getValue(sCreatureNode .. ".mutationpoints_max", 10), nMP + nTrauma);
		if nNewMP &gt; nMP then
			DB.setValue(sCreatureNode .. ".mutationpoints", "number", nNewMP);
			table.insert(aResults, rType.pointsShort .. " +" .. (nNewMP - nMP));
		end
	end

	if #aResults == 0 then
		return "";
	end
	return " [" .. table.concat(aResults, ", ") .. "]";
end

-- Each 1 on a gear die after pushing lowers the bonus of the item by 1, when the roll used a single item
function applyGearBreak(sCreatureNode, nBreak)
	local sItem = DB.getValue(sCreatureNode .. ".diceGearf", "");
	if sItem == "" or sItem == "*" or not DB.findNode(sItem) then
		return "";
	end
	local nBonus = DB.getValue(sItem .. ".bonus", 0);
	local nNewBonus = math.max(0, nBonus - nBreak);
	DB.setValue(sItem .. ".bonus", "number", nNewBonus);
	return " [" .. DB.getValue(sItem .. ".name", "") .. " bonus " .. nBonus .. " -&gt; " .. nNewBonus .. "]";
end

-- Each 1 when using a mutation: 1 point of damage (physical mutation) or confusion (mental mutation)
function applyMisfire(sCreatureNode, nMisfire)
	local sMutation = DB.getValue(sCreatureNode .. ".diceMutationf", "");
	local sCode = "STR";
	if sMutation ~= "" and DB.getValue(sMutation .. ".mutationtype", "") == "mental" then
		sCode = "WIT";
	end
	local sResult = applyAttributeLoss(sCreatureNode, managerGame.getAttribute(sCreatureNode, sCode), nMisfire);
	if not sResult then
		return "";
	end
	return " [" .. sResult .. "]";
end

function challenge(rSource, rTarget, rRoll)

--  Name the function and accept 3 parameters

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	--  Create a message from the rSource and rRoll parameters using CoreRPGs createActionMessage function
	local nSuccess = 0;
	local nCancel = 0;
	
	local nodeChar = rSource.sCreatureNode;
	--  Capture the Character Node
--	local sIcon;
--	if rSource.sType == "npc" then
--		sIcon = "portrait_gm_token";
--	else
--		sIcon = DB.getValue(nodeChar .. ".token");
--		if sIcon then
--			sIcon = string.gsub(sIcon, "token", "chat");
--		end;
--	end
--	 
	 
	local msg = {font = "msgfont"};
	local aAddIcons = {};
--	rMessage.icon = sIcon;

	for k, v in ipairs(rRoll.aDice) do
--		Debug.chat(k, v, rRoll.aDice[k]);
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 6 then
				DB.setValue(nodeChar .. ".dbases", "number", DB.getValue(nodeChar .. ".dbases")+1);
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				DB.setValue(nodeChar .. ".dbasef", "number", DB.getValue(nodeChar .. ".dbasef")+1);
			else
				local dbaser = DB.getValue(nodeChar .. ".dbaser")+1;
				DB.setValue(nodeChar .. ".dbaser", "number", DB.getValue(nodeChar .. ".dbaser")+1);
			end
		elseif rRoll.aDice[k].type == "dskill" then
			if rRoll.aDice[k].value == 6 then
				DB.setValue(nodeChar .. ".dskills", "number", DB.getValue(nodeChar .. ".dskills")+1);
				nSuccess = nSuccess+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dskillr")+1;
				DB.setValue(nodeChar .. ".dskillr", "number", DB.getValue(nodeChar .. ".dskillr")+1);
			end
		elseif rRoll.aDice[k].type == "dneg" then
			if rRoll.aDice[k].value == 6 then
				DB.setValue(nodeChar .. ".dnegs", "number", DB.getValue(nodeChar .. ".dnegs", 0)+1);
				nCancel = nCancel+1;
			else
				DB.setValue(nodeChar .. ".dnegr", "number", DB.getValue(nodeChar .. ".dnegr", 0)+1);
			end
		elseif rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 6 then
				DB.setValue(nodeChar .. ".dgears", "number", DB.getValue(nodeChar .. ".dgears")+1);
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				DB.setValue(nodeChar .. ".dgearf", "number", DB.getValue(nodeChar .. ".dgearf")+1);
			else
				local dbaser = DB.getValue(nodeChar .. ".dgearr")+1;
				DB.setValue(nodeChar .. ".dgearr", "number", DB.getValue(nodeChar .. ".dgearr")+1);
			end
		end
	end

	nSuccess = math.max(0, nSuccess - nCancel);
	for i = 1, nSuccess do
		table.insert(aAddIcons, "chat_success");
	end
	
	if #aAddIcons &gt; 0 then
		rMessage.icon = { rMessage.icon };
		for _,v in ipairs(aAddIcons) do
			table.insert (rMessage.icon, tostring(v));
		end
	end
	      	      
	rMessage.text = rMessage.text .. getNegativeText(nCancel);
	if nSuccess &gt; 0 then
		rMessage.text = rMessage.text .. " [SUCCESS (" .. nSuccess .. ")]";
		rMessage.text = rMessage.text .. setWeaponDamage(nodeChar, nSuccess);
		rMessage.text = rMessage.text .. getHealText(rSource, nodeChar, nSuccess);
	else
		rMessage.text = rMessage.text .. " [FAIL]";
	end
	local sWork, nodeCompleted = managerArk.applyWork(nodeChar, nSuccess);
	rMessage.text = rMessage.text .. sWork;

    rMessage.dicedisplay = 0;
    rMessage.diceskipexpr = true;
    	 	 
	Comm.deliverChatMessage(rMessage); 

	healTargets(rSource, nodeChar, nSuccess);
	if nodeCompleted then
		managerArk.completeProject(nodeCompleted);
	end
	 return true
end

function push(rSource, rTarget, rRoll)

--  Name the function and accept 3 parameters

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	--  Create a message from the rSource and rRoll parameters using CoreRPGs createActionMessage function
	
	local nodeChar = rSource.sCreatureNode;
	--  Capture the Character Node
--	local sIcon;
--	if rSource.sType == "npc" then
--		sIcon = "portrait_gm_token";
--	else
--		sIcon = DB.getValue(nodeChar .. ".token");
--		sIcon = string.gsub(sIcon, "token", "chat");
--	end
	 
	local nSuccess = DB.getValue(nodeChar .. ".dbases")+DB.getValue(nodeChar .. ".dskills")+DB.getValue(nodeChar .. ".dgears");
	-- The 6s of the negative dice in the first roll keep cancelling successes
	local nCancel = DB.getValue(nodeChar .. ".dnegs", 0);
	local nPreviousSuccess = math.max(0, nSuccess - nCancel);
	local nMutant = DB.getValue(nodeChar .. ".dbasef");
	local nBreak = DB.getValue(nodeChar .. ".dgearf");
		
 	DB.setValue(nodeChar .. ".dbases", "number", 0);	
	DB.setValue(nodeChar .. ".dskills", "number", 0);	
	DB.setValue(nodeChar .. ".dgears", "number", 0);	
	DB.setValue(nodeChar .. ".dnegs", "number", 0);	
	
	local msg = {font = "msgfont"};
	local aAddIcons = {};
--	rMessage.icon = sIcon;

	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 6 then
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				nMutant = nMutant+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dbaser")+1;
			end
		elseif rRoll.aDice[k].type == "dskill" then
			if rRoll.aDice[k].value == 6 then
				nSuccess = nSuccess+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dskillr")+1;
			end
		elseif rRoll.aDice[k].type == "dneg" then
			if rRoll.aDice[k].value == 6 then
				nCancel = nCancel+1;
			end
		elseif rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 6 then
				nSuccess = nSuccess+1;
			elseif rRoll.aDice[k].value == 1 then
				nBreak = nBreak+1;
			else
				local dbaser = DB.getValue(nodeChar .. ".dgearr")+1;
			end
		end
	end

	nSuccess = math.max(0, nSuccess - nCancel);
	local nKept = math.min(nPreviousSuccess, nSuccess);
	for i = 1, nKept do
		table.insert(aAddIcons, "chat_success");
	end
	for i = nKept + 1, nSuccess do
		table.insert(aAddIcons, "chat_pushsuccess");
	end

	-- Healing and project work from the first roll are already applied; only the new successes count now
	local nNewSuccess = nSuccess - nPreviousSuccess;
 
	rMessage.text = rMessage.text .. " [PUSH]" .. getNegativeText(nCancel);
	if nSuccess &gt; 0 then
		rMessage.text = rMessage.text .. " [SUCCESS (" .. nSuccess .. ")]";
		rMessage.text = rMessage.text .. setWeaponDamage(nodeChar, nSuccess);
		rMessage.text = rMessage.text .. getHealText(rSource, nodeChar, nNewSuccess);
	else
		rMessage.text = rMessage.text .. " [FAIL]";
	end
	local sWork, nodeCompleted = managerArk.applyWork(nodeChar, math.max(0, nNewSuccess));
	rMessage.text = rMessage.text .. sWork;

	if nMutant &gt; 0 then 
		rMessage.text = rMessage.text .. getTraumaText(nodeChar, nMutant);
		rMessage.text = rMessage.text .. applyTrauma(rSource, nodeChar, nMutant);
	end
	
	if nBreak &gt; 0 then 
		rMessage.text = rMessage.text .. " Gear Break (" .. nBreak .. ")";
		rMessage.text = rMessage.text .. applyGearBreak(nodeChar, nBreak);
	end

	DB.setValue(nodeChar .. ".diceAttrf", "string", "");
	DB.setValue(nodeChar .. ".diceGearf", "string", "");
	DB.setValue(nodeChar .. ".diceProjectf", "string", "");

  	while nMutant &gt; 0 do
		table.insert(aAddIcons, "chat_mutant");
		nMutant = nMutant-1;
	end
	
	while nBreak &gt; 0 do
		table.insert(aAddIcons, "chat_break");
		nBreak = nBreak-1;
	end

    rMessage.dicedisplay = 0;
    rMessage.diceskipexpr = true;

  	DB.setValue(nodeChar .. ".dbasef", "number", 0);	
	DB.setValue(nodeChar .. ".dgearf", "number", 0);	
	
	if #aAddIcons &gt; 0 then
		rMessage.icon = { rMessage.icon };
		for _,v in ipairs(aAddIcons) do
			table.insert (rMessage.icon, tostring(v));
		end
	end
 
  	DB.setValue(nodeChar, "dbasef", "number", 0);	
	DB.setValue(nodeChar, "dgearf", "number", 0);	
    
	Comm.deliverChatMessage(rMessage); 

	healTargets(rSource, nodeChar, nNewSuccess);
	if nodeCompleted then
		managerArk.completeProject(nodeCompleted);
	end
	return true
end


function initiative(rSource, rTarget, rRoll)

	local nodeChar = rSource.sCreatureNode;
	local nInit = ActionsManager.total(rRoll);
	DB.setValue(nodeChar .. '.initresult', "number", nInit);

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = "Initiative";
    Comm.deliverChatMessage(rMessage);
	
end

-- Using a mutation: the mutation points were spent before rolling; each 1 is a misfire
function backfire(rSource, rTarget, rRoll)

	local nMisfire = 0;
	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dbase" then
			if rRoll.aDice[k].value == 1 then
				nMisfire = nMisfire + 1;
			end;
		end;
	end;

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nMisfire &gt; 0 then
		rMessage.text = rMessage.text .. " [BACKFIRE (" .. nMisfire .. ")]";
		rMessage.text = rMessage.text .. applyMisfire(rSource.sCreatureNode, nMisfire);
	else
		rMessage.text = rMessage.text .. " [SUCCESS]";
	end;
	DB.setValue(rSource.sCreatureNode .. ".diceMutationf", "string", "");
	Comm.deliverChatMessage(rMessage); 
	return true;

end

-- Armor roll of a PC: each 6 stops 1 point of the pending damage, each 1 lowers the armor by 1
function armor(rSource, rTarget, rRoll)

	local nArmor = 0;
	local nDamage = 0;

	for k, v in ipairs(rRoll.aDice) do
		if rRoll.aDice[k].type == "dgear" then
			if rRoll.aDice[k].value == 1 then
				nDamage = nDamage + 1; 
			end;
			if rRoll.aDice[k].value == 6 then
				nArmor = nArmor + 1;
			end;
		end;
	end;

	local nodeChar = DB.findNode(rSource.sCreatureNode);
	local nPending = DB.getValue(nodeChar, "pendingdamage", 0);

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	rMessage.text = rMessage.text .. " [Damage Reduction (" .. nArmor .. ")]";
	if nDamage &gt; 0 then
		rMessage.text = rMessage.text .. " [Armor Break (" .. nDamage .. ")]";
		rMessage.text = rMessage.text .. managerDamage.degradeArmor(DB.getValue(nodeChar, "diceArmorf", ""), nDamage);
	end;
	if nPending &gt; 0 then
		rMessage.text = rMessage.text .. " [Pending damage " .. nPending .. " -&gt; " .. math.max(0, nPending - nArmor) .. "]";
	end
	Comm.deliverChatMessage(rMessage); 

	if nPending &gt; 0 then
		managerDamage.takePendingDamage(nodeChar, nArmor);
	end
	return true;

end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>managerRot</ScriptName>
    <FolderID>9</FolderID>
    <Script>-- Rot: rotpoints counts all the rot points of a character, rotpermanent how many of them are permanent

local rStrength = { field = "strength", label = "Strength", loss = "Damage" };

-- Rot level of a sector of the Zone: how often the characters in it gain a rot point
local aRotLevels = {
	[0] = "Rot oasis: no rot points here",
	[1] = "Weak rot: 1 rot point per day",
	[2] = "Strong rot: 1 rot point per hour",
	[3] = "Rot hotspot: 1 rot point per minute",
};

function onInit()
	GameManager.addAction("myz_rot", { });
	ActionsManager.registerResultHandler("myz_rot", onRotResult);
	GameManager.addAction("myz_decontaminate", { });
	ActionsManager.registerResultHandler("myz_decontaminate", onDecontaminateResult);
end

function getTemporaryRot(nodeChar)
	return math.max(0, DB.getValue(nodeChar, "rotpoints", 0) - DB.getValue(nodeChar, "rotpermanent", 0));
end

-- Gaining rot points: roll one base die per rot point (permanent ones included); each 1 is 1 point of damage
function gainRot(nodeChar, nPoints)
	local nRot = math.min(DB.getValue(nodeChar, "rotpoints_max", 10), DB.getValue(nodeChar, "rotpoints", 0) + nPoints);
	DB.setValue(nodeChar, "rotpoints", "number", nRot);
	RulesetWizardDiceRoller.Roll(nil, nodeChar, "myz_rot", "Rot roll (" .. nRot .. " rot points)", nRot .. "dbase", 0, {});
end

function onRotResult(rSource, rTarget, rRoll)
	local nDamage = 0;
	for _,rDie in ipairs(rRoll.aDice) do
		if rDie.value == 1 then
			nDamage = nDamage + 1;
		end
	end

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nDamage &gt; 0 then
		rMessage.text = rMessage.text .. " [ROT DAMAGE (" .. nDamage .. ")]";
		local sResult = managerRolls.applyAttributeLoss(rSource.sCreatureNode, rStrength, nDamage);
		if sResult then
			rMessage.text = rMessage.text .. " [" .. sResult .. "]";
		end
	else
		rMessage.text = rMessage.text .. " [NO DAMAGE]";
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

-- Decontamination in a rot-free place: roll one base die per temporary rot point; each 1 makes one of them
-- permanent, and the temporary ones are gone
function decontaminate(nodeChar)
	local nTemporary = getTemporaryRot(nodeChar);
	if nTemporary &lt;= 0 then
		ChatManager.SystemMessage(ActorManager.getDisplayName(nodeChar) .. " has no temporary rot points.");
		return;
	end
	RulesetWizardDiceRoller.Roll(nil, nodeChar, "myz_decontaminate", "Decontamination (" .. nTemporary .. " temporary rot points)", nTemporary .. "dbase", 0, {});
end

function onDecontaminateResult(rSource, rTarget, rRoll)
	local nodeChar = DB.findNode(rSource.sCreatureNode);
	local nNewPermanent = 0;
	for _,rDie in ipairs(rRoll.aDice) do
		if rDie.value == 1 then
			nNewPermanent = nNewPermanent + 1;
		end
	end

	local nPermanent = math.min(DB.getValue(nodeChar, "rotpoints", 0), DB.getValue(nodeChar, "rotpermanent", 0) + nNewPermanent);
	DB.setValue(nodeChar, "rotpermanent", "number", nPermanent);
	DB.setValue(nodeChar, "rotpoints", "number", nPermanent);

	local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
	if nNewPermanent &gt; 0 then
		rMessage.text = rMessage.text .. " [PERMANENT ROT +" .. nNewPermanent .. "]";
	end
	if nPermanent &gt; 0 then
		rMessage.text = rMessage.text .. " [Permanent rot points: " .. nPermanent .. "]";
	else
		rMessage.text = rMessage.text .. " [No rot points left]";
	end
	Comm.deliverChatMessage(rMessage);
	return true;
end

--
-- Rot of the sectors of the Zone log: the GM applies the rot point of a sector each time it is due (each day,
-- hour or minute, by its rot level) to the characters in it
--

function getRotLevelText(nLevel)
	return aRotLevels[math.max(0, math.min(3, nLevel))];
end

function applySectorRot(nodeSector)
	local nLevel = DB.getValue(nodeSector, "rotlevel", 0);
	local sSector = "Sector " .. DB.getValue(nodeSector, "name", "");
	if nLevel &lt;= 0 then
		ChatManager.SystemMessage(sSector .. " is a rot oasis: no rot points here.");
		return;
	end

	-- A player applies it to their own character; the GM chooses who is in the sector
	if not Session.IsHost then
		local sIdentity = User.getCurrentIdentity();
		local nodeChar = sIdentity and DB.findNode("charsheet." .. sIdentity);
		if nodeChar then
			applyRotToCharacters(nodeSector, { nodeChar });
		end
		return;
	end

	local aOptions = {};
	for _,nodeChar in ipairs(DB.getChildList("charsheet")) do
		table.insert(aOptions, { text = DB.getValue(nodeChar, "name", ""), linkclass = "charsheet", linkrecord = DB.getPath(nodeChar), selected = true });
	end
	if #aOptions == 0 then
		return;
	end
	DialogManager.requestSelectionDialog({ title = "Rot", msg = "Who is in the " .. sSector:lower() .. " (" .. getRotLevelText(nLevel) .. ")?",
			options = aOptions, min = 1, max = #aOptions, callback = onSectorRotSelection, custom = { sSector = DB.getPath(nodeSector) } });
end

function onSectorRotSelection(_, tCustom, aSelectionLinks)
	local nodeSector = DB.findNode(tCustom.sSector);
	if not nodeSector then
		return;
	end
	local aChars = {};
	for _,tLink in ipairs(aSelectionLinks or {}) do
		local nodeChar = DB.findNode(tLink.linkrecord or "");
		if nodeChar then
			table.insert(aChars, nodeChar);
		end
	end
	applyRotToCharacters(nodeSector, aChars);
end

function applyRotToCharacters(nodeSector, aChars)
	if #aChars == 0 then
		return;
	end
	local aNames = {};
	for _,nodeChar in ipairs(aChars) do
		table.insert(aNames, DB.getValue(nodeChar, "name", ""));
	end
	Comm.deliverChatMessage({ font = "msgfont", text = "Sector " .. DB.getValue(nodeSector, "name", "") .. " (rot level " ..
			DB.getValue(nodeSector, "rotlevel", 0) .. "): 1 rot point for " .. table.concat(aNames, ", ") .. "." });
	for _,nodeChar in ipairs(aChars) do
		gainRot(nodeChar, 1);
	end
end
</Script>
